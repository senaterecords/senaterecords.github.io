 "approvalMessage": {
  "approvalNumber": 19,
  "billId": {
   "basePrintNo": "S5946",
   "basePrintNoStr": "S5946-2015",
   "printNo": "S5946",
   "session": 2015,
   "version": ""
  },
  "chapter": 557,
  "signer": "ANDREW M. CUOMO",
  "text": "\n                APPROVAL MEMORANDUM - No. 19 Chapter 557\n\n        MEMORANDUM filed with Senate Bill Number 5946, entitled:\n\n    \"AN  ACT to amend the general business law, in relation to requiring\n        pet dealers  to  provide  instructions  on  the  care  of  small\n        animals\"\n\n    APPROVED\n\n  This  bill  would  require  those who sell small animals to the public\n(excluding dogs or cats) to provide written instructions for the care of\nsuch animals. As drafted, however, this bill would  create  requirements\nfor  certain  retailers  of small animals that fall outside the scope of\nthe laws regulating \"pet dealers\" as  defined  by  the  Agriculture  and\nMarkets  Law.  The  Department  of Agriculture and Markets does not have\nregulatory jurisdiction or enforcement responsibilities  over  retailers\nof small animals that do not fit the definition of \"pet dealers.\"\n\n  The Legislature has agreed to pass legislation in the upcoming session\nto remedy this concern. On that basis, I am signing this bill.\n\n  This bill is approved.                      (signed) ANDREW M. CUOMO\n\n                                ______\n",
  "year": 2015
 },
