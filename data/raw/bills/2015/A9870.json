 "summary": "Relates to the powers and duties of the president of the state civil service commission.",
 "title": "Relates to the powers and duties of the president of the state civil service commission",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A9870",
     "basePrintNoStr": "A9870-2015",
     "printNo": "A9870",
     "session": 2015,
     "version": ""
