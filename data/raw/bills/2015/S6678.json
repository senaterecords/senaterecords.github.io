   "": {
    "actClause": "AN ACT to amend chapter 378 of the laws of 2014; amending the environmental conservation law, relating to the taking of sharks, in relation to the expiration thereof",
    "basePrintNo": "S6678",
    "basePrintNoStr": "S6678-2015",
    "coSponsors": {
