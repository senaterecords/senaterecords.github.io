 "summary": "Relates to the sharing of revenue from gaming devices located within the county of Madison.",
 "title": "Relates to the sharing of revenue from gaming devices located within the county of Madison",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "S5670",
