   "": {
    "actClause": "AN ACT in relation to granting Luke Parga tier IV status in the New York state and local employees' retirement system with a membership date of 2006",
    "basePrintNo": "S7363",
    "basePrintNoStr": "S7363-2015",
    "coSponsors": {
     "items": [],
     "size": 0
