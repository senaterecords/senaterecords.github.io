    "actClause": "AN ACT to amend the election law, in relation to removal of a voter from voting rolls due to death",
    "basePrintNo": "S3133",
    "basePrintNoStr": "S3133-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
       "memberId": 435,
       "sessionMemberId": 699,
       "sessionYear": 2015,
       "shortName": "MARCHIONE"
      }
     ],
     "size": 1
