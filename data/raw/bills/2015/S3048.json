   "": {
    "actClause": "AN ACT to amend the real property tax law, in relation to application for certain veterans exemptions from real property taxes",
    "basePrintNo": "S3048",
    "basePrintNoStr": "S3048-2015",
    "coSponsors": {
     "items": [],
     "size": 0
