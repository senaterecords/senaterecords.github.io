 "substitutedBy": null,
 "summary": "Relates to allowing two automatic free transfers for riders using pay-per-ride Metrocards.",
 "title": "Creates an extra transfer for pay-per-ride Metrocard users",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "S3228",
