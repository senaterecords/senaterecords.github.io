   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to fees for the registration or reregistration of an agricultural trailer",
    "basePrintNo": "S4241",
    "basePrintNoStr": "S4241-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
