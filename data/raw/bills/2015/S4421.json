   "": {
    "actClause": "AN ACT to amend the social services law, in relation to the creation of the early learning investment commission",
    "basePrintNo": "S4421",
    "basePrintNoStr": "S4421-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 60,
       "fullName": "Marc Panepinto",
       "imgName": "894_marc_panepinto.jpg",
       "incumbent": false,
       "memberId": 894,
