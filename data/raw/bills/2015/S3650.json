   "": {
    "actClause": "AN ACT to amend the mental hygiene law, in relation to involuntary admittance",
    "basePrintNo": "S3650",
    "basePrintNoStr": "S3650-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
       "imgName": "370_david_carlucci.jpg",
       "incumbent": false,
       "memberId": 370,
