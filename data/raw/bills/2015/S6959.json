   "": {
    "actClause": "AN ACT to amend the economic development law, in relation to creating a comprehensive website of small business and minority and women-owned business enterprise assistance",
    "basePrintNo": "S6959",
    "basePrintNoStr": "S6959-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 63,
       "fullName": "Timothy M. Kennedy",
       "imgName": "429_timothy_m._kennedy.jpg",
       "incumbent": false,
       "memberId": 429,
       "sessionMemberId": 712,
       "sessionYear": 2015,
       "shortName": "KENNEDY"
      }
     ],
     "size": 1
