   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to collision or comprehensive coverage on motor vehicles",
    "basePrintNo": "S5639",
    "basePrintNoStr": "S5639-2015",
    "coSponsors": {
     "items": [],
     "size": 0
