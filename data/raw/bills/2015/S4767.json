 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the election law, in relation to removing petitioning for Long Island power authority trustees",
    "basePrintNo": "S4767",
    "basePrintNoStr": "S4767-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §§6-158 & 6-142, El L",
    "lawSection": "Election Law",
    "memo": "BILL NUMBER:S4767\n\nTITLE OF BILL:  An act to amend the election law, in relation to\nremoving petitioning for Long Island power authority trustees\n\nPURPOSE:\n\nTo remove petitioning for Long Island power authority trustees\n\nSUMMARY OF PROVISIONS:\n\nSection 1. Amends subdivision nine of section 6-158 of the election\nlaw, as amended by chapter 517 of the laws of 1986\n\nSection 2. Amends subdivision two of section 6-142 of the election\nlaw, as amended by chapter 79 of the laws of 1992 and paragraph (d-1)\nas amended by chapter 418 of the laws of 1993\n\nSection 3. Sets the effective date\n\nJUSTIFICATION:\n\nThis bill is a technical fix for an oversight of chapter 173 of 2013.\nAs of January 1, 2014, LIPA trustees are now appointed, five members\nby the Governor, two by the Temporary President of the Senate, and two\nby the Speaker of the Assembly. This change did not include language\nto remove the petitioning process for these positions. Since there is\nnow no way to be elected to the board of trustees, it makes sense to\nremove the petitioning process so there is no confusion.\n\nLEGISLATIVE HISTORY:\n\nNew bill.\n\nFISCAL IMPLICATIONS:\n\nNone.\n\nEFFECTIVE DATE:\n\nThis act shall take effect immediately.\n\n",
    "multiSponsors": {
     "items": [],
     "size": 0
    },
    "printNo": "S4767",
    "publishDate": "2015-04-15",
