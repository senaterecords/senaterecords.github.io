    "actClause": "AN ACT to amend the state finance law, in relation to authorizing state agencies to use discretionary purchasing authority for procurements from service-disabled veteran-owned business",
    "basePrintNo": "S4856",
    "basePrintNoStr": "S4856-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 62,
       "fullName": "Robert Ortt",
       "imgName": "885_robert_ortt.jpg",
       "incumbent": true,
       "memberId": 885,
       "sessionMemberId": 879,
       "sessionYear": 2015,
       "shortName": "ORTT"
      }
     ],
     "size": 1
