    "actClause": "AN ACT to amend the executive law, in relation to a prohibition on diversion of resources from dedicated funds derived from taxes and fees that support the Niagara frontier transportation authority and its subsidiaries in certain instances",
    "basePrintNo": "S4523",
    "basePrintNoStr": "S4523-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 60,
       "fullName": "Marc Panepinto",
       "imgName": "894_marc_panepinto.jpg",
       "incumbent": false,
       "memberId": 894,
