    "actClause": "AN ACT to amend the general municipal law, in relation to urban development action areas",
    "basePrintNo": "S5914",
    "basePrintNoStr": "S5914-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
