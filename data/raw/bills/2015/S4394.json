   "": {
    "actClause": "AN ACT to amend the criminal procedure law, in relation to exempting victims of sex trafficking from the DNA databank fee",
    "basePrintNo": "S4394",
    "basePrintNoStr": "S4394-2015",
    "coSponsors": {
