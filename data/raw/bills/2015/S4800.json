   "": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to authorizing farm distillery licensees to sell gift items",
    "basePrintNo": "S4800",
    "basePrintNoStr": "S4800-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 60,
       "fullName": "Marc Panepinto",
       "imgName": "894_marc_panepinto.jpg",
       "incumbent": false,
       "memberId": 894,
       "sessionMemberId": 888,
       "sessionYear": 2015,
       "shortName": "PANEPINTO"
      }
     ],
     "size": 1
