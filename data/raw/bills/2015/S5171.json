   "A": {
    "actClause": "AN ACT to amend the tax law, in relation to authorizing Jefferson county to impose an additional one percent rate of sales and compensating use taxes",
    "basePrintNo": "S5171",
    "basePrintNoStr": "S5171-2015",
    "coSponsors": {
