   "": {
    "actClause": "AN ACT to amend the general municipal law and the education law, in relation to insurance reserve funds of certain school districts",
    "basePrintNo": "S6876",
    "basePrintNoStr": "S6876-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
