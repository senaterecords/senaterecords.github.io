   "A": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the state highway system as the \"Trooper Christopher G. Skinner Memorial Bridge\"",
    "basePrintNo": "S3468",
    "basePrintNoStr": "S3468-2015",
    "coSponsors": {
     "items": [],
