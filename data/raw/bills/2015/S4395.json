   "": {
    "actClause": "AN ACT to amend the real property tax law, in relation to the base proportion in approved assessing units in Nassau county",
    "basePrintNo": "S4395",
    "basePrintNoStr": "S4395-2015",
    "coSponsors": {
     "items": [
