    "actClause": "AN ACT to amend the criminal procedure law, in relation to unsealing criminal records",
    "basePrintNo": "S5640",
    "basePrintNoStr": "S5640-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
