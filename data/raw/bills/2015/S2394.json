    "actClause": "AN ACT to amend the correction law, in relation to agreements for custody of definite sentence inmates",
    "basePrintNo": "S2394",
    "basePrintNoStr": "S2394-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
