   "": {
    "actClause": "AN ACT to amend the tax law, in relation to the creation of a biotechnology research and development investment tax credit",
    "basePrintNo": "S4138",
    "basePrintNoStr": "S4138-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 62,
       "fullName": "Robert Ortt",
       "imgName": "885_robert_ortt.jpg",
       "incumbent": true,
       "memberId": 885,
       "sessionMemberId": 879,
       "sessionYear": 2015,
       "shortName": "ORTT"
