       "sessionYear": 2015,
       "shortName": "GALLIVAN"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 62,
       "fullName": "Robert Ortt",
       "imgName": "885_robert_ortt.jpg",
       "incumbent": true,
