    "actClause": "AN ACT to amend the penal law, in relation to changing the age of the victim intended for a specific crime of assault",
    "basePrintNo": "S2082",
    "basePrintNoStr": "S2082-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 59,
       "fullName": "Patrick M. Gallivan",
       "imgName": "427_patrick_m._gallivan.jpg",
       "incumbent": true,
