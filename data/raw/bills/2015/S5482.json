   "": {
    "actClause": "AN ACT to amend the mental hygiene law, in relation to the effect of registration for purposes of the uniform guardianship and protective proceedings jurisdiction act",
    "basePrintNo": "S5482",
    "basePrintNoStr": "S5482-2015",
