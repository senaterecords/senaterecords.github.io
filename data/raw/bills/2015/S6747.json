   "": {
    "actClause": "AN ACT to amend the education law, in relation to establishing the St. Patrick's Day school holiday",
    "basePrintNo": "S6747",
    "basePrintNoStr": "S6747-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
       "incumbent": true,
       "memberId": 384,
       "sessionMemberId": 726,
       "sessionYear": 2015,
       "shortName": "ADDABBO"
      }
     ],
     "size": 1
