    "actClause": "AN ACT to amend the correction law, in relation to the restraint of pregnant female prisoners during childbirth",
    "basePrintNo": "S983",
    "basePrintNoStr": "S983-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
