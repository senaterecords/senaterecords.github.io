   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to tinting on motor vehicle windows",
    "basePrintNo": "S6034",
    "basePrintNoStr": "S6034-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 62,
       "fullName": "Robert Ortt",
       "imgName": "885_robert_ortt.jpg",
       "incumbent": true,
       "memberId": 885,
       "sessionMemberId": 879,
       "sessionYear": 2015,
       "shortName": "ORTT"
      }
     ],
     "size": 1
