   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to the powers of the Ogdensburg bridge authority and the Ogdensburg port authority",
    "basePrintNo": "S5861",
    "basePrintNoStr": "S5861-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
