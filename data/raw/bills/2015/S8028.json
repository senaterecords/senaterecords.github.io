   "": {
    "actClause": "Concurrent Resolution of the Senate and Assembly proposing an amendment to section 1 of article 14 of the constitution, in relation to authorizing the sale of certain forest preserve land which was not intended to be included in the forest preserve",
    "basePrintNo": "S8028",
    "basePrintNoStr": "S8028-2015",
    "coSponsors": {
