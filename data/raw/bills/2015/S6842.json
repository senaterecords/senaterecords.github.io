   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to misbranding of certain fish species",
    "basePrintNo": "S6842",
    "basePrintNoStr": "S6842-2015",
    "coSponsors": {
     "items": [],
     "size": 0
