   "": {
    "actClause": "AN ACT to amend the executive law, in relation to annual reports concerning veteran-owned small businesses",
    "basePrintNo": "S656",
    "basePrintNoStr": "S656-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 37,
       "fullName": "George Latimer",
       "imgName": "434_george_latimer.jpg",
       "incumbent": false,
       "memberId": 434,
       "sessionMemberId": 717,
       "sessionYear": 2015,
       "shortName": "LATIMER"
