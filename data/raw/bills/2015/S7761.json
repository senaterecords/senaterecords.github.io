   "": {
    "actClause": "AN ACT authorizing the county of Saratoga to transfer and convey reforested lands on Kinns Road to the town of Clifton Park, county of Saratoga",
    "basePrintNo": "S7761",
    "basePrintNoStr": "S7761-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
       "memberId": 435,
       "sessionMemberId": 699,
