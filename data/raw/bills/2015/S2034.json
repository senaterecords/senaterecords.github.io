   "": {
    "actClause": "AN ACT to amend the executive law, in relation to the definition of necessary court appearances for purposes of determining crime victim's award",
    "basePrintNo": "S2034",
    "basePrintNoStr": "S2034-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
