    "actClause": "AN ACT to amend the public health law, in relation to directing the commissioner of health to collect data on the early intervention program for infants and toddlers with disabilities",
    "basePrintNo": "S5497",
    "basePrintNoStr": "S5497-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 6,
       "fullName": "Kemp Hannon",
       "imgName": "424_kemp_hannon.jpg",
       "incumbent": false,
       "memberId": 424,
       "sessionMemberId": 871,
       "sessionYear": 2015,
       "shortName": "HANNON"
      }
     ],
     "size": 1
