   "": {
    "actClause": "AN ACT to amend the education law, in relation to creating the topical medication safety and efficacy act",
    "basePrintNo": "S4313",
    "basePrintNoStr": "S4313-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
