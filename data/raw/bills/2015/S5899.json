    "actClause": "AN ACT to amend the civil practice law and rules, in relation to the reporting of awards pursuant to the New York state equal access to justice act",
    "basePrintNo": "S5899",
    "basePrintNoStr": "S5899-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
