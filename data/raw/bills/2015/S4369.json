   "": {
    "actClause": "AN ACT to amend the education law, in relation to authorizing the Yonkers city school district to require certain minors who are five years of age to attend kindergarten",
    "basePrintNo": "S4369",
    "basePrintNoStr": "S4369-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 37,
       "fullName": "George Latimer",
       "imgName": "434_george_latimer.jpg",
