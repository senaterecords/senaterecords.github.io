       "sessionYear": 2015,
       "shortName": "MARCHIONE"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 48,
       "fullName": "Patty Ritchie",
       "imgName": "423_patty_ritchie.jpg",
       "incumbent": false,
       "memberId": 423,
       "sessionMemberId": 701,
       "sessionYear": 2015,
       "shortName": "RITCHIE"
      }
