   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law and the education law, in relation to random drug and alcohol testing of bus drivers",
    "basePrintNo": "S2147",
    "basePrintNoStr": "S2147-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
