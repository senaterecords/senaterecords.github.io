   "": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to accidental disability retirement for uniformed court officers and peace officers employed in the unified court system",
    "basePrintNo": "S3947",
    "basePrintNoStr": "S3947-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
