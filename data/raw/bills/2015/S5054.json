    "actClause": "AN ACT to amend the family court act and the executive law, in relation to severe child abuse and orders of protection in child abuse and neglect cases",
    "basePrintNo": "S5054",
    "basePrintNoStr": "S5054-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 59,
       "fullName": "Patrick M. Gallivan",
       "imgName": "427_patrick_m._gallivan.jpg",
       "incumbent": true,
       "memberId": 427,
       "sessionMemberId": 696,
       "sessionYear": 2015,
       "shortName": "GALLIVAN"
      }
     ],
     "size": 1
    },
    "fullText": "",
