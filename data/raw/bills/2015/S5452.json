   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to service by mail provisions of, and jurisdiction over violations occurring on MTA omnibuses by the transit adjudication bureau of the New York city transit authority",
    "basePrintNo": "S5452",
    "basePrintNoStr": "S5452-2015",
    "coSponsors": {
