   "": {
    "actClause": "AN ACT to amend the parks, recreation and historic preservation law, in relation to designating a portion of state route twelve and a portion of state route twenty-eight in the town of Boonville in Oneida county for snowmobile use",
    "basePrintNo": "S7231",
    "basePrintNoStr": "S7231-2015",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
