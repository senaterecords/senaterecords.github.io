 "substitutedBy": null,
 "summary": "Requires applicants for all-night liquor licenses to notify local community boards of their intent to apply for such licenses.",
 "title": "Requires applicants for all-night liquor licenses to notify local community boards of their intent to apply for such licenses",
 "vetoMessages": {
  "items": [
   {
    "billId": {
