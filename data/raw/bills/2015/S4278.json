   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to exempting fire vehicles from the weight restrictions of other vehicles",
    "basePrintNo": "S4278",
    "basePrintNoStr": "S4278-2015",
    "coSponsors": {
