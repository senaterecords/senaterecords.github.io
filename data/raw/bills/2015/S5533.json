   "": {
    "actClause": "AN ACT to amend the judiciary law, in relation to providing real time court reporting services to individuals who are deaf or hard of hearing",
    "basePrintNo": "S5533",
    "basePrintNoStr": "S5533-2015",
    "coSponsors": {
     "items": [],
     "size": 0
