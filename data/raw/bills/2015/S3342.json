   "": {
    "actClause": "AN ACT to amend the public housing law, in relation to requiring the New York city housing authority to provide elderly tenants with notice of opportunity to meet to discuss possible termination of tenancy",
    "basePrintNo": "S3342",
    "basePrintNoStr": "S3342-2015",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 17,
       "fullName": "Simcha Felder",
       "imgName": "439_simcha_felder.jpg",
       "incumbent": false,
       "memberId": 439,
       "sessionMemberId": 851,
       "sessionYear": 2015,
       "shortName": "FELDER"
      }
     ],
     "size": 1
