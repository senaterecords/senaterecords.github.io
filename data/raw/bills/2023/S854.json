   "": {
    "actClause": "AN ACT to amend the executive law, in relation to authorizing public requests\nfor information from any county, city, town, or village desiring to have any\nmemorial located within their municipality listed within the veterans memorial\nregistry; to amend the veterans' services law, in relation to directing the\ndepartment of veterans' services to establish a veterans memorial registry;\nand to repeal section 368-b of the executive law relating thereto",
    "basePrintNo": "S854",
    "basePrintNoStr": "S854-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
