   "": {
    "actClause": "AN ACT to amend the education law, in relation to digital materials",
    "basePrintNo": "S5986",
    "basePrintNoStr": "S5986-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 48,
