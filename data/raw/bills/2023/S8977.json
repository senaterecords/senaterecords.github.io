   "": {
    "actClause": "AN ACT to amend the executive law and the general business law, in relation to\nrequiring a lethality assessment in incidents of domestic violence",
    "basePrintNo": "S8977",
    "basePrintNoStr": "S8977-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 37,
       "fullName": "Shelley Mayer",
       "imgName": "623_shelley_mayer.jpg",
       "incumbent": true,
       "memberId": 1143,
       "sessionMemberId": 2024,
       "sessionYear": 2023,
       "shortName": "MAYER"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "Robert Rolison",
       "imgName": "1336_Robert_Rolison.jpg",
       "incumbent": true,
       "memberId": 1519,
       "sessionMemberId": 1882,
       "sessionYear": 2023,
       "shortName": "ROLISON"
      }
     ],
     "size": 2
