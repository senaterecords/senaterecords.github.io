   "": {
    "actClause": "AN ACT to amend the general obligations law and the state technology law, in\nrelation to electronic signatures and salvage title",
    "basePrintNo": "S3542",
    "basePrintNoStr": "S3542-2023",
    "coSponsors": {
     "items": [],
     "size": 0
