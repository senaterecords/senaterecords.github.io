   "": {
    "actClause": "AN ACT to amend the general business law, in relation to providing notice of\npotential scams when selling gift cards",
    "basePrintNo": "S1329",
    "basePrintNoStr": "S1329-2023",
    "coSponsors": {
     "items": [
