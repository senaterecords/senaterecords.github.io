   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to providing\nan exemption from requirements for the alienation of parkland for renewable\nenergy generating projects in the county of Westchester",
    "basePrintNo": "S9547",
    "basePrintNoStr": "S9547-2023",
