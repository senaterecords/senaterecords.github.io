   "": {
    "actClause": "AN ACT to amend the penal law, the criminal procedure law, the correction law,\nthe social services law, the vehicle and traffic law, the family court act,\nthe civil rights law, the civil practice law and rules, the agriculture and\nmarkets law, the judiciary law and the domestic relations law, in relation to\nsex offenses; and to repeal certain provisions of the penal law relating\nthereto",
    "basePrintNo": "S3161",
    "basePrintNoStr": "S3161-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
