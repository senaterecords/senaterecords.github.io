   "": {
    "actClause": "AN ACT to amend the state finance law, in relation to requiring commercial\ngarages containing electric vehicle charging stations to ensure public access\nto such charging stations commercially reasonable rental or fee rates",
    "basePrintNo": "S110",
    "basePrintNoStr": "S110-2023",
    "coSponsors": {
