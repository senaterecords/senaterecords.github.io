   "": {
    "actClause": "AN ACT to amend the criminal procedure law, in relation to granting peace\nofficer status to certain security officers employed by Rochester Regional\nHealth or its subsidiaries",
    "basePrintNo": "S8714",
    "basePrintNoStr": "S8714-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 56,
       "fullName": "Jeremy Cooney",
       "imgName": "1318_Jeremy_Cooney.jpg",
