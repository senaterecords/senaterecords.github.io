 "substitutedBy": null,
 "summary": "Prohibits individuals in certain positions from taking any position with a business or entity doing business with an agency or industrial development authority.",
 "title": "Prohibits individuals in certain positions from taking any position with a business or entity doing business with an agency or industrial development authority",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A4847",
     "basePrintNoStr": "A4847-2023",
     "printNo": "A4847",
     "session": 2023,
     "version": ""
