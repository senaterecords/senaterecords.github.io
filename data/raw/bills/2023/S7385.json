    "actClause": "AN ACT to amend the insurance law, in relation to exempting certain public\nconstruction projects from certain restrictions",
    "basePrintNo": "S7385",
    "basePrintNoStr": "S7385-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
       "imgName": "888_leroy_comrie.jpg",
       "incumbent": true,
