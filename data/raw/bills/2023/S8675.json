   "": {
    "actClause": "AN ACT to amend chapter 396 of the laws of 2012 amending the education law\nrelating to services to out-of-state school districts by boards of cooperative\neducational services, in relation to the effectiveness thereof",
    "basePrintNo": "S8675",
    "basePrintNoStr": "S8675-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "William Weber",
       "imgName": "1335_William_Weber.jpg",
       "incumbent": true,
       "memberId": 1518,
       "sessionMemberId": 1881,
       "sessionYear": 2023,
       "shortName": "WEBER"
      }
     ],
     "size": 1
