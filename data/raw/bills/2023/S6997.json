   "A": {
    "actClause": "AN ACT to amend the tax law, in relation to the eligibility criteria for the\ndigital gaming tax credit",
    "basePrintNo": "S6997",
    "basePrintNoStr": "S6997-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
