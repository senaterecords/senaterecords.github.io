   "": {
    "actClause": "AN ACT to amend the multiple residence law and the multiple dwelling law, in\nrelation to requiring owners and agents of multiple residences and multiple\ndwellings to provide names and contact information of residents to emergency\npersonnel",
    "basePrintNo": "S8035",
    "basePrintNoStr": "S8035-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
