  "items": {
   "": {
    "actClause": "AN ACT to amend chapter 890 of the laws of 1982, relating to the establishment\nof certain water charges for hospitals and charities in New York city, in\nrelation to the effectiveness thereof",
    "basePrintNo": "S9736",
    "basePrintNoStr": "S9736-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §2, Chap 890 of 1982",
    "lawSection": "Public Authorities",
    "memo": " \nBILL NUMBER: S9736\n\nSPONSOR: SEPULVEDA\n \nTITLE OF BILL:\n\nAn act to amend chapter 890 of the laws of 1982, relating to the estab-\nlishment of certain water charges for hospitals and charities in New\nYork city, in relation to the effectiveness thereof\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\nThis legislation limits water charges for hospitals and charitable\norganizations.\n\n \nSUMMARY OF PROVISIONS:\n\nThis bill amends Chapter 890 of the Laws of 1982 to extend its expira-\ntion date until September 1, 2026. This legislation would continue\nreduced water rates. for hospitals and charitable institutions in New\nYork City.\n\n \nJUSTIFICATION:\n\nThis legislation would extend for two years a long-standing reduction in\nwater charges offered to hospitals and other charitable organizations in\nNew York City. The continuation of the exemptions would help to ease\nsome of the financial burdens on these important institutions.\n\n \nPRIOR LEGISLATIVE HISTORY:\n\n2022: Chapter 430 of the Laws of 2022\n\n2018: Chapter 155 of the Laws of 2018.\n\n \nFISCAL IMPLICATIONS:\n\nNone to the State.\n\n \nEFFECTIVE DATE:\nThis act would take effect immediately.\n",
    "multiSponsors": {
