   "": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to\naccidental disability retirement for uniformed court officers and peace\nofficers employed in the unified court system",
    "basePrintNo": "S3492",
    "basePrintNoStr": "S3492-2023",
