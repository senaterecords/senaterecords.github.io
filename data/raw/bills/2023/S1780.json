   "": {
    "actClause": "AN ACT to incentivize the purchase of local produce in supermarkets and\ngrocery stores through the FreshConnect program",
    "basePrintNo": "S1780",
    "basePrintNoStr": "S1780-2023",
    "coSponsors": {
