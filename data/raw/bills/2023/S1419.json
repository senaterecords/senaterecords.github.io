   "": {
    "actClause": "AN ACT to amend the executive law, in relation to requiring agencies to\nprovide unsuccessful bidders that are certified minority and women-owned\nbusiness enterprises with a written statement articulating the reasons for\nsuch rejection",
    "basePrintNo": "S1419",
    "basePrintNoStr": "S1419-2023",
