 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the correction law, in relation to rules and regulations for\nstrip searches in correctional facilities",
    "basePrintNo": "S9350",
    "basePrintNoStr": "S9350-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §45, Cor L",
    "lawSection": "Correction Law",
    "memo": " \nBILL NUMBER: S9350\n\nSPONSOR: SALAZAR\n \nTITLE OF BILL:\n\nAn act to amend the correction law, in relation to rules and regulations\nfor strip searches in correctional facilities\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\nProvides for rules and regulations for strip searches in correctional\nfacilities.\n\n \nSUMMARY OF PROVISIONS:\n\nSection 1 Section 45 of correction law is amended to create a new subdi-\nvision 20 to promulgate rules and regulations for standard procedures\nfor the use of strip searches in a correctional facility and states that\nno fewer that two staff members shall be present for any strip search.\n\n \nJUSTIFICATION:\n\nTo prevent misconduct caused by staff in performing a strip search and\nto protect the safety and rights of incarcerated individuals.\n\n \nPRIOR LEGISLATIVE HISTORY:\n\nNot Applicable\n\n \nFISCAL IMPLICATIONS FOR STATE AND LOCAL GOVERNMENTS:\n\nTo Be Determined\n\n \nEFFECTIVE DATE:\nThis act shall take effect on the ninetieth day after it shall have\nbecome a law.\n",
    "multiSponsors": {
