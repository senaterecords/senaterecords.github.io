 "substitutedBy": null,
 "summary": "Strengthens provisions relating to complaint handling procedures by the public service commission; requires certain response times.",
 "title": "Relates to complaint handling procedures for customers of public utilities",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A1745",
     "basePrintNoStr": "A1745-2023",
     "printNo": "A1745",
     "session": 2023,
     "version": ""
    },
    "billPage": 0,
    "chapter": 0,
    "lineEnd": 0,
    "lineStart": 0,
    "memoText": " \n                          VETO MESSAGE - No. 21\n \nTO THE ASSEMBLY:\n \nI am returning herewith, without my approval, the following bill:\n \nAssembly Bill Number 1745-A, entitled:\n \n    \"AN  ACT  to  amend the public service law, in relation to complaint\n      handling procedures by the public service commission\"\n \n    NOT APPROVED\n \n  This bill would amend the public service law to require utility corpo-\nrations and municipalities to report the result of an investigation into\na customer complaint in writing to a complainant within 15 business days\nfor a utility corporation and within 30  business  days  for  a  munici-\npality.  It would also remove the Public Service Commission's discretion\nto hear appeals regarding consumer complaint determinations  and  remove\nthe  requirement  that  the  Commission  use its best efforts to issue a\nfinal written determination of any appeal within 90 days, replacing this\ndiscretion with a new legal requirement upon the Commission that it hear\nall appeals.\n \n  Removing the Commission's discretion to hear appeals would result in a\nless effective process for consumers, potentially increasing the time to\nobtain a determination. It would also create a  significantly  increased\nworkload  for  the  Commission's  staff  and  would  result in increased\nexpense to the State.\n \n  Therefore, I am constrained to veto this bill.\n \n  The bill is disapproved.                       (signed) KATHY HOCHUL\n \n                               __________\n",
    "signedDate": null,
    "signer": "KATHY HOCHUL",
    "vetoNumber": 21,
    "vetoType": "STANDARD",
    "year": 2024
   }
  ],
  "size": 1
 },
