   "": {
    "actClause": "AN ACT to amend the real property law, in relation to prohibiting mortgagees\nfrom requiring mortgagors of certain real property to purchase flood insurance\nexceeding certain limits",
    "basePrintNo": "S7125",
    "basePrintNoStr": "S7125-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 1,
       "fullName": "Anthony H. Palumbo",
       "imgName": "666_anthony_h._palumbo.jpg",
       "incumbent": true,
       "memberId": 1489,
       "sessionMemberId": 2041,
       "sessionYear": 2023,
       "shortName": "PALUMBO"
      }
     ],
