 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the real property law, in relation to providing a deceased\ntenant's legal representative the option to terminate such tenant's lease upon\nnotice to the landlord",
    "basePrintNo": "S548",
    "basePrintNoStr": "S548-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Add §236-a, RP L",
    "lawSection": "Real Property Law",
    "memo": " \nBILL NUMBER: S548\n\nSPONSOR: HOYLMAN\n \nTITLE OF BILL:\n\nAn act to amend the real property law, in relation to providing a\ndeceased tenant's legal representative the option to terminate such\ntenant's lease upon notice to the landlord\n\n \nPURPOSE:\n\nTo provide a deceased tenant's estate the option to terminate the\ndeceased tenant's lease.\n\n \nSUMMARY OF SPECIFIC PROVISIONS:\n\nSection 1 of the bill creates a new Section 236-a of the Real Property\nLaw to provide a deceased tenant's estate the option of terminating the\ndeceased's lease upon the consent of any co-tenant or guarantor of the\nlease, and notice being given to the landlord.\n\nSection 2 of the bill is the effective date.\n\n \nJUSTIFICATION:\n\nUnless addressed in a residential lease agreement, New York State law\ndoes not currently provide the estate of a deceased tenant with the\nright to terminate the lease upon the death of the tenant. Allowing\nlandlords to hold deceased tenants to their lease terms represents an\nunreasonable financial burden on the estate.\n\n \nLEGISLATIVE HISTORY:\n\n \nFISCAL IMPLICATIONS:\n\nNone.\n\n \nEFFECTIVE DATE:\nThis act shall take effect on the ninetieth day after it shall become\nlaw.\n",
    "multiSponsors": {
