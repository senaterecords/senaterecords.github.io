   "": {
    "actClause": "AN ACT to amend chapter 429 of the laws of 2021 amending the general business\nlaw relating to the applicability of the security guard act of nineteen\nhundred ninety-two to facilities owned by a public sports venue, in relation\nto the effectiveness thereof",
    "basePrintNo": "S9680",
    "basePrintNoStr": "S9680-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 60,
       "fullName": "Patrick M. Gallivan",
       "imgName": "427_patrick_m._gallivan.jpg",
       "incumbent": true,
       "memberId": 427,
       "sessionMemberId": 2010,
       "sessionYear": 2023,
       "shortName": "GALLIVAN"
      }
     ],
     "size": 1
