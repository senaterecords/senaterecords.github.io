   "": {
    "actClause": "AN ACT to amend the social services law, in relation to prohibiting requiring\nparents or caretakers to earn a minimum wage or work a minimum number of hours\nto be eligible for child care assistance",
    "basePrintNo": "S4924",
    "basePrintNoStr": "S4924-2023",
