   "": {
    "actClause": "AN ACT to amend the correction law, in relation to increasing access to\nsubstance abuse programming for incarcerated individuals whose first language\nis not English",
    "basePrintNo": "S1233",
    "basePrintNoStr": "S1233-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 31,
       "fullName": "Robert Jackson",
       "imgName": "1050_Robert_Jackson.jpg",
       "incumbent": true,
       "memberId": 1230,
       "sessionMemberId": 2017,
       "sessionYear": 2023,
       "shortName": "JACKSON"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 1878,
       "sessionYear": 2023,
       "shortName": "WEBB"
      }
