   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to providing for the issuance\nof pet insurance",
    "basePrintNo": "S7845",
    "basePrintNoStr": "S7845-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 56,
       "fullName": "Jeremy Cooney",
       "imgName": "1318_Jeremy_Cooney.jpg",
       "incumbent": true,
