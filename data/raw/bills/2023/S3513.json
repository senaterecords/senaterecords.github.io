   "": {
    "actClause": "AN ACT to authorize Douglas Brenning of the village of New York Mills to take\nthe competitive civil service examination for the position of police officer\nand be placed on the eligible list for employment as a full-time police\nofficer for the village of New York Mills police department",
    "basePrintNo": "S3513",
    "basePrintNoStr": "S3513-2023",
    "coSponsors": {
