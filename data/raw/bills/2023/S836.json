   "": {
    "actClause": "AN ACT to amend the insurance law and the public health law, in relation to\npatient prescription pricing transparency; and to repeal certain provisions of\nthe insurance law related thereto",
    "basePrintNo": "S836",
    "basePrintNoStr": "S836-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
