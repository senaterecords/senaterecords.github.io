   "": {
    "actClause": "AN ACT in relation to allowing for Genesis Villella to qualify for and receive\ncertain spousal accidental death benefits",
    "basePrintNo": "S7221",
    "basePrintNoStr": "S7221-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 32,
       "fullName": "Luis R. Sepúlveda",
       "imgName": "493_Luis_Sepulveda.jpg",
       "incumbent": true,
       "memberId": 1142,
       "sessionMemberId": 2034,
       "sessionYear": 2023,
       "shortName": "SEPULVEDA"
      }
