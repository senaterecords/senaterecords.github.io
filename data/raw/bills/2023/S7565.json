   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to reduction\nof air pollution from petroleum bulk storage facilities",
    "basePrintNo": "S7565",
    "basePrintNoStr": "S7565-2023",
    "coSponsors": {
