   "": {
    "actClause": "AN ACT to amend the workers' compensation law, in relation to workers' access\nto treatment",
    "basePrintNo": "S6929",
    "basePrintNoStr": "S6929-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 47,
       "fullName": "Brad Hoylman-Sigal",
       "imgName": "438_brad_hoylman.jpg",
       "incumbent": false,
       "memberId": 438,
       "sessionMemberId": 2313,
       "sessionYear": 2023,
       "shortName": "HOYLMAN-SIGAL"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 31,
       "fullName": "Robert Jackson",
       "imgName": "1050_Robert_Jackson.jpg",
       "incumbent": true,
       "memberId": 1230,
       "sessionMemberId": 2017,
       "sessionYear": 2023,
       "shortName": "JACKSON"
      }
     ],
     "size": 2
