    "actClause": "AN ACT to amend the social services law, in relation to determination and\napproval of reimbursement rates for managed care providers under medicaid",
    "basePrintNo": "S6075",
    "basePrintNoStr": "S6075-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
