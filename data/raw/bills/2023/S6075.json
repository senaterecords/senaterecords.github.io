       "shortName": "MAY"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 1878,
       "sessionYear": 2023,
       "shortName": "WEBB"
      }
     ],
     "size": 2
