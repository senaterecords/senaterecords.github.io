   "": {
    "actClause": "AN ACT to amend chapter 223 of the laws of 1996 amending the banking law\nrelating to permissible fees in connection with open end loans, in relation to\nextending the effectiveness thereof",
    "basePrintNo": "S6920",
    "basePrintNoStr": "S6920-2023",
    "coSponsors": {
