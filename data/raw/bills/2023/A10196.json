 "substitutedBy": null,
 "summary": "Authorizes distributors of cannabis products to file electronic returns annually instead of quarterly.",
 "title": "Authorizes distributors of cannabis products to file annual returns electronically",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A10196",
     "basePrintNoStr": "A10196-2023",
     "printNo": "A10196",
     "session": 2023,
     "version": ""
    },
    "billPage": 0,
    "chapter": 0,
    "lineEnd": 0,
    "lineStart": 0,
    "memoText": " \n                         VETO MESSAGE - No. 124\n \nTO THE ASSEMBLY:\n \nI am returning herewith, without my approval, the following bill:\n \nAssembly Bill Number 10196, entitled:\n \n    \"AN  ACT  to amend the tax law, in relation to authorizing distribu-\n      tors of cannabis products to file annual returns electronically\"\n \n    NOT APPROVED\n \n  This bill  would  allow  cannabis  product  distributors  to  make  an\nelection  to file and remit cannabis product taxes annually, rather than\nquarterly.\n \n  New York's cannabis market is growing stronger every  day,  and  I  am\nproud  of  the  work  we've done to make the industry more equitable for\nfirst-time entrepreneurs. However, this legislation would  significantly\ndisrupt  the  State's  established tax administration system by altering\nour longstanding framework for tax collection and reporting periods  and\ncreating  a  new  deadline for filers. The new deadline in the bill does\nnot match any existing tax deadlines, which would pose significant oper-\national challenges for the State and confusion for taxpayers.\n \n  Therefore, I am constrained to veto this bill.\n \n  The bill is disapproved.                       (signed) KATHY HOCHUL\n \n                               __________\n",
    "signedDate": null,
    "signer": "KATHY HOCHUL",
    "vetoNumber": 124,
    "vetoType": "STANDARD",
    "year": 2024
   }
  ],
  "size": 1
 },
