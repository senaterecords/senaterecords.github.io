   "": {
    "actClause": "AN ACT to amend the highway law, in relation to the percentage responsibility\nof the state for federally assisted projects; and to amend chapter 329 of the\nlaws of 1991 amending the state finance law and other laws relating to\nestablishing the dedicated highway and bridge trust fund and the dedicated\nmass transportation fund, in relation to the state share of municipal projects\nwhere the municipality funds a complete street design",
    "basePrintNo": "S840",
    "basePrintNoStr": "S840-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "Robert Rolison",
       "imgName": "1336_Robert_Rolison.jpg",
       "incumbent": true,
       "memberId": 1519,
       "sessionMemberId": 1882,
       "sessionYear": 2023,
       "shortName": "ROLISON"
      }
     ],
