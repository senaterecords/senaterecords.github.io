    "actClause": "Concurrent Resolution of the Senate and Assembly proposing an amendment to\nsection 4 of article 8 of the constitution, in relation to limitations on\nlocal indebtedness",
    "basePrintNo": "S5025",
    "basePrintNoStr": "S5025-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 1878,
       "sessionYear": 2023,
       "shortName": "WEBB"
      }
     ],
     "size": 1
