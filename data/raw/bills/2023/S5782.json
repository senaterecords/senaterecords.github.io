   "": {
    "actClause": "AN ACT to amend the executive law, in relation to including Silver Lake Outlet\nwithin the definition of \"inland waterways\" for the purposes of waterfront\nrevitalization",
    "basePrintNo": "S5782",
    "basePrintNoStr": "S5782-2023",
    "coSponsors": {
