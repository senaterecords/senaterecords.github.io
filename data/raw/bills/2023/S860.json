   "": {
    "actClause": "AN ACT to amend the domestic relations law, in relation to mandatory training\nof a forensic evaluator in relation to court ordered forensic evaluations\ninvolving child custody and visitation when the child is living out-of-state;\nto amend the executive law, in relation to training in the prevention and\nintervention of domestic violence required for forensic investigators; and to\namend a chapter of the laws of 2022 amending the domestic relations law and\nthe executive law, relating to court ordered forensic evaluations involving\nchild custody and visitation, as proposed in legislative bills numbers S.\n6385-B and A. 2375-C, relating to the effectiveness thereof",
    "basePrintNo": "S860",
    "basePrintNoStr": "S860-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 57,
       "fullName": "George Borrello",
       "imgName": "57_george_borrello.jpg",
       "incumbent": true,
       "memberId": 1370,
