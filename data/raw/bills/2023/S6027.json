   "": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the\nstate highway system as the \"Doc Schelin Memorial Highway\"",
    "basePrintNo": "S6027",
    "basePrintNoStr": "S6027-2023",
