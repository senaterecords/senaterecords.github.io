   "": {
    "actClause": "AN ACT to amend the education law, in relation to the New York state college\nchoice tuition savings program",
    "basePrintNo": "S9701",
    "basePrintNoStr": "S9701-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 17,
       "fullName": "Iwen Chu",
       "imgName": "1331_Iwen_Chu.jpg",
       "incumbent": false,
       "memberId": 1514,
       "sessionMemberId": 1877,
       "sessionYear": 2023,
       "shortName": "CHU"
      }
     ],
     "size": 1
