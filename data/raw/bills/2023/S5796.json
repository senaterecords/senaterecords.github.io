   "": {
    "actClause": "AN ACT in relation to authorizing the Ruth AME Zion Church to file with the\ntown of Brookhaven assessor an application for certain real property tax\nexemptions",
    "basePrintNo": "S5796",
    "basePrintNoStr": "S5796-2023",
    "coSponsors": {
