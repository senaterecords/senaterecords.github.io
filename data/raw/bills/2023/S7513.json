   "": {
    "actClause": "AN ACT to amend the state finance law, in relation to making technical\ncorrections to a definition for purposes of the excelsior linked deposit\nprogram",
    "basePrintNo": "S7513",
    "basePrintNoStr": "S7513-2023",
