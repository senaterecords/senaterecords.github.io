   "": {
    "actClause": "AN ACT authorizing the county of Nassau to alienate and sell parklands to\nLakeside Inn, Inc.",
    "basePrintNo": "S9195",
    "basePrintNoStr": "S9195-2023",
    "coSponsors": {
