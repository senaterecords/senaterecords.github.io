   "": {
    "actClause": "AN ACT to repeal paragraph (g) of subdivision 4 of section 209 of the civil\nservice law, relating to resolutions of disputes in the course of collective\nnegotiations with certain deputy sheriffs",
    "basePrintNo": "S8515",
    "basePrintNoStr": "S8515-2023",
