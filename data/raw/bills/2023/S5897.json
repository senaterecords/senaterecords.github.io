   "": {
    "actClause": "AN ACT to amend the social services law, in relation to reporting of youth\nplaced in foster care settings and recruitment of foster parents; and to\nrepeal section 2 of chapter 11 of the laws of 2021, relating to directing the\noffice of children and family services to make information publicly available\non the number of youth placed in foster care settings and recruitment of\nfoster parents and the effectiveness thereof",
    "basePrintNo": "S5897",
    "basePrintNoStr": "S5897-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Julia Salazar",
       "imgName": "1047_Julia_Salazar.jpg",
       "incumbent": true,
       "memberId": 1227,
       "sessionMemberId": 2032,
       "sessionYear": 2023,
       "shortName": "SALAZAR"
      }
     ],
     "size": 1
