   "": {
    "actClause": "AN ACT to establish the people with disabilities access to programs commission",
    "basePrintNo": "S413",
    "basePrintNoStr": "S413-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 30,
       "fullName": "Cordell Cleare",
       "imgName": "Cordell Cleare.jpg",
       "incumbent": true,
       "memberId": 1504,
       "sessionMemberId": 2056,
       "sessionYear": 2023,
       "shortName": "CLEARE"
      }
