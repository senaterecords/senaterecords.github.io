 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the executive law, in relation to providing technical\nassistance to any municipality that has had a college or university close\nwithin such municipality",
    "basePrintNo": "S5234",
    "basePrintNoStr": "S5234-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §153, Exec L",
    "lawSection": "Executive Law",
    "memo": " \nBILL NUMBER: S5234\n\nSPONSOR: MAY\n \nTITLE OF BILL:\n\nAn act to amend the executive law, in relation to providing technical\nassistance to any municipality that has had a college or university\nclose within such municipality\n\n \nPURPOSE:\n\nTo provide more support and technical assistance from the state to muni-\ncipalities experiencing college closures.\n\n \nSUMMARY OF PROVISIONS:\n\nAmends the executive law to require the departments of state, economic\ndevelopment, and education to provide technical assistance upon request\nof a municipality experiencing a college closure to address issues\nrelated to such transition.\n\n \nJUSTIFICATION:\n\nThough they are thankfully rare, the closure of a college can have\ndevastating effects on a community. With many communities in New York\nState serving as home to the faculty, students, and workers of a\ncollege, and their economies strongly tied to these institutions, the\npotential negative impacts can be many. This legislation will help local\ngovernments experiencing such closures tap into the state's expertise in\nplanning, economic development, and more to develop a strategy to\naddress such closures in the unfortunate event of such a closure.\n\n \nLEGISLATIVE HISTORY:\n\nNew bill.\n\n \nFISCAL IMPLICATIONS:\n\nTo be determined.\n\n \nEFFECTIVE DATE:\nImmediately.\n",
    "multiSponsors": {
