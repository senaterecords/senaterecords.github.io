 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the tax law, in relation to authorizing the county of Columbia\nto establish hotel and motel taxes",
    "basePrintNo": "S9253",
    "basePrintNoStr": "S9253-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Add §1202-jj, Tax L",
    "lawSection": "Tax Law",
    "memo": " \nBILL NUMBER: S9253\n\nSPONSOR: HINCHEY\n \nTITLE OF BILL:\n\nAn act to amend the tax law, in relation to authorizing the county of\nColumbia to establish hotel and motel taxes\n\n \nPURPOSE:\n\nTo authorize Columbia County to impose an occupancy tax at a rate of\nfour percent.\n\n \nSUMMARY OF PROVISIONS:\n\nSection 1 adds a new section 1202-jj to the Tax Law, which will author-\nize and empower the Columbia County to adopt and amend local laws impos-\ning a tax of up to 4% upon persons occupying hotel or motel rooms in\nsuch county.\n\nSection 2 establishes the effective date.\n\n \nJUSTIFICATION:\n\nThe Board of Supervisors of Columbia County adopted resolution no.\n184-2024 on April 10, 2024, requesting that the New York. State Legisla-\nture introduce and pass legislation authorizing the county to impose an\noccupancy tax of four percent.\n\n \nFISCAL IMPLICATIONS:\n\nNone to the State.\n\n \nLOCAL FISCAL IMPLICATIONS:\n\nThe county will collect additional revenue.\n\n \nEFFECTIVE DATE:\nThis act shall take effect immediately.\n",
    "multiSponsors": {
