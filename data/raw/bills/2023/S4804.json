   "A": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to a Long\nIsland deer management pilot program; and providing for the repeal of such\nprovisions upon expiration thereof",
    "basePrintNo": "S4804",
    "basePrintNoStr": "S4804-2023",
    "coSponsors": {
