   "": {
    "actClause": "AN ACT to amend the social services law, in relation to authorizing certain\nshelters to be reimbursed for housing a single individual in a room intended\nfor double occupancy",
    "basePrintNo": "S15",
    "basePrintNoStr": "S15-2023",
    "coSponsors": {
     "items": [
      {
