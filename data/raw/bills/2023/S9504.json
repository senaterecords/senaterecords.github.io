   "A": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to increasing\npenalties for violation of overtaking and passing a school bus",
    "basePrintNo": "S9504",
    "basePrintNoStr": "S9504-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 54,
       "fullName": "Pamela Helming",
       "imgName": "773_Pamela_Helming.jpg",
