   "": {
    "actClause": "AN ACT to repeal paragraph 9 of subdivision a of section 26-405 of the\nadministrative code of the city of New York, relating to hearings regarding\nbiennial maximum base rent adjustments",
    "basePrintNo": "S563",
    "basePrintNoStr": "S563-2023",
    "coSponsors": {
