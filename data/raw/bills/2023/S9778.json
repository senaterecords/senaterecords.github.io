   "": {
    "actClause": "AN ACT in relation to authorizing the county of Nassau assessor to accept an\napplication for a real property tax exemption from Gurdwara Guru Tegh Bahadur\nSahib, Inc.",
    "basePrintNo": "S9778",
    "basePrintNoStr": "S9778-2023",
    "coSponsors": {
