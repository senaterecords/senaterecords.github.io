   "": {
    "actClause": "AN ACT in relation to the eligibility of enrolled members of Southampton\nVillage Ocean Rescue for the tax exemption on real property authorized by\nsection 466-c of the real property tax law",
    "basePrintNo": "S2158",
    "basePrintNoStr": "S2158-2023",
    "coSponsors": {
