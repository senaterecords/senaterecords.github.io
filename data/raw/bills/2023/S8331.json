    "actClause": "AN ACT to amend the executive law, in relation to establishing January\nthirtieth of each year as a day of commemoration known as \"Fred Korematsu Day\nof Civil Liberties and the Constitution\"",
    "basePrintNo": "S8331",
    "basePrintNoStr": "S8331-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 1878,
       "sessionYear": 2023,
       "shortName": "WEBB"
      }
     ],
     "size": 1
