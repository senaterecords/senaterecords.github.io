    "actClause": "AN ACT to amend the economic development law, in relation to the creation of\nan \"I Love NY Historic Small Business\" niche brand",
    "basePrintNo": "S9268",
    "basePrintNoStr": "S9268-2023",
    "coSponsors": {
     "items": [
