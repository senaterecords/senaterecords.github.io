   "": {
    "actClause": "AN ACT to amend the public service law, in relation to requiring gas\ncorporations to file gas safety reports",
    "basePrintNo": "S2227",
    "basePrintNoStr": "S2227-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
