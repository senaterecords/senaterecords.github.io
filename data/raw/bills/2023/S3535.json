   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the authorization of the\ncounty of Onondaga to impose an additional rate of sales and compensating use\ntaxes",
    "basePrintNo": "S3535",
    "basePrintNoStr": "S3535-2023",
    "coSponsors": {
