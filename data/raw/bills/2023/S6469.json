   "": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the\nstate highway system as the \"Steve Nicoli Memorial Highway\"",
    "basePrintNo": "S6469",
    "basePrintNoStr": "S6469-2023",
    "coSponsors": {
     "items": [],
     "size": 0
