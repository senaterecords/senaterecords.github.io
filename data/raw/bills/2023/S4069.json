   "": {
    "actClause": "AN ACT to amend chapter 672 of the laws of 1993, amending the public\nauthorities law relating to the construction and financing of facilities for\ncertain public libraries, in relation to including the Olean Public Library",
    "basePrintNo": "S4069",
    "basePrintNoStr": "S4069-2023",
    "coSponsors": {
