   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending authorization to impose\ncertain taxes in the county of Sullivan",
    "basePrintNo": "S5501",
    "basePrintNoStr": "S5501-2023",
    "coSponsors": {
