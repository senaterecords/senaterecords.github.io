   "": {
    "actClause": "AN ACT to amend the social services law, in relation to authorizing a prenatal\nand postpartum informational mobile application",
    "basePrintNo": "S7700",
    "basePrintNoStr": "S7700-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Julia Salazar",
       "imgName": "1047_Julia_Salazar.jpg",
       "incumbent": true,
       "memberId": 1227,
       "sessionMemberId": 2032,
       "sessionYear": 2023,
       "shortName": "SALAZAR"
