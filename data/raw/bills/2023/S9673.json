    "actClause": "AN ACT to amend the racing, pari-mutuel wagering and breeding law, in relation\nto the acceleration of the downstate casino licenses",
    "basePrintNo": "S9673",
    "basePrintNoStr": "S9673-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
