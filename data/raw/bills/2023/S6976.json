   "": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to the\neligibility of certain participants in the New York city employees' retirement\nsystem to opt into the twenty-five year retirement program for EMT members",
    "basePrintNo": "S6976",
    "basePrintNoStr": "S6976-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 17,
       "fullName": "Iwen Chu",
       "imgName": "1331_Iwen_Chu.jpg",
