    "actClause": "AN ACT to amend the public health law, in relation to adding a representative\nof freestanding ambulatory surgery centers to the public health and health\nplanning council",
    "basePrintNo": "S6086",
    "basePrintNoStr": "S6086-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Jake Ashby",
       "imgName": "971_Jake_Ashby.jpg",
       "incumbent": true,
       "memberId": 1522,
       "sessionMemberId": 1885,
       "sessionYear": 2023,
       "shortName": "ASHBY"
      }
     ],
     "size": 1
