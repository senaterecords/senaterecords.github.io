   "": {
    "actClause": "AN ACT to amend chapter 109 of the laws of 2018 amending the general business\nlaw relating to certain rental vehicle protections, in relation to the\neffectiveness thereof",
    "basePrintNo": "S7059",
    "basePrintNoStr": "S7059-2023",
    "coSponsors": {
