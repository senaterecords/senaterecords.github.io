   "": {
    "actClause": "AN ACT to amend the correction law, in relation to establishing a program to\npurchase fresh produce from farms in the state for incarcerated individuals",
    "basePrintNo": "S6810",
    "basePrintNoStr": "S6810-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 57,
       "fullName": "George Borrello",
       "imgName": "57_george_borrello.jpg",
       "incumbent": true,
       "memberId": 1370,
       "sessionMemberId": 2006,
       "sessionYear": 2023,
       "shortName": "BORRELLO"
      }
     ],
     "size": 1
