   "": {
    "actClause": "AN ACT to amend the public health law, in relation to establishing an advanced\nresidential health care for aging adults with medical fragility demonstration\nprogram",
    "basePrintNo": "S9519",
    "basePrintNoStr": "S9519-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
