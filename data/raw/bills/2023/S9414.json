   "": {
    "actClause": "AN ACT to amend chapter 84 of the laws of 1993, amending the private housing\nfinance law relating to establishment of initial rents in housing\naccommodations rehabilitated with loans to housing development companies, in\nrelation to extending the effectiveness thereof",
    "basePrintNo": "S9414",
    "basePrintNoStr": "S9414-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 31,
       "fullName": "Robert Jackson",
       "imgName": "1050_Robert_Jackson.jpg",
       "incumbent": true,
       "memberId": 1230,
       "sessionMemberId": 2017,
       "sessionYear": 2023,
       "shortName": "JACKSON"
      }
     ],
     "size": 1
