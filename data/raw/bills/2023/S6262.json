   "": {
    "actClause": "AN ACT to amend chapter 493 of the laws of 1987 creating the Ocean Beach\nVolunteer and Exempt Firefighters' Benevolent Association, Incorporated and\nproviding for its powers and duties, in relation to its purpose and the use of\nforeign fire insurance premium taxes",
    "basePrintNo": "S6262",
    "basePrintNoStr": "S6262-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
