   "A": {
    "actClause": "AN ACT to amend the administrative code of the city of New York, in relation\nto requiring certain for-hire vehicles to install and maintain an interior\nrear-facing video camera",
    "basePrintNo": "S2379",
    "basePrintNoStr": "S2379-2023",
