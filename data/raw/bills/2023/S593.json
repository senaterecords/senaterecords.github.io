    "actClause": "AN ACT to amend the mental hygiene law, in relation to Down syndrome diagnosis\nawareness",
    "basePrintNo": "S593",
    "basePrintNoStr": "S593-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
