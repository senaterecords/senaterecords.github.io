 "substitutedBy": null,
 "summary": "Relates to establishing a twenty year retirement plan for members or officers of law enforcement; includes every non-seasonally appointed sworn member or officer of the division of law enforcement in the department of environmental conservation, a forest ranger in the service of the department of environmental conservation, a police officer in the department of environmental conservation, the regional state park police, and university police officers in such twenty year plan.",
 "title": "Establishes a twenty year retirement plan for members or officers of law enforcement",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A8918",
     "basePrintNoStr": "A8918-2023",
     "printNo": "A8918",
     "session": 2023,
     "version": ""
    },
    "billPage": 0,
    "chapter": 0,
    "lineEnd": 0,
    "lineStart": 0,
    "memoText": " \n                          VETO MESSAGE - No. 16\n \nTO THE ASSEMBLY:\n \nI am returning herewith, without my approval, the following bill:\n \nAssembly Bill Number 8918-A, entitled:\n \n    \"AN ACT to amend the retirement and social security law, in relation\n      to establishing a twenty year retirement plan for members or offi-\n      cers of law enforcement\"\n \n    NOT APPROVED\n \n  This  bill has been vetoed four times over the past five years because\nthis pension enhancement would impose substantial  unbudgeted  costs  on\nthe  State.  The  State  would be required to pay a past service cost of\n$66.7 million and the annual employer  contribution  would  increase  by\n$6.0 million.\n \n  The bill is disapproved.                       (signed) KATHY HOCHUL\n \n                               __________\n",
    "signedDate": null,
    "signer": "KATHY HOCHUL",
    "vetoNumber": 16,
    "vetoType": "STANDARD",
    "year": 2024
   }
  ],
