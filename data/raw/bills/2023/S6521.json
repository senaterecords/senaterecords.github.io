 "approvalMessage": {
  "approvalNumber": 89,
  "billId": {
   "basePrintNo": "S6521",
   "basePrintNoStr": "S6521-2023",
   "printNo": "S6521",
   "session": 2023,
   "version": ""
  },
  "chapter": 769,
  "signer": "KATHY HOCHUL",
  "text": " \n                APPROVAL MEMORANDUM - No. 89 Chapter 769\n \n        MEMORANDUM filed with Senate Bill Number 6521, entitled:\n \n    \"AN  ACT  to  amend  the public health law, in relation to the adult\n        cystic fibrosis assistance program\"\n \n    APPROVED\n \n  This  bill  would  establish  the  adult  cystic  fibrosis  assistance\nprogram,  which  would  reimburse  the  cost of providing health care or\nhealth insurance to eligible individuals with cystic fibrosis.\n \n  I fully support the goals of this bill, which aims to support individ-\nuals with cystic fibrosis, a rare genetic disease that damages the lungs\nand digestive system. Many individuals  with  cystic  fibrosis  rely  on\nseveral  prescription  drugs  and  specific  care plans as part of their\ntreatment, which can lead to out of pocket costs for  the  consumer.  As\ndrafted,  this  bill  did not recognize the current criteria under which\nthe program is run, so technical changes were necessary  to  bring  this\nbill in line with the program's current criteria and conditions.\n \n  I have reached an agreement with the Legislature to enact these chang-\nes.  On the basis of this agreement, I am pleased to sign this bill.\n \n  This bill is approved.                         (signed) KATHY HOCHUL\n \n                                ______\n",
  "year": 2023
 },
