   "": {
    "actClause": "AN ACT to amend the arts and cultural affairs law, in relation to requiring\nthe council on the arts to have members from each of the ten regions of the\nstate",
    "basePrintNo": "S7296",
    "basePrintNoStr": "S7296-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "Robert Rolison",
       "imgName": "1336_Robert_Rolison.jpg",
       "incumbent": true,
       "memberId": 1519,
       "sessionMemberId": 1882,
       "sessionYear": 2023,
       "shortName": "ROLISON"
      }
     ],
     "size": 1
