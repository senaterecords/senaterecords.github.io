   "": {
    "actClause": "AN ACT to amend the arts and cultural affairs law, in relation to establishing\nthe New York state museum partnership trust",
    "basePrintNo": "S8491",
    "basePrintNoStr": "S8491-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
