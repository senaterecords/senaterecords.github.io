   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the expiration of the\nauthorization for the county of Seneca to impose an additional one percent\nsales and compensating use tax",
    "basePrintNo": "S4975",
    "basePrintNoStr": "S4975-2023",
