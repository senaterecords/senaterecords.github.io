   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to enacting \"the\nplanned offshore wind transmission act\"",
    "basePrintNo": "S6218",
    "basePrintNoStr": "S6218-2023",
    "coSponsors": {
