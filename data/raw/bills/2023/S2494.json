   "": {
    "actClause": "AN ACT to amend the mental hygiene law, in relation to the term limit of\nmembers of the autism spectrum disorders advisory board",
    "basePrintNo": "S2494",
    "basePrintNoStr": "S2494-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
       "imgName": "888_leroy_comrie.jpg",
       "incumbent": true,
       "memberId": 888,
       "sessionMemberId": 2008,
       "sessionYear": 2023,
       "shortName": "COMRIE"
      }
     ],
     "size": 1
