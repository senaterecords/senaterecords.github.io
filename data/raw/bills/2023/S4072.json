   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the authorization\ngranted to the county of Essex to impose an additional one percent of sales\nand compensating use taxes",
    "basePrintNo": "S4072",
    "basePrintNoStr": "S4072-2023",
    "coSponsors": {
