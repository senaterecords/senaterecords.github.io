   "": {
    "actClause": "AN ACT to amend the general business law, in relation to requiring a notice to\nbe posted regarding skimming",
    "basePrintNo": "S6088",
    "basePrintNoStr": "S6088-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Jake Ashby",
       "imgName": "971_Jake_Ashby.jpg",
       "incumbent": true,
       "memberId": 1522,
       "sessionMemberId": 1885,
       "sessionYear": 2023,
       "shortName": "ASHBY"
      }
     ],
     "size": 1
