   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to the\nregulation of toxic substances in playground surfacing materials",
    "basePrintNo": "S8932",
    "basePrintNoStr": "S8932-2023",
    "coSponsors": {
