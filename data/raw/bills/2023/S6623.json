    "actClause": "AN ACT to amend chapter 154 of the laws of 1921, relating to the port\nauthority of New York and New Jersey, in relation to military leave for all\nrepresented and non-represented persons employed by the port authority of New\nYork and New Jersey",
    "basePrintNo": "S6623",
    "basePrintNoStr": "S6623-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
       "incumbent": true,
       "memberId": 384,
       "sessionMemberId": 2004,
       "sessionYear": 2023,
       "shortName": "ADDABBO"
