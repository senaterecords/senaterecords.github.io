   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to insurance for victims of a\nhate crime; and to repeal certain provisions of such law relating thereto",
    "basePrintNo": "S2231",
    "basePrintNoStr": "S2231-2023",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
