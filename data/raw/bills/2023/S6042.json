    "actClause": "AN ACT to amend the mental hygiene law, in relation to the establishment of\ncommunity housing waiting lists for adults within the office of mental health\nservice system",
    "basePrintNo": "S6042",
    "basePrintNoStr": "S6042-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
