   "": {
    "actClause": "AN ACT to amend the penal law and the civil rights law, in relation to\nunlawful dissemination or publication of intimate images created by\ndigitization and of sexually explicit depictions of an individual; and to\nrepeal certain provisions of the penal law relating thereto",
    "basePrintNo": "S1042",
    "basePrintNoStr": "S1042-2023",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
