   "": {
    "actClause": "AN ACT to authorize the payment of ordinary disability retirement benefits by the New York state teachers' retirement system to the widow of Lawrence L. Allen",
    "basePrintNo": "S5324",
    "basePrintNoStr": "S5324-2017",
    "coSponsors": {
     "items": [],
     "size": 0
