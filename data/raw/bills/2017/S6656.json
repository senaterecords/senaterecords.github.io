    "actClause": "AN ACT to amend the public health law, in relation to clarifying that the nurse-family partnership program is not home care",
    "basePrintNo": "S6656",
    "basePrintNoStr": "S6656-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
