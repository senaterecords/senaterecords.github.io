 "summary": "Relates to the payment of certain fines and mandatory surcharges; prioritizes payment of certain fines over payment of certain surcharges.",
 "title": "Relates to the payment of certain fines and mandatory surcharges",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "S6684",
