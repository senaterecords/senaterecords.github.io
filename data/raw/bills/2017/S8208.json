 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to authorize the city of Cohoes, in the county of Albany, to offer\ncertain retirement options to police officer Jeffrey Bressette",
    "basePrintNo": "S8208",
    "basePrintNoStr": "S8208-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "",
    "lawSection": "Retirement",
    "memo": "\n \nBILL NUMBER: S8208\n\nSPONSOR: BRESLIN\n \nTITLE OF BILL:  An act to authorize the city of Cohoes, in the county\nof Albany, to offer certain retirement options to police officer Jeffrey\nBressette\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\n \nSUMMARY OF SPECIFIC PROVISIONS:\n\nSection 1 allows the City of Cohoes\n\nSection 2 provides that past service costs will be borne by the City of\nCohoes Section 3 provides for an immediate effective date.\n\n \nJUSTIFICATION:\n\nOfficer Jeffrey Bressette seeks to participate in the optional retire-\nment plan available pursuant to section 384-d of the retirement and\nsocial security law. Officer Bressette, through no fault of his own, was\nunable to make a timely application for the optional plan.  This bill\nseeks to remedy this issue by allowing the City of Cohoes to file a\nresolution with State Comptroller to certify eligibility.\n\n \nPRIOR LEGISLATIVE HISTORY:\n\nNew Bill\n\n \nFISCAL IMPLICATIONS:\n\nNone to the State.\n\n \nEFFECTIVE DATE:\nThis act shall take effect immediately.\n",
