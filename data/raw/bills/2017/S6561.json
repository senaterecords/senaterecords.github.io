    "actClause": "AN ACT in relation to terms and conditions of employment of certain nonjudicial officers and employees of the unified court system",
    "basePrintNo": "S6561",
    "basePrintNoStr": "S6561-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 22,
       "fullName": "Martin J. Golden",
       "imgName": "422_martin_j._golden.jpg",
       "incumbent": false,
       "memberId": 422,
