    "actClause": "AN ACT to amend the state finance law, in relation to establishing the board of regents institutional accreditation account to provide the framework for the state education department to spend monies received and/or revenues generated for institutional accreditation purposes; and to amend the education law, in relation to services and functions relating to institutional accreditation",
    "basePrintNo": "S6780",
    "basePrintNoStr": "S6780-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
