   "": {
    "actClause": "AN ACT to amend the judiciary law, in relation to establishing a lawyer referral service - client privilege",
    "basePrintNo": "S5845",
    "basePrintNoStr": "S5845-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
