       "sessionYear": 2017,
       "shortName": "HAMILTON"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 32,
       "fullName": "Luis R. Sepúlveda",
       "imgName": "493_Luis_Sepulveda.jpg",
       "incumbent": true,
       "memberId": 1142,
