   "": {
    "actClause": "AN ACT to amend the executive law, in relation to solicitation used by or on behalf of any charitable organization",
    "basePrintNo": "S3780",
    "basePrintNoStr": "S3780-2017",
    "coSponsors": {
     "items": [],
     "size": 0
