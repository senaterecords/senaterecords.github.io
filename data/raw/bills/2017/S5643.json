   "A": {
    "actClause": "AN ACT to amend the public health law, in relation to directing the\ncommissioner of health, in consultation with the commissioner of\ntransportation and the New York state emergency medical services council, to\nestablish rules and regulations for ambulances",
    "basePrintNo": "S5643",
    "basePrintNoStr": "S5643-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
