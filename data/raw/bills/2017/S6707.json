   "": {
    "actClause": "AN ACT to amend the New York state urban development corporation act, in relation to assistance for certain small businesses",
    "basePrintNo": "S6707",
    "basePrintNoStr": "S6707-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 13,
       "fullName": "José Peralta",
       "imgName": "428_jose_peralta.jpg",
       "incumbent": false,
       "memberId": 428,
       "sessionMemberId": 930,
       "sessionYear": 2017,
       "shortName": "PERALTA"
      }
     ],
     "size": 1
