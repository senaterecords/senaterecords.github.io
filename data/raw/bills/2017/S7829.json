   "A": {
    "actClause": "AN ACT directing the department of transportation to study the weight\nlimitations for fire vehicles with pneumatic tires",
    "basePrintNo": "S7829",
    "basePrintNoStr": "S7829-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
