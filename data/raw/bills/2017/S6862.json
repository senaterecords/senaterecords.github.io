   "A": {
    "actClause": "AN ACT to amend the public service law, in relation to requiring the public\nservice commission retain an independent auditor to conduct audits of private\nwater utility companies prior to and after rate changes are approved by the\npublic service commission",
    "basePrintNo": "S6862",
    "basePrintNoStr": "S6862-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
