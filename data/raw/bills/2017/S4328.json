   "A": {
    "actClause": "AN ACT to amend the administrative code of the city of New York and chapter\n542 of the laws of 2007, amending the administrative code of the city of New\nYork and the education law relating to filings by persons who have negligently\nor knowingly made false statements in documents submitted to the department of\nbuildings of the city of New York, in relation to false statements made to the\ndepartment of buildings of the city of New York",
    "basePrintNo": "S4328",
    "basePrintNoStr": "S4328-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 61,
       "fullName": "Michael H. Ranzenhofer",
