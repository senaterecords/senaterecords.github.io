 "substitutedBy": null,
 "summary": "Authorizes and directs the New York state department of health, to conduct a study on the high incidence of asthma in the borough of Manhattan in the city of New York and to prepare a remedial plan.",
 "title": "Authorizes a study on the high incidence of asthma in the borough of Manhattan in the city of New York and to prepare a remedial plan",
 "vetoMessages": {
  "items": [
   {
    "billId": {
