   "": {
    "actClause": "AN ACT to amend the public health law, in relation to including information on pediatric acute-onset neuropsychiatric syndrome in the health care and wellness education and outreach program",
    "basePrintNo": "S5750",
    "basePrintNoStr": "S5750-2017",
    "coSponsors": {
