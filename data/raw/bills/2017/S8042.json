 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT in relation to authorizing Family Service League, Inc., to file an\napplication for exemption from real property taxes for certain assessment\nrolls",
    "basePrintNo": "S8042",
    "basePrintNoStr": "S8042-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "",
    "lawSection": "Real Property Taxation",
    "memo": "\n \nBILL NUMBER: S8042\n\nSPONSOR: BOYLE\n \nTITLE OF BILL:\n\nAn act in relation to authorizing Family Service League, Inc., to file\nan application for exemption from real property taxes for certain\nassessment rolls\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\nTo authorize the assessor of the town of Islip to accept from the Family\nService League, Inc., an application for exemption from real property\ntaxes for the 2015-16 assessment roll.\n\n \nSUMMARY OF PROVISIONS:\n\nSection 1 of this bill authorizes the Town of Islip, in Suffolk county,\nto accept from the Family Service League, Inc., a non-for-profit corpo-\nration, an application for an exemption from real property taxes for the\nparcels owned by such non-for-profit corporation located at 0 5th Avenue\nand 1462 5th Avenue in the town of Islip, county of Suffolk.\n\nIf accepted, the application shall be reviewed as if it had been\nreceived on or before the taxable status date established for such\nassessment rolls. The county of Suffolk may, in their sole discretion,\nshall for the refund of the taxes paid by Family Service League, Inc.,\nalong with any fines or penalties paid, and cancel taxes remaining\nunpaid.\n\nSection 2. Effective Date.\n\n \nJUSTIFICATION:\n\nExisting Law authorizes tax exemptions to be granted after the taxable\nstatus date has passed if a bill is chaptered authorizing an assessor to\naccept a late application.\n\n \nPRIOR LEGISLATIVE HISTORY:\n\nThis is a new bill.\n\n \nFISCAL IMPLICATIONS FOR STATE AND LOCAL GOVERNMENTS:\n\nNone to the state.\n\n \nEFFECTIVE DATE:\nThis act shall take effect immediately.\n",
