   "": {
    "actClause": "AN ACT to amend the mental hygiene law, in relation to requiring certain persons providing substance abuse treatment on counseling to complete training in medication assisted treatment",
    "basePrintNo": "S981",
    "basePrintNoStr": "S981-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Fredrick J. Akshar II",
       "imgName": "735_Fredrick_Akshar.jpg",
       "incumbent": false,
       "memberId": 913,
       "sessionMemberId": 952,
       "sessionYear": 2017,
       "shortName": "AKSHAR"
      }
     ],
     "size": 1
