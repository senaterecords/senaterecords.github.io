   "A": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to providing a safe harbor exemption to commercial fishing vessels in certain emergency situations",
    "basePrintNo": "S4051",
    "basePrintNoStr": "S4051-2017",
