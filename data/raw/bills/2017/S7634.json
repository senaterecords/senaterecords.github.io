   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to licensing requirements for\ninsurance agents",
    "basePrintNo": "S7634",
    "basePrintNoStr": "S7634-2017",
    "coSponsors": {
     "items": [],
     "size": 0
