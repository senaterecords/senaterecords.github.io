 "substitutedBy": null,
 "summary": "Requires the conducting of public hearings and reports thereon prior to the closure to public access of any real property by the office of parks, recreation and historic preservation.",
 "title": "Requires the conducting of public hearings and reports thereon prior to the closure of any real property by the office of parks, recreation and historic preservation",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A2835",
     "basePrintNoStr": "A2835-2017",
     "printNo": "A2835",
     "session": 2017,
     "version": ""
