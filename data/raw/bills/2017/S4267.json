   "": {
    "actClause": "AN ACT to amend the state finance law and the general municipal law, in relation to payment in construction contracts",
    "basePrintNo": "S4267",
    "basePrintNoStr": "S4267-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 57,
       "fullName": "Catharine Young",
       "imgName": "414_catharine_young.jpg",
       "incumbent": false,
       "memberId": 414,
       "sessionMemberId": 942,
       "sessionYear": 2017,
       "shortName": "YOUNG"
      }
     ],
     "size": 1
