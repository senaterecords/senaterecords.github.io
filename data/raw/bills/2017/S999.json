   "": {
    "actClause": "AN ACT to amend the racing, pari-mutuel wagering and breeding law, in relation to New York bred and/or wholly owned harness races",
    "basePrintNo": "S999",
    "basePrintNoStr": "S999-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
       "memberId": 435,
       "sessionMemberId": 940,
       "sessionYear": 2017,
       "shortName": "MARCHIONE"
      }
     ],
     "size": 1
