   "A": {
    "actClause": "AN ACT to amend the education law, in relation to requiring immediate\nnotification by law enforcement of the filing of an accusatory instrument\nalleging a sex offense by an employee",
    "basePrintNo": "S6597",
    "basePrintNoStr": "S6597-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
