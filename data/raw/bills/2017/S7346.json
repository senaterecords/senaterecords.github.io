   "A": {
    "actClause": "AN ACT to amend the real property tax law, in relation to authorizing the city\nof Buffalo to add unpaid housing code violation penalties, costs and fines to\nthe city's annual tax levy in accordance with applicable law",
    "basePrintNo": "S7346",
    "basePrintNoStr": "S7346-2017",
    "coSponsors": {
