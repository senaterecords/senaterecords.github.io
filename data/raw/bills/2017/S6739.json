    "actClause": "AN ACT to amend the executive law, in relation to the transmission of reports of missing persons to the National Missing and Unidentified Persons System",
    "basePrintNo": "S6739",
    "basePrintNoStr": "S6739-2017",
    "coSponsors": {
     "items": [],
