    "actClause": "AN ACT to amend the agriculture and markets law, in relation to enacting the\n\"surplus food to charitable organizations act\"",
    "basePrintNo": "S7348",
    "basePrintNoStr": "S7348-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
