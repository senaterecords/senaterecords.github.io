   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to commercial fishing licenses",
    "basePrintNo": "S5747",
    "basePrintNoStr": "S5747-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
