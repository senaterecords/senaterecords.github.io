    "actClause": "AN ACT to amend the education law, in relation to continuing the early college high school program and the pathways in technology early college high school program in this state",
    "basePrintNo": "S6087",
    "basePrintNoStr": "S6087-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 46,
       "fullName": "George Amedore",
       "imgName": "892_george_amedore.jpg",
       "incumbent": false,
