    "actClause": "AN ACT to amend the public health law, in relation to electronic health records",
    "basePrintNo": "S2248",
    "basePrintNoStr": "S2248-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 54,
       "fullName": "Pamela Helming",
       "imgName": "773_Pamela_Helming.jpg",
