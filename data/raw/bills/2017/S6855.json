   "": {
    "actClause": "AN ACT to amend the New York state urban development corporation act and the economic development law, in relation to the creation of micro-business worker cooperatives upon transfer of ownership",
    "basePrintNo": "S6855",
    "basePrintNoStr": "S6855-2017",
