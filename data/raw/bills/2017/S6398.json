    "actClause": "AN ACT to amend the general municipal law, in relation to granting sick leave for officers and employees with a qualifying World Trade Center condition",
    "basePrintNo": "S6398",
    "basePrintNoStr": "S6398-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 9,
       "fullName": "Todd Kaminsky",
       "imgName": "903_todd_kaminsky.jpg",
       "incumbent": false,
       "memberId": 918,
       "sessionMemberId": 918,
       "sessionYear": 2017,
       "shortName": "KAMINSKY"
