   "A": {
    "actClause": "AN ACT to amend the insurance law, in relation to annuity dividend reinvestment",
    "basePrintNo": "S2525",
    "basePrintNoStr": "S2525-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
