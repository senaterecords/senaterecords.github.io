   "A": {
    "actClause": "AN ACT to amend chapter 274 of the laws of 2010 amending the environmental\nconservation law relating to repair of damaged pesticide containers, in\nrelation to making the provisions of such chapter permanent",
    "basePrintNo": "S7747",
