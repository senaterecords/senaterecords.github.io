    "actClause": "AN ACT to amend the agriculture and markets law and the public lands law, in relation to access to viable agricultural land for new and beginning farmers",
    "basePrintNo": "S4900",
    "basePrintNoStr": "S4900-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
       "memberId": 435,
       "sessionMemberId": 940,
       "sessionYear": 2017,
       "shortName": "MARCHIONE"
      }
     ],
     "size": 1
