    "actClause": "AN ACT in relation to approving a certain agreement for a payment in lieu of taxes",
    "basePrintNo": "S6411",
    "basePrintNoStr": "S6411-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
