   "": {
    "actClause": "AN ACT to amend the education law, in relation to reimbursement methodologies for tuition",
    "basePrintNo": "S4530",
    "basePrintNoStr": "S4530-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 1,
       "fullName": "Kenneth P. LaValle",
       "imgName": "419_kenneth_p._lavalle.jpg",
