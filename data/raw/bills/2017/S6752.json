   "": {
    "actClause": "AN ACT to amend the village law and the public officers law, in relation to authorizing the village of Mannsville to hire a village clerk who is not a resident of such village",
    "basePrintNo": "S6752",
    "basePrintNoStr": "S6752-2017",
    "coSponsors": {
