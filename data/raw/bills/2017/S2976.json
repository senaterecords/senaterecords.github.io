   "": {
    "actClause": "AN ACT to amend the election law, in relation to military ballots and elections for school boards of education and school budgets",
    "basePrintNo": "S2976",
    "basePrintNoStr": "S2976-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 11,
       "fullName": "Tony Avella",
       "imgName": "391_tony_avella.jpg",
       "incumbent": false,
       "memberId": 391,
       "sessionMemberId": 920,
       "sessionYear": 2017,
       "shortName": "AVELLA"
      }
