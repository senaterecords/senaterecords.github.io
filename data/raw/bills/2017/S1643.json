 "approvalMessage": {
  "approvalNumber": 38,
  "billId": {
   "basePrintNo": "S1643",
   "basePrintNoStr": "S1643-2017",
   "printNo": "S1643",
   "session": 2017,
   "version": ""
  },
  "chapter": 462,
  "signer": "ANDREW M. CUOMO",
  "text": "\n \n                APPROVAL MEMORANDUM - No. 38 Chapter 462\n \n        MEMORANDUM filed with Senate Bill Number 1643, entitled:\n \n    \"AN ACT to amend the state administrative procedure act, in relation\n        to  providing information on the prevention of common regulatory\n        violations in small business regulation guides\"\n \n    APPROVED\n \n  As part of  the  State  Administrative  Procedure  Act,  agencies  are\nrequired  to  produce  small  business  regulation  guides to facilitate\ncompliance and help small businesses avoid violations. This  bill  would\nrequire  the  State's Department of Economic Development to serve as the\ncentral repository for collecting and compiling  such  information,  and\nthen make it available for public use.\n \n  Small  businesses  are  a  vital  part of the State's economy and I am\ncommitted to helping them successfully navigate the  State's  compliance\nregulations. As originally drafted, however, there are certain technical\nand administrative concerns that would make the bill difficult to imple-\nment effectively. The Executive has secured an agreement with the Legis-\nlature  to  pass  legislation  in  the upcoming session to address these\nconcerns. On that basis, I am signing this bill.\n \n  This bill is approved.                      (signed) ANDREW M. CUOMO\n \n                                ______\n",
  "year": 2017
 },
