   "": {
    "actClause": "AN ACT to amend the public health law, in relation to requiring that a hospice program providing hospice care in a patient's home shall comply with the home care services worker registry",
    "basePrintNo": "S6347",
    "basePrintNoStr": "S6347-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
