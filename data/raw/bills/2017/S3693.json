   "": {
    "actClause": "AN ACT to authorize Marie E. Abraham to take the competitive civil service examination and be placed on the eligible list for appointment as a full-time police officer for the City of Mechanicville, County of Saratoga",
    "basePrintNo": "S3693",
    "basePrintNoStr": "S3693-2017",
    "coSponsors": {
