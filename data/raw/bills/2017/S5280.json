   "": {
    "actClause": "AN ACT in relation to a certain agreement for a payment in lieu of taxes",
    "basePrintNo": "S5280",
    "basePrintNoStr": "S5280-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 4,
       "fullName": "Phil Boyle",
       "imgName": "433_phil_boyle.jpg",
       "incumbent": false,
       "memberId": 433,
       "sessionMemberId": 944,
       "sessionYear": 2017,
       "shortName": "BOYLE"
      }
     ],
     "size": 1
