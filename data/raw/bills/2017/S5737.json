    "actClause": "AN ACT to amend the judiciary law, in relation to publication of official reports",
    "basePrintNo": "S5737",
    "basePrintNoStr": "S5737-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
