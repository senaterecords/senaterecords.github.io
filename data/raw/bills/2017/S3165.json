   "B": {
    "actClause": "AN ACT to amend the executive law and the general municipal law, in relation to requiring certain police officers to be re-trained in cardiopulmonary resuscitation every two years",
    "basePrintNo": "S3165",
    "basePrintNoStr": "S3165-2017",
