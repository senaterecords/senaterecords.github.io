    "actClause": "AN ACT to amend the public health law, in relation to prohibiting e-cigarettes on school grounds",
    "basePrintNo": "S750",
    "basePrintNoStr": "S750-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Fredrick J. Akshar II",
       "imgName": "735_Fredrick_Akshar.jpg",
       "incumbent": false,
       "memberId": 913,
       "sessionMemberId": 952,
