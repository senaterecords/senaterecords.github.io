   "": {
    "actClause": "AN ACT to amend chapter 329 of the laws of 2009, amending the family court act and the social services law, relating to removing special powers granted to the society for the prevention of cruelty to children, in relation to the effectiveness of the provisions thereof",
    "basePrintNo": "S6447",
    "basePrintNoStr": "S6447-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
       "imgName": "370_david_carlucci.jpg",
