   "": {
    "actClause": "AN ACT to amend the tax law, in relation to excluding from federal adjusted gross income the amount of any money or the value of medals awarded to olympians earning a maximum of three hundred thousand dollars annually",
    "basePrintNo": "S5243",
    "basePrintNoStr": "S5243-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
       "memberId": 435,
       "sessionMemberId": 940,
       "sessionYear": 2017,
       "shortName": "MARCHIONE"
      }
     ],
     "size": 1
