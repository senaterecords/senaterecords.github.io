 "substitutedBy": null,
 "summary": "Expands payments for reserved bed days in residential health care facilities; repeals provisions directing the commissioner of health to establish a prospective per diem adjustment for certain nursing homes so as to achieve a eighteen million dollar savings during each state fiscal year.",
 "title": "Expands payments for reserved bed days in residential health care facilities; repealer",
 "vetoMessages": {
  "items": [
