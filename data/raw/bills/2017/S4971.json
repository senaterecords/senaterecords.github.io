   "": {
    "actClause": "AN ACT to amend the education law and the public health law, in relation to a sepsis awareness, prevention and education program",
    "basePrintNo": "S4971",
    "basePrintNoStr": "S4971-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
