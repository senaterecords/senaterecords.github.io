   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to the display of amber and blue lights",
    "basePrintNo": "S5397",
    "basePrintNoStr": "S5397-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Fredrick J. Akshar II",
