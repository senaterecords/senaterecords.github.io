   "": {
    "actClause": "AN ACT to amend the state administrative procedure act, in relation to\nincreasing the revised rule public comment period from thirty days to\nforty-five days",
    "basePrintNo": "S6916",
    "basePrintNoStr": "S6916-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 7,
       "fullName": "Elaine Phillips",
       "imgName": "no_image.jpg",
       "incumbent": false,
       "memberId": 1100,
       "sessionMemberId": 1096,
       "sessionYear": 2017,
       "shortName": "PHILLIPS"
      }
     ],
     "size": 1
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
