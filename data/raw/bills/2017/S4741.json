    "actClause": "AN ACT to amend the public health law, in relation to establishing a rural health council",
    "basePrintNo": "S4741",
    "basePrintNoStr": "S4741-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
