   "": {
    "actClause": "AN ACT to grant Danielle Galasso a retroactive membership date in the New York state and local employees' retirement system",
    "basePrintNo": "S5743",
    "basePrintNoStr": "S5743-2017",
    "coSponsors": {
     "items": [],
     "size": 0
