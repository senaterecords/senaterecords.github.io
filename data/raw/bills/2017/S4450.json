   "": {
    "actClause": "AN ACT granting retroactive tier IV membership in the New York state and local employees' retirement system to Scott Goodfellow",
    "basePrintNo": "S4450",
    "basePrintNoStr": "S4450-2017",
    "coSponsors": {
