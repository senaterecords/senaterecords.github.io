    "actClause": "AN ACT to amend chapter 473 of the laws of 2010 amending the racing, pari-mutuel wagering and breeding law relating to the New York state thoroughbred breeding and development fund, in relation to the effectiveness thereof",
    "basePrintNo": "S3760",
    "basePrintNoStr": "S3760-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
       "memberId": 435,
       "sessionMemberId": 940,
       "sessionYear": 2017,
       "shortName": "MARCHIONE"
      }
     ],
     "size": 1
