   "": {
    "actClause": "AN ACT to amend the general municipal law, in relation to including lakes in adopt-a-municipal park, shoreline or roadway programs",
    "basePrintNo": "S2469",
    "basePrintNoStr": "S2469-2017",
    "coSponsors": {
