    "actClause": "AN ACT to amend the mental hygiene law, in relation to the geriatric service\ndemonstration program, to promote mental health and home care collaboration\nwithin the program",
    "basePrintNo": "S8632",
    "basePrintNoStr": "S8632-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 41,
       "fullName": "Susan Serino",
       "imgName": "890_susan_serino.jpg",
