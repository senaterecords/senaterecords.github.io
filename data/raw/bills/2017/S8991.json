   "": {
    "actClause": "AN ACT to amend the tax law and the administrative code of the city of New\nYork, in relation to the definitions of the terms \"CFC income\" and \"entire net\nincome\"",
    "basePrintNo": "S8991",
    "basePrintNoStr": "S8991-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
