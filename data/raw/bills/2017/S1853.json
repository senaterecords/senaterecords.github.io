 "approvalMessage": {
  "approvalNumber": 12,
  "billId": {
   "basePrintNo": "S1853",
   "basePrintNoStr": "S1853-2017",
   "printNo": "S1853",
   "session": 2017,
   "version": ""
  },
  "chapter": 405,
  "signer": "ANDREW M. CUOMO",
  "text": "\n \n                APPROVAL MEMORANDUM - No. 12 Chapter 405\n \n        MEMORANDUM filed with Senate Bill Number 1853, entitled:\n \n    \"AN  ACT  to  amend  the executive law and the not-for-profit corpo-\n        ration law, in relation to a public listing of certain  not-for-\n        profit corporations\"\n \n    APPROVED\n \n  This  bill  would  require the Department of State and the Division of\nMilitary and Naval Affairs to post a list of all approved not-for-profit\ncorporations soliciting funds for, or otherwise  benefiting,  the  armed\nforces of the United States.\n \n  I  fully  support  the intent of this bill. As drafted, however, there\nare certain technical concerns that would make it difficult to implement\neffectively. The Executive has secured an agreement with the Legislature\nto pass legislation in the upcoming session to address  these  concerns.\nOn that basis, I am signing this bill.\n \n  This bill is approved.                      (signed) ANDREW M. CUOMO\n \n                                ______\n",
  "year": 2017
 },
