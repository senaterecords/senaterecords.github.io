   "": {
    "actClause": "AN ACT to amend the general business law, in relation to articles of bedding",
    "basePrintNo": "S587",
    "basePrintNoStr": "S587-2017",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
