   "": {
    "actClause": "AN ACT to amend the education law, in relation to directing the commissioner of education to issue a guidance memorandum to every school district and board of cooperative educational services to inform them of the unique educational needs of students with dyslexia, dyscalculia and dysgraphia to issue a guidance memorandum to every school district and board of cooperative educational services to inform them of the unique educational needs of students with dyslexia, dyscalculia and dysgraphia",
    "basePrintNo": "S6581",
    "basePrintNoStr": "S6581-2017",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
