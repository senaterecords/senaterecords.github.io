   "": {
    "actClause": "AN ACT to amend the state law, in relation to designating \"Here Rests in Honored Glory\" the official state hymn of mourning in honor of all American veterans",
    "basePrintNo": "S6856",
    "basePrintNoStr": "S6856-2017",
