   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to mandatory testing in the event of a motor vehicle collision resulting in injury or death",
    "basePrintNo": "S5562",
    "basePrintNoStr": "S5562-2017",
    "coSponsors": {
     "items": [],
     "size": 0
