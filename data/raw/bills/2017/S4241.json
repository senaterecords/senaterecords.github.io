   "": {
    "actClause": "AN ACT to amend the financial services law, in relation to establishing protections from excessive hospital emergency charges",
    "basePrintNo": "S4241",
    "basePrintNoStr": "S4241-2017",
    "coSponsors": {
     "items": [],
