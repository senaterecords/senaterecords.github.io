   "": {
    "actClause": "AN ACT to amend the agriculture and markets law and the public health law, in\nrelation to the definitions of industrial hemp, concentrated cannabis, and\nmarihuana",
    "basePrintNo": "S8072",
    "basePrintNoStr": "S8072-2017",
