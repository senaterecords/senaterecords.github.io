   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to the posting of security by a person against whom certain criminal charges are pending",
    "basePrintNo": "S4796",
    "basePrintNoStr": "S4796-2017",
    "coSponsors": {
     "items": [],
     "size": 0
