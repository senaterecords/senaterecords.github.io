   "": {
    "actClause": "AN ACT to amend the social services law, in relation to the eligibility of disabled persons who are applicants for or recipients of medical assistance",
    "basePrintNo": "S4779",
    "basePrintNoStr": "S4779-2017",
    "coSponsors": {
