   "": {
    "actClause": "AN ACT to amend the public health law, in relation to organ donation\nregistration through a patient-facing portal; and to amend a chapter of the\nlaws of 2024 amending the public health law relating to allowing patients to\nregister in the \"donate life registry\" through their electronic health\nrecords, as proposed in legislative bills numbers S. 8456 and A. 7079, in\nrelation to the effectiveness thereof",
    "basePrintNo": "S814",
    "basePrintNoStr": "S814-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 2369,
       "sessionYear": 2025,
       "shortName": "WEBB"
      }
     ],
     "size": 1
