   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to types of New\nYork grown, produced or harvested milk products included in the definition of\nsurplus agricultural products for the purposes of the Nourish New York program",
    "basePrintNo": "S795",
    "basePrintNoStr": "S795-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 57,
       "fullName": "George Borrello",
       "imgName": "57_george_borrello.jpg",
       "incumbent": true,
       "memberId": 1370,
       "sessionMemberId": 2374,
       "sessionYear": 2025,
       "shortName": "BORRELLO"
