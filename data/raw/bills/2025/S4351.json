   "": {
    "actClause": "AN ACT to amend the elder law, in relation to publishing a guide to actions\nwhen someone close dies",
    "basePrintNo": "S4351",
    "basePrintNoStr": "S4351-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "Robert Rolison",
