   "A": {
    "actClause": "AN ACT to amend the New York city health and hospitals corporation act, in\nrelation to requiring compliance with the city's uniform land use review\nprocedure",
    "basePrintNo": "S6685",
    "basePrintNoStr": "S6685-2025",
    "coSponsors": {
