   "": {
    "actClause": "AN ACT to amend the tax law, in relation to hotel and motel taxes in Saratoga\ncounty and the city of Saratoga Springs",
    "basePrintNo": "S6998",
    "basePrintNoStr": "S6998-2025",
    "coSponsors": {
