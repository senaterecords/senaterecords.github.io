   "": {
    "actClause": "AN ACT in relation to establishing a comprehensive study examining highway\nsafety standards and necessary worker protection improvements",
    "basePrintNo": "S9056",
    "basePrintNoStr": "S9056-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 40,
       "fullName": "Pete Harckham",
       "imgName": "1053_Pete_Harckham.jpg",
       "incumbent": true,
       "memberId": 1233,
       "sessionMemberId": 2357,
       "sessionYear": 2025,
       "shortName": "HARCKHAM"
