   "": {
    "actClause": "AN ACT to amend the real property tax law, in relation to a real property tax\nexemption for un-remarried spouses of volunteer firefighters or volunteer\nambulance workers killed in the line of duty",
    "basePrintNo": "S688",
    "basePrintNoStr": "S688-2025",
