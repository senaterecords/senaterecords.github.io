   "": {
    "actClause": "AN ACT to amend chapter 455 of the laws of 2011 amending the environmental\nconservation law relating to authorizing angling by a single individual with\nup to three lines in freshwater, in relation to the effectiveness thereof",
    "basePrintNo": "S983",
    "basePrintNoStr": "S983-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 58,
