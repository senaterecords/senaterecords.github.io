    "actClause": "AN ACT to amend the general business law, in relation to requiring comparison\nof prices charged by energy services companies",
    "basePrintNo": "S3876",
    "basePrintNoStr": "S3876-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 48,
       "fullName": "Rachel May",
       "imgName": "1057_Rachel_May.jpg",
       "incumbent": true,
       "memberId": 1237,
       "sessionMemberId": 2365,
       "sessionYear": 2025,
       "shortName": "MAY"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 2369,
       "sessionYear": 2025,
       "shortName": "WEBB"
      }
