    "actClause": "AN ACT to amend the abandoned property law, in relation to ensuring ESCOs are\nsubject to the same consumer protection regulations regarding unclaimed\ndeposits and refunds currently facing utility companies",
    "basePrintNo": "S7230",
    "basePrintNoStr": "S7230-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 5,
       "fullName": "Steve Rhoads",
       "imgName": "1333_Steve_Rhoads.jpg",
       "incumbent": true,
       "memberId": 1516,
       "sessionMemberId": 2322,
       "sessionYear": 2025,
       "shortName": "RHOADS"
      }
