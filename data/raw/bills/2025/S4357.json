   "": {
    "actClause": "AN ACT to amend the correction law, in relation to providing vocational\ntraining to incarcerated individuals on the installation of solar hot water\nsystems for the provision of hot water to correctional facilities",
    "basePrintNo": "S4357",
    "basePrintNoStr": "S4357-2025",
