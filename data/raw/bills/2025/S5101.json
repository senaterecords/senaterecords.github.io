   "": {
    "actClause": "AN ACT to amend the election law, in relation to early voting for certain\nspecial elections; and providing for the repeal of such provisions upon\nexpiration thereof",
    "basePrintNo": "S5101",
    "basePrintNoStr": "S5101-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 2369,
       "sessionYear": 2025,
