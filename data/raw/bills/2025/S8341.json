   "A": {
    "actClause": "AN ACT to amend the education law, in relation to establishing a temporary\npractice authorization program for certain medical professionals to practice\nin underserved areas; and providing for the repeal of such provisions upon\nexpiration thereof",
    "basePrintNo": "S8341",
    "basePrintNoStr": "S8341-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
