   "A": {
    "actClause": "AN ACT to amend the public service law, in relation to electric vehicle\ncharging station fee transparency",
    "basePrintNo": "S7260",
    "basePrintNoStr": "S7260-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
