   "": {
    "actClause": "AN ACT to amend chapter 462 of the laws of 2015, amending the elder law\nrelating to long term care ombudsman access to assisted living facilities, in\nrelation to the effectiveness of certain provisions of such chapter",
    "basePrintNo": "S7737",
    "basePrintNoStr": "S7737-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "Robert Rolison",
       "imgName": "1336_Robert_Rolison.jpg",
