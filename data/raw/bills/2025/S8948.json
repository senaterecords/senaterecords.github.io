       "shortName": "ADDABBO"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 61,
       "fullName": "Jeremy Zellner",
       "imgName": "no_image.jpg",
       "incumbent": true,
       "memberId": 1575,
