   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to manufacturers\nproviding bicycles with electric assist and electric scooters with lights",
    "basePrintNo": "S8948",
    "basePrintNoStr": "S8948-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
