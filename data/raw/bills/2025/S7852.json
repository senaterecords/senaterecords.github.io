   "": {
    "actClause": "AN ACT to amend chapter 606 of the laws of 2006 amending the volunteer\nfirefighters' benefit law relating to creating a presumption relating to\ncertain lung disabilities incurred by volunteer firefighters, in relation to\nthe effectiveness of such chapter",
    "basePrintNo": "S7852",
    "basePrintNoStr": "S7852-2025",
