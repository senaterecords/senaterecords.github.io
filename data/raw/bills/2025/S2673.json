   "": {
    "actClause": "AN ACT to amend the correction law, in relation to clarifying that the\ndepartment of corrections is not required to obtain and input into its\nelectronic record-keeping applications any individual's otherwise uncollected\nformer legal name or any alias; and to amend a chapter of the laws of 2024\namending the correction law relating to requiring that websites providing\nincarcerated individual information be searchable by the incarcerated\nindividual's name, former name or alias, as proposed in legislative bills\nnumbers S. 4061-A and A. 4763-A, in relation to the effectiveness thereof",
    "basePrintNo": "S2673",
    "basePrintNoStr": "S2673-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
