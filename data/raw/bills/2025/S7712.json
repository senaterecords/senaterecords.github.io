   "": {
    "actClause": "AN ACT to amend the criminal procedure law, in relation to designating as\npeace officers dog control officers of the village of Holley",
    "basePrintNo": "S7712",
    "basePrintNoStr": "S7712-2025",
    "coSponsors": {
