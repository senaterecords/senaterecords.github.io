   "A": {
    "actClause": "AN ACT to amend chapter 322 of the laws of 2014 relating to joint bidding on\ncontracts for public work projects, in relation to extending the effectiveness\nthereof",
    "basePrintNo": "S10195",
    "basePrintNoStr": "S10195-2025",
