       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Julia Salazar",
       "imgName": "1047_Julia_Salazar.jpg",
       "incumbent": true,
       "memberId": 1227,
       "sessionMemberId": 2335,
       "sessionYear": 2025,
       "shortName": "SALAZAR"
      }
