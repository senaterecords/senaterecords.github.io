   "": {
    "actClause": "AN ACT to authorize the granting of retirement service credit in the optional\ntwenty year retirement plan to Duane A. Palma for service as a correction\nofficer",
    "basePrintNo": "S7054",
    "basePrintNoStr": "S7054-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 55,
       "fullName": "Samra Brouk",
       "imgName": "1317_Samra_Brouk.jpg",
       "incumbent": true,
       "memberId": 1500,
       "sessionMemberId": 2372,
       "sessionYear": 2025,
       "shortName": "BROUK"
