   "": {
    "actClause": "AN ACT to amend the public health law, in relation to foreign adoptions",
    "basePrintNo": "S3765",
    "basePrintNoStr": "S3765-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 46,
       "fullName": "Patricia Fahy",
       "imgName": "657_patricia_fahy.jpg",
