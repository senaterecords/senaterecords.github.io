   "": {
    "actClause": "AN ACT in relation to authorizing the assessor of the town of Brookhaven,\ncounty of Suffolk, to accept an application for a real property tax exemption\nfrom Chabad at Stony Brook, Inc.",
    "basePrintNo": "S10012",
    "basePrintNoStr": "S10012-2025",
    "coSponsors": {
