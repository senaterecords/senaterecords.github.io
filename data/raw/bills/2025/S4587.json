   "": {
    "actClause": "AN ACT to amend the education law and the public health law, in relation to\nprescription labels for mifepristone and misoprostol",
    "basePrintNo": "S4587",
    "basePrintNoStr": "S4587-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 2369,
       "sessionYear": 2025,
       "shortName": "WEBB"
      }
