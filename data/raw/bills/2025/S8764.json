   "": {
    "actClause": "AN ACT to amend the public service law, in relation to consideration of\ncapital expenditures by a utility proposing a major change in rates",
    "basePrintNo": "S8764",
    "basePrintNoStr": "S8764-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
