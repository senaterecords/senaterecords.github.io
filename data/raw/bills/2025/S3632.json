      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Lea Webb",
       "imgName": "1332_Lea_Webb.jpg",
       "incumbent": true,
       "memberId": 1515,
       "sessionMemberId": 2369,
       "sessionYear": 2025,
       "shortName": "WEBB"
      }
     ],
     "size": 2
