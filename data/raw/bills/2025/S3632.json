    "actClause": "AN ACT to amend the mental hygiene law, in relation to establishing the\nproblem gambling advisory council",
    "basePrintNo": "S3632",
    "basePrintNoStr": "S3632-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
