   "": {
    "actClause": "AN ACT to amend the social services law, in relation to finger imaging for\nfood stamps recipients",
    "basePrintNo": "S7754",
    "basePrintNoStr": "S7754-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
