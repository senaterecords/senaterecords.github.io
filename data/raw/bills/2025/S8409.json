   "": {
    "actClause": "AN ACT to amend chapter 670 of the laws of 2022 amending the real property tax\nlaw relating to providing all local governments with the option to provide a\nproperty tax exemption to volunteer firefighters and volunteer ambulance\nworkers, in relation to the effectiveness thereof",
    "basePrintNo": "S8409",
    "basePrintNoStr": "S8409-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 5,
       "fullName": "Steve Rhoads",
       "imgName": "1333_Steve_Rhoads.jpg",
       "incumbent": true,
       "memberId": 1516,
       "sessionMemberId": 2322,
       "sessionYear": 2025,
       "shortName": "RHOADS"
      }
