   "": {
    "actClause": "AN ACT to amend the town law, in relation to authorizing the town of Copake to\nestablish community preservation funds; to amend the tax law, in relation to\nauthorizing the town of Copake to impose a real estate transfer tax with\nrevenues therefrom to be deposited in said community preservation fund; and\nproviding for the repeal of certain provisions of the tax law upon expiration\nthereof",
    "basePrintNo": "S6664",
    "basePrintNoStr": "S6664-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
