   "": {
    "actClause": "AN ACT to amend the correction law, in relation to requiring the department of\ncorrections and community supervision to establish discharge plans and reentry\nservices for wrongfully convicted individuals upon their discharge",
    "basePrintNo": "S5701",
    "basePrintNoStr": "S5701-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 36,
       "fullName": "Jamaal Bailey",
