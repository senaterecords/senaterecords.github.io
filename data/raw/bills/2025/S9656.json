   "": {
    "actClause": "AN ACT to amend the banking law, in relation to prohibiting fees for\nelectronic benefit transfer services",
    "basePrintNo": "S9656",
    "basePrintNoStr": "S9656-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
