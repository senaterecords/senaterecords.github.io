   "": {
    "actClause": "AN ACT to amend the penal law, in relation to the sale and possession of\nself-defense spray devices; and to repeal certain provisions of such law\nrelating thereto",
    "basePrintNo": "S4922",
    "basePrintNoStr": "S4922-2025",
    "coSponsors": {
     "items": [
