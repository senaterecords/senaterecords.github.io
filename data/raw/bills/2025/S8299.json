   "": {
    "actClause": "AN ACT to amend chapter 591 of the laws of 2001, amending the banking law\nrelating to limiting the check cashing exemption for national banks and other\nregulated entities, in relation to the effectiveness thereof",
    "basePrintNo": "S8299",
    "basePrintNoStr": "S8299-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
       "imgName": "888_leroy_comrie.jpg",
       "incumbent": true,
       "memberId": 888,
       "sessionMemberId": 2331,
       "sessionYear": 2025,
       "shortName": "COMRIE"
