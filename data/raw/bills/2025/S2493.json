    "actClause": "AN ACT to amend the environmental conservation law, in relation to the\ncommunity air monitoring program",
    "basePrintNo": "S2493",
    "basePrintNoStr": "S2493-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
