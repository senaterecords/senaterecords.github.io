   "": {
    "actClause": "AN ACT to amend the general business law, in relation to biometric privacy",
    "basePrintNo": "S1422",
    "basePrintNoStr": "S1422-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
