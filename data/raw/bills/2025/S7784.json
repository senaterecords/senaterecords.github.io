   "": {
    "actClause": "AN ACT relating to the issuance of pool and health memberships to disabled\nveterans at certain SUNY and CUNY campuses",
    "basePrintNo": "S7784",
    "basePrintNoStr": "S7784-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 1,
       "fullName": "Anthony H. Palumbo",
