   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to increasing fines\nfor failure to yield when approaching authorized emergency vehicles",
    "basePrintNo": "S4649",
    "basePrintNoStr": "S4649-2025",
    "coSponsors": {
     "items": [
