   "": {
    "actClause": "AN ACT to amend chapter 63 of the laws of 2021 amending the environmental\nconservation law relating to supermarkets providing excess edible food to food\nrelief organizations, in relation to extending the effectiveness of certain\nprovisions thereof",
    "basePrintNo": "S9452",
    "basePrintNoStr": "S9452-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 29,
       "fullName": "José M. Serrano",
       "imgName": "373_jose_m._serrano.jpg",
       "incumbent": true,
       "memberId": 373,
       "sessionMemberId": 2346,
       "sessionYear": 2025,
       "shortName": "SERRANO"
      }
     ],
     "size": 1
