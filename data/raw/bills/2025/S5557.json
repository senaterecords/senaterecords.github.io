   "A": {
    "actClause": "AN ACT in relation to authorizing the Jamesville-DeWitt central school\ndistrict to discontinue the use of school district-owned parklands and to\nlease such parklands to the town of Onondaga",
    "basePrintNo": "S5557",
    "basePrintNoStr": "S5557-2025",
    "coSponsors": {
