    "actClause": "AN ACT to amend the social services law, in relation to mental illness\ntraining in temporary housing",
    "basePrintNo": "S5505",
    "basePrintNoStr": "S5505-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 25,
       "fullName": "Jabari Brisport",
       "imgName": "1311_Jabari_Brisport.jpg",
       "incumbent": true,
       "memberId": 1494,
       "sessionMemberId": 2342,
       "sessionYear": 2025,
       "shortName": "BRISPORT"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 26,
       "fullName": "Andrew Gounardes",
       "imgName": "1049_Andrew_Gounardes.jpg",
       "incumbent": true,
       "memberId": 1229,
       "sessionMemberId": 2343,
       "sessionYear": 2025,
       "shortName": "GOUNARDES"
      }
     ],
