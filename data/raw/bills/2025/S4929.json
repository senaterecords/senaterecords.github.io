   "": {
    "actClause": "AN ACT to amend the social services law, in relation to caregiver requirements\nfor certain day care homes",
    "basePrintNo": "S4929",
    "basePrintNoStr": "S4929-2025",
    "coSponsors": {
     "items": [
      {
