   "": {
    "actClause": "AN ACT to amend the general business law, in relation to enacting the \"no\ngambling ads for kids act\"",
    "basePrintNo": "S10092",
    "basePrintNoStr": "S10092-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 5,
       "fullName": "Steve Rhoads",
       "imgName": "1333_Steve_Rhoads.jpg",
       "incumbent": true,
       "memberId": 1516,
       "sessionMemberId": 2322,
       "sessionYear": 2025,
       "shortName": "RHOADS"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 42,
       "fullName": "James Skoufis",
       "imgName": "672_james_skoufis.jpg",
       "incumbent": true,
       "memberId": 1232,
       "sessionMemberId": 2359,
       "sessionYear": 2025,
       "shortName": "SKOUFIS"
      }
