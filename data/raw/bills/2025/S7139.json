   "": {
    "actClause": "AN ACT authorizing the commissioner of general services to transfer and convey\ncertain lands in the town of Wilton, county of Saratoga, to the Veterans and\nCommunity Housing Coalition; and providing for the repeal of certain\nprovisions upon expiration thereof",
    "basePrintNo": "S7139",
    "basePrintNoStr": "S7139-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
