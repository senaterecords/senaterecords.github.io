   "": {
    "actClause": "AN ACT to amend the general business law, in relation to increasing the notice\nof cancellation requirements for automobile broker businesses",
    "basePrintNo": "S2672",
    "basePrintNoStr": "S2672-2025",
    "coSponsors": {
