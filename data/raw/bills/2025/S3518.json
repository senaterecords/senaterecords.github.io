   "": {
    "actClause": "AN ACT in relation to establishing the fentanyl abuse and overdose prevention\ntask force; and providing for the repeal of such provisions upon expiration\nthereof",
    "basePrintNo": "S3518",
    "basePrintNoStr": "S3518-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Jake Ashby",
       "imgName": "971_Jake_Ashby.jpg",
       "incumbent": true,
       "memberId": 1522,
       "sessionMemberId": 2360,
       "sessionYear": 2025,
       "shortName": "ASHBY"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 51,
       "fullName": "Peter Oberacker",
       "imgName": "1316_Peter_Oberacker.jpg",
       "incumbent": true,
       "memberId": 1499,
       "sessionMemberId": 2368,
       "sessionYear": 2025,
       "shortName": "OBERACKER"
      }
     ],
     "size": 2
