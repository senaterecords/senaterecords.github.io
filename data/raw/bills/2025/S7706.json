   "": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the\nstate highway system as the \"Jake Arcara Worker's Memorial Highway\"",
    "basePrintNo": "S7706",
    "basePrintNoStr": "S7706-2025",
    "coSponsors": {
     "items": [
