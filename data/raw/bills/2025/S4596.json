   "": {
    "actClause": "AN ACT to amend chapter 296 of the laws of 2023 amending the tax law relating\nto the imposition of an occupancy tax in the town of DeWitt, in relation to\nextending the effectiveness thereof",
    "basePrintNo": "S4596",
    "basePrintNoStr": "S4596-2025",
    "coSponsors": {
