   "": {
    "actClause": "AN ACT to amend the criminal procedure law, in relation to granting peace\nofficer status to uniformed court officers in the town of Montgomery",
    "basePrintNo": "S1679",
    "basePrintNoStr": "S1679-2025",
    "coSponsors": {
