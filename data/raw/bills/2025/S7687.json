   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to authorizing the\ndormitory authority to provide financing to SB Clinical Practice Management\nPlan, Inc. for the construction of facilities",
    "basePrintNo": "S7687",
    "basePrintNoStr": "S7687-2025",
