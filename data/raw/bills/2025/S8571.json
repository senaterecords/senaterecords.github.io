   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to the issuance of\nlicense plates for disabled veterans",
    "basePrintNo": "S8571",
    "basePrintNoStr": "S8571-2025",
    "coSponsors": {
     "items": [],
