    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to establishing a\nhighway safety corridor on the Southern State Parkway",
    "basePrintNo": "S10623",
    "basePrintNoStr": "S10623-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
