   "": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to an\nexemption for certain property in the village of Lake Placid from the\nprohibition of alcohol sales within a certain distance from a church",
    "basePrintNo": "S10551",
    "basePrintNoStr": "S10551-2025",
