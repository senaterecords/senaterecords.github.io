   "": {
    "actClause": "AN ACT to amend the civil practice law and rules and the administrative code\nof the city of New York, in relation to updating the fee collected by county\nclerks for deposit into the cultural education account",
    "basePrintNo": "S1490",
    "basePrintNoStr": "S1490-2025",
    "coSponsors": {
