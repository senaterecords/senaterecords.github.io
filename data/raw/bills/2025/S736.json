   "": {
    "actClause": "AN ACT to amend the executive law, in relation to hazardous materials\nemergency response training for incidents involving lithium-ion batteries",
    "basePrintNo": "S736",
    "basePrintNoStr": "S736-2025",
    "coSponsors": {
