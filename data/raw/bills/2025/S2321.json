   "A": {
    "actClause": "AN ACT to amend the real property tax law, in relation to authorizing the city\nof Albany to add unpaid housing code violation penalties, costs and fines to\nsuch city's annual tax levy",
    "basePrintNo": "S2321",
    "basePrintNoStr": "S2321-2025",
    "coSponsors": {
