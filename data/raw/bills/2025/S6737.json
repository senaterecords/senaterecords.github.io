    "actClause": "AN ACT to amend the education law, in relation to the date of school district\nannual organizational meetings; and to repeal certain provisions of such law\nrelating thereto",
    "basePrintNo": "S6737",
    "basePrintNoStr": "S6737-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 31,
       "fullName": "Robert Jackson",
       "imgName": "1050_Robert_Jackson.jpg",
       "incumbent": true,
       "memberId": 1230,
       "sessionMemberId": 2348,
       "sessionYear": 2025,
       "shortName": "JACKSON"
      }
     ],
     "size": 1
