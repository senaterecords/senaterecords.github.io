   "": {
    "actClause": "AN ACT to amend the social services law, in relation to when services for\ntraumatic brain injuries granted pursuant to a waiver by the federal social\nsecurity act shall begin",
    "basePrintNo": "S806",
    "basePrintNoStr": "S806-2025",
    "coSponsors": {
     "items": [
