   "": {
    "actClause": "AN ACT to amend the executive law, in relation to providing a rebuttable\npresumption relating to recertification as a minority and women-owned business\nenterprise",
    "basePrintNo": "S8826",
    "basePrintNoStr": "S8826-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 3,
       "fullName": "Dean Murray",
