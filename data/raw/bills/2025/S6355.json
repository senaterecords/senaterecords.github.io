   "": {
    "actClause": "AN ACT to amend the education law, in relation to the qualifications to serve\nas a member of the citywide council on English language learners and of the\ncitywide council on high schools",
    "basePrintNo": "S6355",
    "basePrintNoStr": "S6355-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 30,
       "fullName": "Cordell Cleare",
       "imgName": "Cordell Cleare.jpg",
       "incumbent": true,
       "memberId": 1504,
       "sessionMemberId": 2347,
       "sessionYear": 2025,
       "shortName": "CLEARE"
      }
     ],
     "size": 1
