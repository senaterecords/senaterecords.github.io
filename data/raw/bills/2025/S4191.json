    "actClause": "AN ACT to amend the energy law, in relation to code requirements for heavy\ndistribution centers",
    "basePrintNo": "S4191",
    "basePrintNoStr": "S4191-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
       "imgName": "888_leroy_comrie.jpg",
