       "sessionYear": 2025,
       "shortName": "MARTINS"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 50,
       "fullName": "Christopher Ryan",
       "imgName": "no_image.jpg",
       "incumbent": true,
       "memberId": 1551,
       "sessionMemberId": 2367,
       "sessionYear": 2025,
       "shortName": "RYAN C"
