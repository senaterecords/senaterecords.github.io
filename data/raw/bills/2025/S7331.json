   "": {
    "actClause": "AN ACT to amend the public health law, in relation to allowing individuals to\nregister in the \"donate life registry\" through mandatory electronic tax\nfilings",
    "basePrintNo": "S7331",
    "basePrintNoStr": "S7331-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 7,
       "fullName": "Jack M. Martins",
       "imgName": "397_jack_m._martins.jpg",
       "incumbent": true,
       "memberId": 397,
