   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to deer\nmanagement permits; and to repeal certain provisions of such law relating\nthereto",
    "basePrintNo": "S9462",
    "basePrintNoStr": "S9462-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
       "imgName": "888_leroy_comrie.jpg",
       "incumbent": true,
       "memberId": 888,
       "sessionMemberId": 2331,
       "sessionYear": 2025,
       "shortName": "COMRIE"
      }
     ],
     "size": 1
