   "": {
    "actClause": "AN ACT to amend the tax law, in relation to adding certain properties to the\ndefinition of a qualified historic home for the historic homeownership\nrehabilitation credit",
    "basePrintNo": "S405",
    "basePrintNoStr": "S405-2025",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 30,
       "fullName": "Cordell Cleare",
