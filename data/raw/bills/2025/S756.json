   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to requiring certain insurance\npolicies to cover neuropsychological exams for dyslexia",
    "basePrintNo": "S756",
    "basePrintNoStr": "S756-2025",
    "coSponsors": {
