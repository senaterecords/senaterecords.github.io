   "A": {
    "actClause": "AN ACT in relation to authorizing Karol Hughes to take the competitive civil\nservice examination for the position of police officer and be placed on the\neligible list for employment as a full-time police officer for the\ntown/village of East Rochester",
    "basePrintNo": "S7376",
    "basePrintNoStr": "S7376-2025",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
