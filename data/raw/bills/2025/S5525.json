   "": {
    "actClause": "AN ACT to amend the general municipal law, in relation to permitting the\nvillage of Croton-on-Hudson, Westchester county, to lease certain sports field\nfences for advertisements",
    "basePrintNo": "S5525",
    "basePrintNoStr": "S5525-2025",
    "coSponsors": {
