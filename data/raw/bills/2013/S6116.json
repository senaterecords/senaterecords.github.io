   "": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the state highway system as the \"Sergeant Omar G. Blowers Memorial Highway\"",
    "basePrintNo": "S6116",
    "basePrintNoStr": "S6116-2013",
    "coSponsors": {
