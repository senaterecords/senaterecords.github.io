 "substitutedBy": null,
 "summary": "Requires training of fire officers in a city with a population of one million or more; requires field training and classroom instruction in the fire and building codes and any relevant local ordinances of such city by July 1, 2015.",
 "title": "Requires training of fire officers in N.Y. city",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "S7009",
     "basePrintNoStr": "S7009-2013",
     "printNo": "S7009",
     "session": 2013,
