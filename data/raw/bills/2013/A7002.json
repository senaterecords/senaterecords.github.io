 "title": "Relates to access to viable agricultural land for new and beginning farmers",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A7002",
     "basePrintNoStr": "A7002-2013",
     "printNo": "A7002",
     "session": 2013,
