    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to driving while intoxicated and ignition interlock devices",
    "basePrintNo": "S5859",
    "basePrintNoStr": "S5859-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Martin Malavé Dilan",
       "imgName": "426_martin_malave_dilan.jpg",
       "incumbent": false,
       "memberId": 426,
