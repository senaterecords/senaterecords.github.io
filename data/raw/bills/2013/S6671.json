   "": {
    "actClause": "AN ACT to amend the education law, in relation to meetings and absences of the board of regents",
    "basePrintNo": "S6671",
    "basePrintNoStr": "S6671-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
       "memberId": 374,
