   "": {
    "actClause": "AN ACT to amend the education law, in relation to committees on preschool special education",
    "basePrintNo": "S4880",
    "basePrintNoStr": "S4880-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 2,
       "fullName": "John J. Flanagan",
       "imgName": "399_john_j._flanagan.jpg",
       "incumbent": false,
       "memberId": 399,
       "sessionMemberId": 155,
       "sessionYear": 2013,
       "shortName": "FLANAGAN"
      }
