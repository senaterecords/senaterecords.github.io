   "": {
    "actClause": "AN ACT to amend the social services law, in relation to notice requirements to families and providers when funding cuts are made",
    "basePrintNo": "S6806",
    "basePrintNoStr": "S6806-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 25,
       "fullName": "Velmanette Montgomery",
       "imgName": "381_velmanette_montgomery.jpg",
       "incumbent": false,
       "memberId": 381,
       "sessionMemberId": 168,
       "sessionYear": 2013,
       "shortName": "MONTGOMERY"
      }
