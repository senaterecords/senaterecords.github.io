   "": {
    "actClause": "AN ACT in relation to authorizing Cong Chasidei Bobov of Monsey to file an application for a real property tax exemption",
    "basePrintNo": "S4973",
    "basePrintNoStr": "S4973-2013",
    "coSponsors": {
