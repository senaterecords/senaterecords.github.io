   "": {
    "actClause": "AN ACT to amend the public health law, in relation to surgical technology and surgical technologists",
    "basePrintNo": "S5185",
    "basePrintNoStr": "S5185-2013",
    "coSponsors": {
     "items": [],
     "size": 0
