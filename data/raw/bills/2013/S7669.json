   "": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to the exemption of certain parcels of land",
    "basePrintNo": "S7669",
    "basePrintNoStr": "S7669-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 53,
       "fullName": "David J. Valesky",
       "imgName": "395_david_j._valesky.jpg",
       "incumbent": false,
       "memberId": 395,
       "sessionMemberId": 171,
       "sessionYear": 2013,
       "shortName": "VALESKY"
      }
     ],
     "size": 1
