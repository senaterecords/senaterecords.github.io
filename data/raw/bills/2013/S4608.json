   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the expiration of provisions authorizing the county of Cattaraugus to impose an additional one percent of sales and compensating use taxes",
    "basePrintNo": "S4608",
    "basePrintNoStr": "S4608-2013",
    "coSponsors": {
