   "": {
    "actClause": "AN ACT to amend the social services law, in relation to the composition of the interagency task force on human trafficking and their meetings; and to amend chapter 74 of the laws of 2007 amending the penal law, the criminal procedure law, the correction law, the social services law, and the executive law relating to human trafficking, in relation to extending the interagency task force on human trafficking",
    "basePrintNo": "S4663",
    "basePrintNoStr": "S4663-2013",
    "coSponsors": {
     "items": [],
     "size": 0
