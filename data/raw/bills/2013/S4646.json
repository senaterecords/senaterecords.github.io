   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the authority of the county of Orange to impose an additional rate of sales and compensating use taxes",
    "basePrintNo": "S4646",
    "basePrintNoStr": "S4646-2013",
    "coSponsors": {
