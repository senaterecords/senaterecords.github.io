   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to the powers of the state of New York mortgage agency",
    "basePrintNo": "S4399",
    "basePrintNoStr": "S4399-2013",
    "coSponsors": {
     "items": [],
     "size": 0
