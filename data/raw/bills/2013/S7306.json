   "": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the state highway system as the \"Sergeant Major Daniel \"Dan\" Joseph Daly Memorial Highway\"",
    "basePrintNo": "S7306",
    "basePrintNoStr": "S7306-2013",
    "coSponsors": {
