   "": {
    "actClause": "AN ACT to amend the general business law, in relation to cancellation of certain membership camping contracts",
    "basePrintNo": "S2339",
    "basePrintNoStr": "S2339-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
