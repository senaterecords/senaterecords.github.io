   "": {
    "actClause": "AN ACT to amend the education law, in relation to authorizing the commissioner of education to restrict the sale and advertisement of alcoholic beverages at sporting events participated in by any state university of New York, city university of New York or community college",
    "basePrintNo": "S2883",
    "basePrintNoStr": "S2883-2013",
    "coSponsors": {
