   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to funding for student health plans",
    "basePrintNo": "S7317",
    "basePrintNoStr": "S7317-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 58,
       "fullName": "Thomas F. O'Mara",
       "imgName": "415_thomas_f._o'mara.jpg",
       "incumbent": true,
       "memberId": 415,
       "sessionMemberId": 183,
