   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the expiration of the authorization to the county of Seneca to impose an additional one percent sales and compensating use tax",
    "basePrintNo": "S4701",
    "basePrintNoStr": "S4701-2013",
