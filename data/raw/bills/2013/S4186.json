   "A": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to refunding contributions made to the twenty-five year early retirement program and the age fifty-seven retirement program by New York city transit authority members",
    "basePrintNo": "S4186",
    "basePrintNoStr": "S4186-2013",
