   "": {
    "actClause": "AN ACT to amend chapter 465 of the laws of 1994, amending chapter 285 of the laws of 1891 relating to charging a fee for admission to the New York Botanical Garden, in relation to extending certain provisions authorizing the imposition of a required fee",
    "basePrintNo": "S7313",
    "basePrintNoStr": "S7313-2013",
    "coSponsors": {
