   "A": {
    "actClause": "AN ACT to amend the general municipal law, in relation to prohibiting local laws requiring the reporting of certain employee wage information",
    "basePrintNo": "S3362",
    "basePrintNoStr": "S3362-2013",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
