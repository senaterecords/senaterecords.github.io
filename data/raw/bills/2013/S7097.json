   "": {
    "actClause": "AN ACT to amend the election law, in relation to designating petitions; and providing for the repeal of such provisions upon expiration thereof",
    "basePrintNo": "S7097",
    "basePrintNoStr": "S7097-2013",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
