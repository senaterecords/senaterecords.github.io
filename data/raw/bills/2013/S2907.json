   "": {
    "actClause": "AN ACT to amend chapter 430 of the laws of 2012 relating to a certain agreement for a payment in lieu of taxes, in relation to the effectiveness thereof",
    "basePrintNo": "S2907",
    "basePrintNoStr": "S2907-2013",
    "coSponsors": {
