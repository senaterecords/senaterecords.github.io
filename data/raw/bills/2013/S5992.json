   "": {
    "actClause": "AN ACT to amend the real property tax law, in relation to exemption of capital improvements to multiple dwellings within certain cities",
    "basePrintNo": "S5992",
    "basePrintNoStr": "S5992-2013",
    "coSponsors": {
