   "": {
    "actClause": "AN ACT to amend the civil practice law and rules, in relation to required pleadings in actions arising from the conduct of a business required to be licensed by the state",
    "basePrintNo": "S2735",
    "basePrintNoStr": "S2735-2013",
    "coSponsors": {
