   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to the operation of vehicles when approaching a parked, stopped or standing authorized emergency vehicle or hazard vehicle",
    "basePrintNo": "S5507",
    "basePrintNoStr": "S5507-2013",
    "coSponsors": {
     "items": [],
