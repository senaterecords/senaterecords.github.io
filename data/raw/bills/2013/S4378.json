    "actClause": "AN ACT to amend the correction law, in relation to authorizing commission attorneys to issue substitute jail designations",
    "basePrintNo": "S4378",
    "basePrintNoStr": "S4378-2013",
    "coSponsors": {
     "items": [],
     "size": 0
