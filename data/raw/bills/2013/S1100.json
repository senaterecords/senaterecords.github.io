   "A": {
    "actClause": "AN ACT to amend the executive law, in relation to missing children and vulnerable adults",
    "basePrintNo": "S1100",
    "basePrintNoStr": "S1100-2013",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
