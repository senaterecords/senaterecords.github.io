    "actClause": "AN ACT to amend the public health law, in relation to medical assistance payments for capital costs for certain diagnostic and treatment centers",
    "basePrintNo": "S5483",
    "basePrintNoStr": "S5483-2013",
    "coSponsors": {
     "items": [
      {
