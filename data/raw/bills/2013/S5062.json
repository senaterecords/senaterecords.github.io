   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the authorization of the county of Oswego to impose an additional one percent sales and compensating use taxes",
    "basePrintNo": "S5062",
    "basePrintNoStr": "S5062-2013",
    "coSponsors": {
