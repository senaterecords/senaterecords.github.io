   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to supplementary uninsured and underinsured motorist coverage for ambulance services, volunteer fire departments and voluntary ambulance services",
    "basePrintNo": "S2757",
    "basePrintNoStr": "S2757-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 55,
       "fullName": "Ted O'Brien",
       "imgName": "Ted O'Brien.jpg",
       "incumbent": false,
