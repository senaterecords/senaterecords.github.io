   "": {
    "actClause": "AN ACT to amend the executive law, in relation to minority and women-owned business enterprise certification",
    "basePrintNo": "S7314",
    "basePrintNoStr": "S7314-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 45,
       "fullName": "Betty Little",
       "imgName": "379_betty_little.jpg",
       "incumbent": false,
       "memberId": 379,
       "sessionMemberId": 135,
       "sessionYear": 2013,
       "shortName": "LITTLE"
