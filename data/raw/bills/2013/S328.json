   "": {
    "actClause": "AN ACT to amend the public health law, in relation to providing all blind and visually impaired patients with an audio recording of the discharge plan and preadmission information",
    "basePrintNo": "S328",
    "basePrintNoStr": "S328-2013",
    "coSponsors": {
