   "A": {
    "actClause": "AN ACT to amend the public health law, in relation to including concussions within the New York state traumatic brain injury program",
    "basePrintNo": "S7004",
    "basePrintNoStr": "S7004-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 6,
       "fullName": "Kemp Hannon",
