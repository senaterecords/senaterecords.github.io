   "": {
    "actClause": "AN ACT to amend the education law, in relation to registered dental hygienists",
    "basePrintNo": "S5757",
    "basePrintNoStr": "S5757-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 57,
       "fullName": "Catharine Young",
       "imgName": "414_catharine_young.jpg",
       "incumbent": false,
       "memberId": 414,
       "sessionMemberId": 170,
       "sessionYear": 2013,
       "shortName": "YOUNG"
      }
     ],
     "size": 1
