   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to vehicle fitness for crossing R-posted bridges",
    "basePrintNo": "S6825",
    "basePrintNoStr": "S6825-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
