    "actClause": "AN ACT authorizing the state university of New York at Stony Brook to lease certain lands",
    "basePrintNo": "S6854",
    "basePrintNoStr": "S6854-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 1,
       "fullName": "Kenneth P. LaValle",
