   "": {
    "actClause": "AN ACT to amend the civil service law, in relation to directing the granting of excused leave to public officers and employees of this state to undertake screening for cervical cancer",
    "basePrintNo": "S2069",
    "basePrintNoStr": "S2069-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 21,
       "fullName": "Kevin S. Parker",
       "imgName": "416_kevin_s._parker.jpg",
       "incumbent": true,
       "memberId": 416,
       "sessionMemberId": 172,
       "sessionYear": 2013,
       "shortName": "PARKER"
