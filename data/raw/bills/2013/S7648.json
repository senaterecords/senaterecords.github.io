   "": {
    "actClause": "AN ACT to amend chapter 23 of the laws of 2009, amending the vehicle and traffic law and the public officers law relating to adjudications and owner liability for a violation of traffic-control signal indications, in relation to extending the provisions of such chapter",
    "basePrintNo": "S7648",
    "basePrintNoStr": "S7648-2013",
    "coSponsors": {
