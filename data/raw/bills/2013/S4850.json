   "": {
    "actClause": "AN ACT to amend the civil practice law and rules, in relation to prevention of abuse during discovery",
    "basePrintNo": "S4850",
    "basePrintNoStr": "S4850-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 21,
       "fullName": "Kevin S. Parker",
