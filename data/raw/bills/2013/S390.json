   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to the definition of electric assisted bicycle",
    "basePrintNo": "S390",
    "basePrintNoStr": "S390-2013",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
