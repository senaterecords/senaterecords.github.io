   "": {
    "actClause": "AN ACT to amend the public health law, in relation to the adoption information registry; and to amend chapter 480 of the laws of 2012, amending the public health law relating to the adoption registry, in relation to the effectiveness thereof",
    "basePrintNo": "S2889",
    "basePrintNoStr": "S2889-2013",
    "coSponsors": {
