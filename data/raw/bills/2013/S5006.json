   "": {
    "actClause": "AN ACT to authorize St. Peter and Paul Ukrainian Catholic Church to apply for exemption from real property taxes pursuant to section 420-a of the real property tax law",
    "basePrintNo": "S5006",
    "basePrintNoStr": "S5006-2013",
    "coSponsors": {
