   "A": {
    "actClause": "AN ACT to amend the education law, in relation to the leasing of real property by boards of cooperative educational services; and providing for the repeal of such provisions upon expiration thereof",
    "basePrintNo": "S7227",
    "basePrintNoStr": "S7227-2013",
    "coSponsors": {
     "items": [],
