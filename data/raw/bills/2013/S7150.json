   "": {
    "actClause": "AN ACT to amend the public health law, in relation to providing for a decision to elect hospice on behalf of a hospice-eligible incapable adult patient without a surrogate",
    "basePrintNo": "S7150",
    "basePrintNoStr": "S7150-2013",
