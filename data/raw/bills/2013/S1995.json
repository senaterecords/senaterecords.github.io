    "actClause": "AN ACT enacting the \"Rockland Bergen Bi-state watershed flood prevention and protection act\" and creating the Rockland Bergen Bi-state River Commission",
    "basePrintNo": "S1995",
    "basePrintNoStr": "S1995-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
       "memberId": 374,
       "sessionMemberId": 130,
       "sessionYear": 2013,
       "shortName": "LARKIN"
      }
