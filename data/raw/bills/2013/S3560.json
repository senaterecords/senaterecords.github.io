   "": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to providing an exemption for a retail liquor license",
    "basePrintNo": "S3560",
    "basePrintNoStr": "S3560-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
