   "A": {
    "actClause": "AN ACT in relation to authorizing the Eastchester fire district, in the town of Eastchester, county of Westchester, to change the date of its annual election",
    "basePrintNo": "S2122",
    "basePrintNoStr": "S2122-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Martin Malavé Dilan",
       "imgName": "426_martin_malave_dilan.jpg",
       "incumbent": false,
       "memberId": 426,
       "sessionMemberId": 137,
       "sessionYear": 2013,
       "shortName": "DILAN"
      }
     ],
     "size": 1
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
