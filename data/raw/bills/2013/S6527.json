   "": {
    "actClause": "AN ACT to amend the racing, pari-mutuel wagering and breeding law, in relation to certain payments to the horsemen's organization",
    "basePrintNo": "S6527",
    "basePrintNoStr": "S6527-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Kathleen A. Marchione",
       "imgName": "435_kathleen_a._marchione.jpg",
       "incumbent": false,
       "memberId": 435,
       "sessionMemberId": 144,
       "sessionYear": 2013,
       "shortName": "MARCHIONE"
