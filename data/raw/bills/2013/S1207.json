   "": {
    "actClause": "AN ACT to amend the public health law, in relation to prohibiting the appointment of a health care agent or surrogate who is the subject of an order of protection protecting the principal",
    "basePrintNo": "S1207",
    "basePrintNoStr": "S1207-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
       "memberId": 374,
       "sessionMemberId": 130,
       "sessionYear": 2013,
       "shortName": "LARKIN"
