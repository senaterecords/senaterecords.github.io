   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the authorization granted to the county of Lewis to impose an additional one percent of sales and compensating use taxes",
    "basePrintNo": "S4983",
    "basePrintNoStr": "S4983-2013",
