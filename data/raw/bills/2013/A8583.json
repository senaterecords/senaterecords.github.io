 "title": "Relates to hearings following major power outages",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A8583",
     "basePrintNoStr": "A8583-2013",
     "printNo": "A8583",
     "session": 2013,
