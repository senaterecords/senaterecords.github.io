   "": {
    "actClause": "AN ACT to amend the New York city charter, in relation to the application of uniform land use review procedures",
    "basePrintNo": "S4960",
    "basePrintNoStr": "S4960-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
