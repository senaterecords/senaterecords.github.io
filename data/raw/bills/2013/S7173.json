   "": {
    "actClause": "AN ACT to amend the general business law, in relation to fees charged by a theatrical employment agency",
    "basePrintNo": "S7173",
    "basePrintNoStr": "S7173-2013",
    "coSponsors": {
     "items": [],
     "size": 0
