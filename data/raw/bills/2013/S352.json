   "": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to providing that no retail licensee for on-premises consumption shall intentionally adulterate, dilute or fortify the contents of any container of alcoholic beverages",
    "basePrintNo": "S352",
    "basePrintNoStr": "S352-2013",
