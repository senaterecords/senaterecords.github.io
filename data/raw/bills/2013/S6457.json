   "": {
    "actClause": "AN ACT to amend chapter 185 of the laws of 2005, amending the tax law relating to authorizing the county of Wyoming to impose a county recording tax on obligations secured by a mortgage on real property, in relation to the expiration thereof",
    "basePrintNo": "S6457",
    "basePrintNoStr": "S6457-2013",
    "coSponsors": {
