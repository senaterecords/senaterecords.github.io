   "": {
    "actClause": "AN ACT to amend the public health law, in relation to requiring the commissioner of health to create a list of long-term care contact information for the NY Connects: Choices for Long Term Care program",
    "basePrintNo": "S2157",
    "basePrintNoStr": "S2157-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 60,
       "fullName": "Mark Grisanti",
       "imgName": "Mark Grisanti.jpg",
       "incumbent": false,
       "memberId": 398,
       "sessionMemberId": 154,
       "sessionYear": 2013,
       "shortName": "GRISANTI"
      }
     ],
     "size": 1
