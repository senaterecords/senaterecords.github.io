   "A": {
    "actClause": "AN ACT to amend the public health law, in relation to the shipment of cigarettes",
    "basePrintNo": "S5215",
    "basePrintNoStr": "S5215-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 22,
       "fullName": "Martin J. Golden",
       "imgName": "422_martin_j._golden.jpg",
