   "": {
    "actClause": "AN ACT to amend the highway law, in relation to the \"St. Lawrence Wine Trail\"",
    "basePrintNo": "S6321",
    "basePrintNoStr": "S6321-2013",
    "coSponsors": {
     "items": [
