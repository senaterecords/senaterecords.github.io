   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to requiring the department of agriculture and markets to evaluate their support of farmers age sixty-two years and older",
    "basePrintNo": "S7433",
    "basePrintNoStr": "S7433-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 48,
       "fullName": "Patty Ritchie",
       "imgName": "423_patty_ritchie.jpg",
