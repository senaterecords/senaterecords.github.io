   "": {
    "actClause": "AN ACT to amend the real property tax law, in relation to exempting certain residential real property owned by a totally disabled veteran from real property taxes",
    "basePrintNo": "S6541",
    "basePrintNoStr": "S6541-2013",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
