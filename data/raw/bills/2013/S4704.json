   "": {
    "actClause": "AN ACT to amend the tax law, in relation to continuing to authorize Niagara county to impose an additional rate of sales and compensating use taxes",
    "basePrintNo": "S4704",
    "basePrintNoStr": "S4704-2013",
    "coSponsors": {
