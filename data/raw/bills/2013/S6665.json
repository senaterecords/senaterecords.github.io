   "": {
    "actClause": "AN ACT to amend the social services law, in relation to the low-income home energy assistance program",
    "basePrintNo": "S6665",
    "basePrintNoStr": "S6665-2013",
    "coSponsors": {
     "items": [],
     "size": 0
