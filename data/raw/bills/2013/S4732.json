   "": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to the employment of retired persons",
    "basePrintNo": "S4732",
    "basePrintNoStr": "S4732-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
