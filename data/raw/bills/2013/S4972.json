   "": {
    "actClause": "AN ACT to amend chapter 719 of the laws of 1980 amending the local finance law relating to the period of probable usefulness of certain judgments, compromised claims or settled claims, in relation to extending the provisions of such chapter",
    "basePrintNo": "S4972",
    "basePrintNoStr": "S4972-2013",
    "coSponsors": {
