   "": {
    "actClause": "AN ACT to amend the tax law, in relation to extending the expiration of the provisions authorizing the county of Chautauqua to impose an additional one-half of one percent sales and compensating use taxes",
    "basePrintNo": "S4849",
    "basePrintNoStr": "S4849-2013",
    "coSponsors": {
