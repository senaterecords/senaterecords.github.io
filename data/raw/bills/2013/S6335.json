   "": {
    "actClause": "AN ACT to amend chapter 557 of the laws of 2013 amending the executive law relating to enacting the \"veterans employment act\", in relation to the effectiveness thereof",
    "basePrintNo": "S6335",
    "basePrintNoStr": "S6335-2013",
    "coSponsors": {
