   "": {
    "actClause": "AN ACT to amend the Nassau county administrative code, in relation to the levy and extension of real property taxes on class four real property",
    "basePrintNo": "S7853",
    "basePrintNoStr": "S7853-2013",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
