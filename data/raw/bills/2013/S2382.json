   "": {
    "actClause": "AN ACT to amend the public service law, in relation to remote net energy metering",
    "basePrintNo": "S2382",
    "basePrintNoStr": "S2382-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 21,
       "fullName": "Kevin S. Parker",
       "imgName": "416_kevin_s._parker.jpg",
       "incumbent": true,
       "memberId": 416,
       "sessionMemberId": 172,
       "sessionYear": 2013,
       "shortName": "PARKER"
      }
     ],
     "size": 1
