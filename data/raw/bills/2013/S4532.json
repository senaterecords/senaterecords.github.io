   "": {
    "actClause": "AN ACT to amend the tax law, in relation to the treatment of notices filed of the payment of mortgage recording tax on an instrument not entitled to be recorded",
    "basePrintNo": "S4532",
    "basePrintNoStr": "S4532-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 61,
       "fullName": "Michael H. Ranzenhofer",
       "imgName": "406_michael_h._ranzenhofer.jpg",
       "incumbent": false,
       "memberId": 406,
       "sessionMemberId": 162,
       "sessionYear": 2013,
       "shortName": "RANZENHOFER"
      }
     ],
     "size": 1
