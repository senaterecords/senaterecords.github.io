   "": {
    "actClause": "AN ACT to amend the general municipal law and the administrative code of the city of New York, in relation to service by police officers in an undercover capacity",
    "basePrintNo": "S6726",
    "basePrintNoStr": "S6726-2013",
    "coSponsors": {
