   "": {
    "actClause": "AN ACT to amend the education law, in relation to the election of regents and the creation of the commission on regents",
    "basePrintNo": "S6790",
    "basePrintNoStr": "S6790-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
