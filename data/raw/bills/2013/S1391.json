   "": {
    "actClause": "AN ACT to amend the correction law, in relation to notice to sex offenders of their determination hearing and the penalty for violations by sex offenders",
    "basePrintNo": "S1391",
    "basePrintNoStr": "S1391-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 11,
       "fullName": "Tony Avella",
       "imgName": "391_tony_avella.jpg",
       "incumbent": false,
