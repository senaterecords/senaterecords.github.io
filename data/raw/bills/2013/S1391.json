       "shortName": "AVELLA"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 58,
       "fullName": "Thomas F. O'Mara",
       "imgName": "415_thomas_f._o'mara.jpg",
       "incumbent": true,
       "memberId": 415,
       "sessionMemberId": 183,
       "sessionYear": 2013,
       "shortName": "O'MARA"
      }
