   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to internet enrollment of employees",
    "basePrintNo": "S6505",
    "basePrintNoStr": "S6505-2013",
    "coSponsors": {
     "items": [],
     "size": 0
