   "": {
    "actClause": "AN ACT to amend chapter 695 of the laws of 1994 amending the civil service law relating to injunctive relief in improper practice cases, in relation to extending the effectiveness of provisions contained therein",
    "basePrintNo": "S4909",
    "basePrintNoStr": "S4909-2013",
    "coSponsors": {
