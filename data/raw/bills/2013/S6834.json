   "": {
    "actClause": "AN ACT to amend chapter 135 of the laws of 2002 amending the education law relating to mandatory continuing education for land surveyors, in relation to extending the provisions of such chapter",
    "basePrintNo": "S6834",
    "basePrintNoStr": "S6834-2013",
    "coSponsors": {
