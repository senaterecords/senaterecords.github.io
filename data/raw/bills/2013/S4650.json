   "": {
    "actClause": "AN ACT to amend the general municipal law, in relation to training of fire officers in cities of one million or more",
    "basePrintNo": "S4650",
    "basePrintNoStr": "S4650-2013",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 11,
       "fullName": "Tony Avella",
       "imgName": "391_tony_avella.jpg",
       "incumbent": false,
       "memberId": 391,
       "sessionMemberId": 147,
       "sessionYear": 2013,
       "shortName": "AVELLA"
      }
     ],
     "size": 1
