   "": {
    "actClause": "AN ACT to authorize the town of Marlborough, in the county of Ulster, to offer an optional twenty year retirement plan to police officers Charles Hoffman and Arthur Terwilliger",
    "basePrintNo": "S6915",
    "basePrintNoStr": "S6915-2013",
    "coSponsors": {
