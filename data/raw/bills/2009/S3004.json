   "A": {
    "actClause": "AN ACT to amend the administrative code of the city of New York, in relation to health insurance coverage for surviving spouses or domestic partners of members of the New York city department of correction or sanitation who are enrolled in a health insurance plan",
    "basePrintNo": "S3004",
