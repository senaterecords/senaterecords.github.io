   "": {
    "actClause": "AN ACT to amend the judiciary law, in relation to explanation of reasons for dismissal of complaints",
    "basePrintNo": "S6264",
    "basePrintNoStr": "S6264-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
