   "": {
    "actClause": "AN ACT to amend the public officers law, in relation to the enforcement of the open meetings law",
    "basePrintNo": "S7054",
    "basePrintNoStr": "S7054-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 25,
       "fullName": "Daniel L. Squadron",
       "imgName": "412_daniel_l._squadron.jpg",
       "incumbent": false,
       "memberId": 412,
       "sessionMemberId": 42,
       "sessionYear": 2009,
       "shortName": "SQUADRON"
      }
