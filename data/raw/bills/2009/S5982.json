    "actClause": "AN ACT to amend the labor law and the general business law, in relation to the prompt payment of employees and contractors engaged in private construction projects",
    "basePrintNo": "S5982",
    "basePrintNoStr": "S5982-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
