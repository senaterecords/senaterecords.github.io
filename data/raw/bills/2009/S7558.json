   "": {
    "actClause": "AN ACT to amend the general business law, in relation to disclosures required for certain solicitations by container",
    "basePrintNo": "S7558",
    "basePrintNoStr": "S7558-2009",
    "coSponsors": {
     "items": [],
     "size": 0
