   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to the construction of facilities by the dormitory authority for Mercy Flight, Inc., of Western New York",
    "basePrintNo": "S5938",
    "basePrintNoStr": "S5938-2009",
