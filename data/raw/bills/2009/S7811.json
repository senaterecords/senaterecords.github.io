   "": {
    "actClause": "AN ACT to amend the real property law, in relation to prohibiting the implementation of electronic billing and/or payment of rent without the tenant's consent",
    "basePrintNo": "S7811",
    "basePrintNoStr": "S7811-2009",
    "coSponsors": {
     "items": [],
     "size": 0
