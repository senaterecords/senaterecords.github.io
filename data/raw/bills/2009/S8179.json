   "": {
    "actClause": "AN ACT to amend the not-for-profit corporation law, in relation to an exemption to the residency requirement for firefighters of the ;.hy sup;Huguenot Fire Co., Inc.",
    "basePrintNo": "S8179",
    "basePrintNoStr": "S8179-2009",
