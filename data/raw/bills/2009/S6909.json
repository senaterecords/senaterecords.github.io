   "": {
    "actClause": "AN ACT to amend the election law, in relation to party emblems",
    "basePrintNo": "S6909",
    "basePrintNoStr": "S6909-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 60,
       "fullName": "Antoine M. Thompson",
       "imgName": "Antoine M. Thompson.jpg",
       "incumbent": false,
       "memberId": 447,
       "sessionMemberId": 28,
       "sessionYear": 2009,
       "shortName": "THOMPSON"
