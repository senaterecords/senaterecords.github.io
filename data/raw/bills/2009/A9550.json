   "": {
    "actClause": "AN ACT to amend the public health law, in relation to admissions to adult care facilities",
    "basePrintNo": "A9550",
    "basePrintNoStr": "A9550-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "ASSEMBLY",
