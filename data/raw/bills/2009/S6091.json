    "actClause": "AN ACT to amend the penal law, in relation to the crime of aggravated murder involving a child",
    "basePrintNo": "S6091",
    "basePrintNoStr": "S6091-2009",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
