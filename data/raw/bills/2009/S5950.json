   "A": {
    "actClause": "AN ACT authorizing the town of Brookhaven, Suffolk county to establish a special improvement district or benefited area for medical services and to appropriate, collect and expend monies in furtherance thereof",
    "basePrintNo": "S5950",
    "basePrintNoStr": "S5950-2009",
