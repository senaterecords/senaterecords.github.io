   "": {
    "actClause": "AN ACT to amend the penal law, in relation to criminalizing assaults on sanitation enforcement agents",
    "basePrintNo": "A9186",
    "basePrintNoStr": "A9186-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "ASSEMBLY",
       "districtCode": 65,
       "fullName": "Micah Kellner",
       "imgName": "no_image.jpg",
       "incumbent": false,
       "memberId": 518,
       "sessionMemberId": 192,
       "sessionYear": 2009,
       "shortName": "KELLNER"
