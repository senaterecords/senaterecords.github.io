   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to providing for the financing and construction of capital facilities for Friends Academy, Glen Cove, Nassau County",
    "basePrintNo": "S5769",
    "basePrintNoStr": "S5769-2009",
