    "actClause": "AN ACT to amend the executive law, in relation to establishing the New York state interagency coordinating council for service-disabled veterans, defining the powers and duties of the council and requiring an annual report by the council to the governor, the temporary president of the senate and the speaker of the assembly",
    "basePrintNo": "S7112",
    "basePrintNoStr": "S7112-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 22,
       "fullName": "Martin J. Golden",
       "imgName": "422_martin_j._golden.jpg",
       "incumbent": false,
       "memberId": 422,
       "sessionMemberId": 52,
       "sessionYear": 2009,
       "shortName": "GOLDEN"
