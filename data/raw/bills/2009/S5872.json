    "actClause": "AN ACT to amend the social services law, in relation to the specialty pharmacy program",
    "basePrintNo": "S5872",
    "basePrintNoStr": "S5872-2009",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
