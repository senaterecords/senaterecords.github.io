    "actClause": "AN ACT to amend the county law, in relation to providing for the licensure of electrical inspectors within the county of Westchester",
    "basePrintNo": "S5713",
    "basePrintNoStr": "S5713-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 36,
       "fullName": "Ruth Hassell-Thompson",
       "imgName": "380_ruth_hassell-thompson.jpg",
       "incumbent": false,
       "memberId": 380,
       "sessionMemberId": 12,
       "sessionYear": 2009,
       "shortName": "HASSELL-THOMPSON"
      }
