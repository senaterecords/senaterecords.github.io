   "": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to wineries, farm wineries, special wineries, special farm wineries and microwineries; and to repeal certain provisions of such law relating thereto",
    "basePrintNo": "S8305",
    "basePrintNoStr": "S8305-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 49,
       "fullName": "David J. Valesky",
       "imgName": "395_david_j._valesky.jpg",
       "incumbent": false,
       "memberId": 395,
       "sessionMemberId": 26,
       "sessionYear": 2009,
       "shortName": "VALESKY"
      }
