    "actClause": "AN ACT to amend the correction law, in relation to eligibility for the shock program",
    "basePrintNo": "S8228",
    "basePrintNoStr": "S8228-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 45,
       "fullName": "Betty Little",
       "imgName": "379_betty_little.jpg",
       "incumbent": false,
