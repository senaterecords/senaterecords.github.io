   "": {
    "actClause": "AN ACT to amend the Erie county tax act, in relation to providing that the amount required to redeem real property affected by any tax sale certificate in foreclosure, or to be recovered by the plaintiff in foreclosure, shall include the aggregate amount of all tax sale certificates affecting such real property and shall also include amounts for attorneys' fees, abstracts of title, court costs, allowances and other disbursements",
    "basePrintNo": "S8324",
    "basePrintNoStr": "S8324-2009",
    "coSponsors": {
