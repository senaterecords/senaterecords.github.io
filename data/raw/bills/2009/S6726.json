    "actClause": "AN ACT to amend the limited liability company law, in relation to establishing the L3C act regarding low-profit limited liability companies",
    "basePrintNo": "S6726",
    "basePrintNoStr": "S6726-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 21,
       "fullName": "Kevin S. Parker",
       "imgName": "416_kevin_s._parker.jpg",
       "incumbent": true,
       "memberId": 416,
       "sessionMemberId": 46,
       "sessionYear": 2009,
       "shortName": "PARKER"
      }
     ],
     "size": 1
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
