   "": {
    "actClause": "AN ACT to amend the public health law, in relation to enacting the \"hospital closure planning act\"",
    "basePrintNo": "S5802",
    "basePrintNoStr": "S5802-2009",
    "coSponsors": {
     "items": [],
     "size": 0
