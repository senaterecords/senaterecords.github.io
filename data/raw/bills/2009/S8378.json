    "actClause": "AN ACT to amend the state finance law, in relation to establishing the New York fraud, enforcement and recovery act",
    "basePrintNo": "S8378",
    "basePrintNoStr": "S8378-2009",
    "coSponsors": {
     "items": [],
     "size": 0
