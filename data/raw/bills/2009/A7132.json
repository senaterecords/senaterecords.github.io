   "A": {
    "actClause": "AN ACT to amend the estates, powers and trusts law, the general obligations law and the mental hygiene law, in relation to the renunciation of property interests",
    "basePrintNo": "A7132",
    "basePrintNoStr": "A7132-2009",
    "coSponsors": {
     "items": [],
