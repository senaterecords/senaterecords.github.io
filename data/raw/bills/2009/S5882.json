   "": {
    "actClause": "AN ACT to amend the county law, in relation to allowing the county of Tompkins to increase the surcharge on access lines from thirty-five cents to one dollar",
    "basePrintNo": "S5882",
    "basePrintNoStr": "S5882-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 51,
       "fullName": "James L. Seward",
       "imgName": "371_james_l._seward.jpg",
       "incumbent": false,
       "memberId": 371,
       "sessionMemberId": 3,
       "sessionYear": 2009,
       "shortName": "SEWARD"
