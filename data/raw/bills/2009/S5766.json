   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to the sale of certain wild animals",
    "basePrintNo": "S5766",
    "basePrintNoStr": "S5766-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 21,
       "fullName": "Kevin S. Parker",
       "imgName": "416_kevin_s._parker.jpg",
       "incumbent": true,
       "memberId": 416,
       "sessionMemberId": 46,
       "sessionYear": 2009,
       "shortName": "PARKER"
      }
