   "": {
    "actClause": "AN ACT to amend the tax law, in relation to qualified capital investments at relocated vendor tracks in Sullivan county",
    "basePrintNo": "S5828",
    "basePrintNoStr": "S5828-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 34,
       "fullName": "Jeffrey D. Klein",
       "imgName": "390_jeffrey_d._klein.jpg",
       "incumbent": false,
       "memberId": 390,
       "sessionMemberId": 21,
