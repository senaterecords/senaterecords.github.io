   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to the definition of an independent worker and requirements for an eligible insurer's application",
    "basePrintNo": "S7772",
    "basePrintNoStr": "S7772-2009",
    "coSponsors": {
