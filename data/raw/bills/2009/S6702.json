   "": {
    "actClause": "AN ACT to amend the village law, in relation to permitting village justices of the village of Sag Harbor to live in the towns of East Hampton or Southampton",
    "basePrintNo": "S6702",
    "basePrintNoStr": "S6702-2009",
    "coSponsors": {
