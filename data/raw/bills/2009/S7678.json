   "": {
    "actClause": "AN ACT to amend the education law, in relation to the powers and duties of boards of cooperative educational services, to the operation and management of and enrollment at charter schools, and to increasing the cap on the total number of charter schools in the state to four hundred sixty; and to amend chapter 57 of the laws of 2008, amending the education law relating to tenure determinations, in relation to the effectiveness of such part",
    "basePrintNo": "S7678",
    "basePrintNoStr": "S7678-2009",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
