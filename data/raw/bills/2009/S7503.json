   "": {
    "actClause": "AN ACT to amend chapter 246 of the laws of 1916 relating to the extermination of mosquitoes and the establishment of districts therefor, in relation to authorization for the amount of the annual appropriation by the town of Southold for the Orient mosquito district",
    "basePrintNo": "S7503",
