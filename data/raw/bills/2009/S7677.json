    "actClause": "AN ACT to amend the real property tax law, in relation to providing tax receipts electronically",
    "basePrintNo": "S7677",
    "basePrintNoStr": "S7677-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 60,
       "fullName": "Antoine M. Thompson",
