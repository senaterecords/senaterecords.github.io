   "": {
    "actClause": "AN ACT to amend the social services law and the correction law, in relation to the placement of homeless sex offenders in Suffolk county",
    "basePrintNo": "S8026",
    "basePrintNoStr": "S8026-2009",
    "coSponsors": {
