    "actClause": "AN ACT to amend the environmental conservation law, in relation to the transfer of a lifetime license for hunting, fishing and trapping",
    "basePrintNo": "S8116",
    "basePrintNoStr": "S8116-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 49,
       "fullName": "David J. Valesky",
       "imgName": "395_david_j._valesky.jpg",
       "incumbent": false,
       "memberId": 395,
