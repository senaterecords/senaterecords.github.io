   "": {
    "actClause": "AN ACT to amend the education law, in relation to the dissection of animals",
    "basePrintNo": "S7820",
    "basePrintNoStr": "S7820-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 26,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 31,
       "sessionYear": 2009,
       "shortName": "KRUEGER"
      }
