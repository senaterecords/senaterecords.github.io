   "": {
    "actClause": "AN ACT to amend the mental hygiene law, in relation to required reporting of suspected abuse of adults in certain residential care facilities licensed or operated by the state",
    "basePrintNo": "S5930",
    "basePrintNoStr": "S5930-2009",
    "coSponsors": {
