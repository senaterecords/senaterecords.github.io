   "": {
    "actClause": "AN ACT to amend chapter 172 of the laws of 2002 amending the public authorities law relating to the powers of the state of New York mortgage agency, in relation to extending the provisions thereof",
    "basePrintNo": "S7583",
    "basePrintNoStr": "S7583-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 33,
       "fullName": "Pedro Espada Jr.",
       "imgName": "Pedro Espada Jr.jpg",
       "incumbent": false,
       "memberId": 442,
