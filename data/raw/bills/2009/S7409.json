   "": {
    "actClause": "AN ACT to amend chapter 491 of the laws of 1995 amending the workers' compensation law relating to permitting the establishment of an alternative dispute resolution system to resolve workers' compensation claims through collective bargaining agreements, in relation to making such provisions permanent",
    "basePrintNo": "S7409",
    "basePrintNoStr": "S7409-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 23,
       "fullName": "Diane J. Savino",
       "imgName": "403_diane_j._savino.jpg",
