    "actClause": "AN ACT to amend the correction law, in relation to significant programmatic accomplishments for limited credit time allowances",
    "basePrintNo": "S7864",
    "basePrintNoStr": "S7864-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Velmanette Montgomery",
       "imgName": "381_velmanette_montgomery.jpg",
       "incumbent": false,
       "memberId": 381,
       "sessionMemberId": 13,
       "sessionYear": 2009,
       "shortName": "MONTGOMERY"
      }
     ],
     "size": 1
