   "B": {
    "actClause": "AN ACT to amend the election law, in relation to the alteration of election districts by the board of elections; and to repeal certain provisions of such law relating thereto",
    "basePrintNo": "S5447",
    "basePrintNoStr": "S5447-2009",
    "coSponsors": {
