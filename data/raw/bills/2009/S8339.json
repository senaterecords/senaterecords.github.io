    "actClause": "AN ACT to amend the public authorities law, in relation to the powers and duties of the dormitory authority; and to amend the New York state medical care facilities finance agency act, in relation to equipment loans for intellectual property",
    "basePrintNo": "S8339",
    "basePrintNoStr": "S8339-2009",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
