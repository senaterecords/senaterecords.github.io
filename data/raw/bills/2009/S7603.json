    "actClause": "AN ACT to amend the public health law, in relation to causes of action against certain businesses arising in connection with the AED",
    "basePrintNo": "S7603",
    "basePrintNoStr": "S7603-2009",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
