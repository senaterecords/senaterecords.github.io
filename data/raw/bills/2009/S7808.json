   "": {
    "actClause": "AN ACT to amend chapter 831 of the laws of 1981, amending the labor law relating to fees and expenses in unemployment insurance proceedings, in relation to extending the provisions of such chapter",
    "basePrintNo": "S7808",
    "basePrintNoStr": "S7808-2009",
    "coSponsors": {
