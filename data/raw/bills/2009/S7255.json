    "actClause": "AN ACT to amend the mental hygiene law, in relation to defining the scope of responsibilities of the office of alcoholism and substance abuse services regarding recovery services, terms of operating certificates and the DWI provider list, and permitting local departments of social services to participate in the process of developing local services plans",
    "basePrintNo": "S7255",
    "basePrintNoStr": "S7255-2009",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
