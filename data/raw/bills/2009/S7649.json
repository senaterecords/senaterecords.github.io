   "": {
    "actClause": "AN ACT to amend Jonathan's law, in relation to release of records pertaining to allegations and investigations of abuse and mistreatment occurring on or after January 1, 2003 and before May 5, 2007",
    "basePrintNo": "S7649",
    "basePrintNoStr": "S7649-2009",
    "coSponsors": {
