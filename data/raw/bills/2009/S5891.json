    "actClause": "AN ACT to amend the general municipal law, in relation to urban development action areas",
    "basePrintNo": "S5891",
    "basePrintNoStr": "S5891-2009",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
