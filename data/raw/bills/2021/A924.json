 "approvalMessage": {
  "approvalNumber": 66,
  "billId": {
   "basePrintNo": "A924",
   "basePrintNoStr": "A924-2021",
   "printNo": "A924A",
   "session": 2021,
   "version": "A"
  },
  "chapter": 676,
  "signer": "KATHY HOCHUL",
  "text": " \n                APPROVAL MEMORANDUM - No. 66 Chapter 676\n \n       MEMORANDUM filed with Assembly Bill Number 924-A, entitled:\n \n    \"AN  ACT  to  amend the public officers law, in relation to amending\n        the definition of a \"public body\"\"\n \n    APPROVED\n \n  This bill would expand the definition of \"public body\" to  include  an\nentity created or appointed to perform a necessary function in the deci-\nsion-making  process.  The  goal  of this bill is to expand upon govern-\nmental transparency by requiring more entities to be subject to the Open\nMeetings Law. My administration has made transparency  a  top  priority,\nand I fully support strengthening the Open Meetings Law so citizens have\naccess and transparency in government.\n \n  As passed, the bill did not contain a definition of the word \"entity\",\nwhich  has  different meanings in other sections of law. The legislature\nhas agreed to an amendment to the bill to clarify what such  term  means\nfor  purposes  of  this  section, and clarifies that an entity would not\nmean an individual.\n \n  Therefore, on the basis of that agreement, I am pleased to  sign  this\nbill.\n \n  This bill is approved.                         (signed) KATHY HOCHUL\n \n                                ______\n",
  "year": 2021
 },
