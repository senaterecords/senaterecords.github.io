       "sessionMemberId": 1822,
       "sessionYear": 2021,
       "shortName": "LIU"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 16,
       "fullName": "Toby Ann Stavisky",
       "imgName": "400_toby_ann_stavisky.jpg",
       "incumbent": true,
       "memberId": 400,
       "sessionMemberId": 1840,
       "sessionYear": 2021,
