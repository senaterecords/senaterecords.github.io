   "": {
    "actClause": "AN ACT to amend the public health law and the social services law, in relation\nto authorizing residents of assisted living programs to receive hospice\nservices",
    "basePrintNo": "S7626",
    "basePrintNoStr": "S7626-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 34,
       "fullName": "Alessandra Biaggi",
       "imgName": "1051_Alessandra_Biaggi.jpg",
       "incumbent": false,
