   "": {
    "actClause": "AN ACT to amend the navigation law, in relation to the base pilotage tariffs\nat Sandy Hook, Sands Point and Execution Rocks",
    "basePrintNo": "S8270",
    "basePrintNoStr": "S8270-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 63,
       "fullName": "Timothy M. Kennedy",
       "imgName": "429_timothy_m._kennedy.jpg",
       "incumbent": false,
       "memberId": 429,
       "sessionMemberId": 1819,
       "sessionYear": 2021,
       "shortName": "KENNEDY"
      }
