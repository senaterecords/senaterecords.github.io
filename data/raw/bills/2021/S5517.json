   "A": {
    "actClause": "AN ACT to amend the state finance law, in relation to certain contracts\ninvolving industrial painting and industrial coatings",
    "basePrintNo": "S5517",
    "basePrintNoStr": "S5517-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
