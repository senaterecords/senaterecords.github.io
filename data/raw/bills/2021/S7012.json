 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the public health law, in relation to persons responsible for\nthe disposition of the remains of a decedent",
    "basePrintNo": "S7012",
    "basePrintNoStr": "S7012-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §4201, Pub Health L",
    "lawSection": "Public Health Law",
    "memo": "\n \nBILL NUMBER: S7012\n\nSPONSOR: GAUGHRAN\n \nTITLE OF BILL:\n\nAn act to amend the public health law, in relation to persons responsi-\nble for the disposition of the remains of a decedent\n\n \nPURPOSE:\n\nTo establish a majority rules standard for disposition of remains\n\n \nSUMMARY OF PROVISIONS:\n\nSection one amends subdivision 2 of section 4201 of the public health\nlaw to create a majority rules standard in situations where multiple\nindividuals are eligible to control disposition of remains.\n\nSection two sets an immediate effective date.\n\n \nJUSTIFICATION:\n\nNew York's final disposition statute was enacted in 2006-07 to create a\nprocess allowing individuals to designate people to carry out their\nwishes regarding the disposition of their remains after death. It also\ncreated a list, in descending order of priority, of those authorized to\ncarry out such wishes in the absence of a written instrument.\n\nThere are, however, familial situations not addressed explicitly by the\ncurrent law. In order to avoid conflicts, more detailed guidance is\nneeded. This bill would allow majority control of a decedent's final\ndisposition when there are more than two people of the same degree of\nauthority, such as surviving children. This mirrors the recent enactment\nof a \"majority rules\" standard for anatomical gifts made by surviving\nfamily or others with authority to make such gifts.\n\n \nLEGISLATIVE HISTORY:\n\nNew bill\n\n \nFISCAL IMPLICATIONS:\n\nNone to the state.\n\n \nEFFECTIVE DATE:\nImmediate\n",
    "multiSponsors": {
