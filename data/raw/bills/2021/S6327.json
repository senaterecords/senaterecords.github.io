 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the public officers law, in relation to residency requirements\nfor certain peace officers in Putnam county",
    "basePrintNo": "S6327",
    "basePrintNoStr": "S6327-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §3-b, Pub Off L",
    "lawSection": "Public Officers Law",
    "memo": "\n \nBILL NUMBER: S6327\n\nSPONSOR: HARCKHAM\n \nTITLE OF BILL:\n\nAn act to amend the public officers law, in relation to residency\nrequirements for certain peace officers in Putnam county\n\n \nPURPOSE:\n\nRelates to residency requirements for certain peace officers in Putnam\ncounty SUMMARY OF PROVISIONS:\n\nSection 1. Amends the public officers law to allow that any person qual-\nified who resides in a county adjacent to the county of Putnam may at\nthe instance of the society for the prevention of cruelty to animals for\nthe county of Putnam be appointed as a peace officer by the appropriate\nappointing official in the county of Putnam\n\nSection 2. States the effective date\n\n \nJUSTIFICATION:\n\nCurrently, laws require peace officers to reside in the county they will\nbe serving. Lack of qualified individuals who reside in Putnam county\nrisk leaving the county underserved. This bill would allow any person\nwho resides in a county adjacent to Putnam county the ability to be\nappointed as a peace officer for the society for the prevention of\ncruelty to animals by the appropriate appointing official in the county\nof Putnam.\n\n \nLEGISLATIVE HISTORY:\n\n \nFISCAL IMPLICATIONS:\n\nNone\n\n \nEFFECTIVE DATE:\nThis act shall take effect immediately.\n",
    "multiSponsors": {
