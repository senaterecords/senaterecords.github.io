   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to penalties for\npurposefully obstructed license plates",
    "basePrintNo": "S4849",
    "basePrintNoStr": "S4849-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 8,
       "fullName": "John E. Brooks",
       "imgName": "923_John_Brooks.jpg",
       "incumbent": false,
       "memberId": 1101,
       "sessionMemberId": 1803,
       "sessionYear": 2021,
       "shortName": "BROOKS"
      }
     ],
     "size": 1
