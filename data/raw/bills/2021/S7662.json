   "": {
    "actClause": "AN ACT to amend the civil service law, in relation to requiring job\nopportunities to be posted on the department of civil service website for a\ncertain amount of time",
    "basePrintNo": "S7662",
    "basePrintNoStr": "S7662-2021",
