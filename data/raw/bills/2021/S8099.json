   "": {
    "actClause": "AN ACT to amend the general business law, in relation to authorizing the\nattorney general to bring an action for violation of the prohibitions\nconcerning unlawful selling practices and specifying damages awardable",
    "basePrintNo": "S8099",
    "basePrintNoStr": "S8099-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 54,
       "fullName": "Pamela Helming",
       "imgName": "773_Pamela_Helming.jpg",
       "incumbent": true,
       "memberId": 951,
       "sessionMemberId": 1812,
       "sessionYear": 2021,
       "shortName": "HELMING"
