   "": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to the\nretirement of members who serve as police medics, police medic supervisors and\nmembers who perform police medic related services in the Nassau county police\ndepartment",
    "basePrintNo": "S2934",
    "basePrintNoStr": "S2934-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
