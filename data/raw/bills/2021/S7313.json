   "": {
    "actClause": "AN ACT to amend the criminal procedure law and the penal law, in relation to\nrequiring written notice to a defendant of his or her right to complete court\nordered alcohol or substance abuse treatment in a nonreligious treatment\nprogram",
    "basePrintNo": "S7313",
    "basePrintNoStr": "S7313-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 5,
       "fullName": "Jim Gaughran",
       "imgName": "1042_Jim_Gaughran.jpg",
       "incumbent": false,
       "memberId": 1222,
       "sessionMemberId": 1807,
       "sessionYear": 2021,
       "shortName": "GAUGHRAN"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 28,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 1820,
       "sessionYear": 2021,
       "shortName": "KRUEGER"
      }
     ],
     "size": 2
