   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to requiring insurance coverage\nfor pre-exposure prophylaxis and post-exposure prophylaxis to prevent HIV\ninfection",
    "basePrintNo": "S688",
    "basePrintNoStr": "S688-2021",
