   "": {
    "actClause": "AN ACT to amend part E of chapter 417 of the laws of 2021 relating to\nauthorizing political subdivisions to permit any public body to hold meetings\nremotely and without in-person access during the COVID-19 state disaster\nemergency, in relation to the effectiveness thereof",
    "basePrintNo": "S7623",
    "basePrintNoStr": "S7623-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 27,
       "fullName": "Brad Hoylman-Sigal",
       "imgName": "438_brad_hoylman.jpg",
       "incumbent": false,
       "memberId": 438,
       "sessionMemberId": 1813,
       "sessionYear": 2021,
       "shortName": "HOYLMAN"
      }
     ],
     "size": 1
