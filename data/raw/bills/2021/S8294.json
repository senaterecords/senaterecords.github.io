   "A": {
    "actClause": "AN ACT in relation to renaming the 149th Street Grand Concourse subway station\nthe \"149th Street-Hostos station\"; and providing for the repeal of such\nprovisions upon the expiration thereof",
    "basePrintNo": "S8294",
    "basePrintNoStr": "S8294-2021",
    "coSponsors": {
