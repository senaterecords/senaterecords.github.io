   "": {
    "actClause": "AN ACT to amend the local finance law, in relation to the sale of bonds and\nnotes of the city of New York, the issuance of bonds or notes with variable\nrates of interest, interest rate exchange agreements of the city of New York,\nthe selling of bonds at private sale, the refunding of bonds, and the down\npayment for projects financed by bonds; to amend the New York state financial\nemergency act for the city of New York, in relation to a pledge and agreement\nof the state; and to amend chapter 142 of the laws of 2004, amending the local\nfinance law relating to interest rate exchange agreements of the city of New\nYork and refunding bonds of such city, in relation to the effectiveness\nthereof",
    "basePrintNo": "S9184",
    "basePrintNoStr": "S9184-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
