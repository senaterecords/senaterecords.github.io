   "": {
    "actClause": "AN ACT to amend the labor law, in relation to requiring employers to display a\nposter containing information on veterans' benefits and services which shall\nbe created and distributed by the department of labor",
    "basePrintNo": "S1961",
    "basePrintNoStr": "S1961-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
