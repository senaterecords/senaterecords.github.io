   "A": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to\nestablishing that an applicant for a license or permit shall not be deemed to\nlack control of the premises under certain circumstances",
    "basePrintNo": "S6353",
    "basePrintNoStr": "S6353-2021",
    "coSponsors": {
     "items": [],
