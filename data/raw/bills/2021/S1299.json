   "": {
    "actClause": "AN ACT to amend the labor law, in relation to regulations promulgated for\nsystematic and sustained efforts to find work for unemployment benefits",
    "basePrintNo": "S1299",
    "basePrintNoStr": "S1299-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
