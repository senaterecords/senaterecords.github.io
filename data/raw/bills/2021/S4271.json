   "": {
    "actClause": "AN ACT to authorize Timothy Colling to receive certain credit under section\n384-d of the retirement and social security law",
    "basePrintNo": "S4271",
    "basePrintNoStr": "S4271-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 63,
       "fullName": "Timothy M. Kennedy",
       "imgName": "429_timothy_m._kennedy.jpg",
       "incumbent": false,
       "memberId": 429,
       "sessionMemberId": 1819,
       "sessionYear": 2021,
       "shortName": "KENNEDY"
