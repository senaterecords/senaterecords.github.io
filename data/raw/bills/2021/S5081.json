 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend the social services law, in relation to information provided\nto unlicensed or unregistered child day care providers by the office of\nchildren and family services",
    "basePrintNo": "S5081",
    "basePrintNoStr": "S5081-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §390, Soc Serv L",
    "lawSection": "Social Services Law",
    "memo": "\n \nBILL NUMBER: S5081\n\nSPONSOR: BENJAMIN\n \nTITLE OF BILL:\n\nAn act to amend the social services law, in relation to information\nprovided to unlicensed or unregistered child day care providers by the\noffice of children and family services\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\nMandates the Office of Children and Family Services provide in multiple\nlanguages all necessary forms and applications.\n\n \nSUMMARY OF SPECIFIC PROVISIONS:\n\nSection 1 amends Section 390 of the social services law by adding new\nsubdivision 5-a, relating to information provided to unlicensed or\nunregistered child day care providers.\n\n§ 2 sets effective date.\n\n \nJUSTIFICATION:\n\nBecause the need for regulated child care providers spans various demo-\ngraphics, the forms and applications necessary for compliance should be\nmade available in multiple languages, including English, French, Polish,\nand the six most common non-English languages spoken by individuals with\nlimited-English proficiency in the state of New York, based on United\nStates census data.\n\n \nPRIOR LEGISLATIVE HISTORY:\n\n2019-20: A5113\n\n \nFISCAL IMPLICATIONS:\n\nNone.\n\n \nEFFECTIVE DATE:\nImmediately\n",
    "multiSponsors": {
