   "A": {
    "actClause": "AN ACT to authorize the New York state energy research and development\nauthority to prepare a report on the establishment of a New York renewable\nenergy laboratory",
    "basePrintNo": "S4479",
    "basePrintNoStr": "S4479-2021",
    "coSponsors": {
     "items": [],
     "size": 0
