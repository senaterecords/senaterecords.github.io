    "actClause": "AN ACT to amend the general municipal law and the retirement and social\nsecurity law, in relation to increasing certain special accidental death\nbenefits",
    "basePrintNo": "S9056",
    "basePrintNoStr": "S9056-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 54,
       "fullName": "Pamela Helming",
       "imgName": "773_Pamela_Helming.jpg",
