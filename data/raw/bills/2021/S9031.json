   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to the appointment of\nmembers of the Battery Park city authority",
    "basePrintNo": "S9031",
    "basePrintNoStr": "S9031-2021",
    "coSponsors": {
     "items": [],
     "size": 0
