   "": {
    "actClause": "AN ACT to amend the executive law, in relation to a report by the division for\nsmall business; and to amend chapter 731 of the laws of 2019 amending the\nexecutive law relating to regulatory fines for small businesses, in relation\nto the effectiveness thereof",
    "basePrintNo": "S6642",
    "basePrintNoStr": "S6642-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
