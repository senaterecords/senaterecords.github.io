   "": {
    "actClause": "AN ACT to amend the public health law, in relation to hospice residence\nin-patient beds",
    "basePrintNo": "S5506",
    "basePrintNoStr": "S5506-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
