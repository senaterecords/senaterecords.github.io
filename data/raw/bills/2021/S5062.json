   "": {
    "actClause": "AN ACT to amend the public service law, in relation to directing the\ncommission to establish standards and safeguards for certain radio and phone\nproviders to meet eligibility to provide lifeline services",
    "basePrintNo": "S5062",
    "basePrintNoStr": "S5062-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 5,
       "fullName": "Jim Gaughran",
       "imgName": "1042_Jim_Gaughran.jpg",
       "incumbent": false,
