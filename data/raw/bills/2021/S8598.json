   "": {
    "actClause": "AN ACT in relation to extending the boundaries of the Woodmere fire district\nto include the village of Woodsburgh",
    "basePrintNo": "S8598",
    "basePrintNoStr": "S8598-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "",
    "lawSection": "Villages",
    "memo": " \nBILL NUMBER: S8598\n\nSPONSOR: KAMINSKY\n \nTITLE OF BILL:\n\nAn act in relation to extending the boundaries of the Woodmere fire\ndistrict to include the village of Woodsburgh\n\n \nPURPOSE:\n\nNotwithstanding any statutory prohibition to the contrary, this bill\nwould allow the town of Hempstead to expand the Woodmere fire district's\nboundaries to include the village of Woodsburgh.\n\n \nSUMMARY OF PROVISIONS:\n\nSection 1. Authorizes the town of Hempstead to expand the boundaries of\nthe Woodmere fire district to cover and include the village of Woods-\nburgh.\n\nSection 2. The expanded fire district shall be subject to the provisions\nof article 11 of the town law. Section 3. Sets the effective date.\n\n \nJUSTIFICATION:\n\nThe Woodmere Fire District currently provides fire protection for the\nVillage of Woodsburgh under a contract. By expanding the Fire District\nto include the Village, Woodsburgh residents will be afforded the oppor-\ntunity to vote in Fire District elections, and accordingly, will be\ngiven a voice in how fire and emergency services are provided in their\ncommunity.\n\n \nPRIOR HISTORY:\n\nNew bill.\n\n \nFISCAL IMPLICATIONS:\n\nNone for the state.\n\n \nEFFECTIVE DATE:\nImmediately.\n",
