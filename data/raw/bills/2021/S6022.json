   "": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to\ndischarged LGBT veterans",
    "basePrintNo": "S6022",
    "basePrintNoStr": "S6022-2021",
    "coSponsors": {
     "items": [],
