 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT in relation to permitting Brentwood Fire District to file an\napplication for a retroactive real property tax exemption",
    "basePrintNo": "S6634",
    "basePrintNoStr": "S6634-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "",
    "lawSection": "Real Property Taxation",
    "memo": "\n \nBILL NUMBER: S6634\n\nSPONSOR: BOYLE\n \nTITLE OF BILL:\n\nAn act in relation to permitting Brentwood Fire District to file an\napplication for a retroactive real property tax exemption\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\nTo permit the Brentwood Fire District to file an application for a\nretroactive property tax exemption\n\n \nSUMMARY OF SPECIFIC PROVISIONS:\n\nSection 1. Authorizes the Islip town assessor to accept an application\nfor a retroactive real property tax exemption from the Brentwood Fire\nDistrict for the 2020-2021 assessment roll.\n\nSection 2. Establishes effective date.\n\n \nJUSTIFICATION:\n\nIn June 2020, the Brentwood Fire District purchased property on Howells\nRoad to construct a new fire district substation in place of the exist-\ning 70 year old substation. As a tax exempt organization, Brentwood Fire\nDistrict requests a retroactive tax exemption be granted.\n\n \nPRIOR LEGISLATIVE HISTORY:\n\nThis is a new bill.\n\n \nFISCAL IMPLICATIONS FOR STATE AND LOCAL GOVERNMENTS:\n\nNone\n\n \nEFFECTIVE DATE:\nImmediate\n",
    "multiSponsors": {
