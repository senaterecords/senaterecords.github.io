   "A": {
    "actClause": "AN ACT to amend the alcoholic beverage control law, in relation to authorizing\nthe manufacture of beer, spirits, cider, wine and mead at the Culinary\nInstitute of America; and to repeal certain provisions of such law relating\nthereto",
    "basePrintNo": "S8989",
    "basePrintNoStr": "S8989-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
