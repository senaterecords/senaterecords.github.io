   "": {
    "actClause": "AN ACT to direct the department of state and the public service commission to\njointly study and report upon the provision to consumer credit reporting\nagencies by public utility companies, cable television companies and cellular\ntelephone service suppliers of information on late payments of or default on\nany fees or charges incurred by consumers; and providing for the repeal of\nsuch provisions upon expiration thereof",
    "basePrintNo": "S2933",
    "basePrintNoStr": "S2933-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 28,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 1820,
       "sessionYear": 2021,
       "shortName": "KRUEGER"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 20,
       "fullName": "Zellnor Myrie",
       "imgName": "1048_Zellnor_Myrie.jpg",
       "incumbent": true,
       "memberId": 1228,
       "sessionMemberId": 1825,
       "sessionYear": 2021,
       "shortName": "MYRIE"
      }
     ],
     "size": 2
