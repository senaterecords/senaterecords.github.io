   "": {
    "actClause": "AN ACT in relation to authorizing the Town of Oyster Bay to grant Sai Mandir\nUSA a real property tax exemption",
    "basePrintNo": "S7110",
    "basePrintNoStr": "S7110-2021",
    "coSponsors": {
