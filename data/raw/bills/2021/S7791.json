   "": {
    "actClause": "AN ACT to amend the transportation law, in relation to requiring the\ndepartment of transportation to annually prepare and submit to the legislature\ncertain highway pavement and bridge condition reports",
    "basePrintNo": "S7791",
    "basePrintNoStr": "S7791-2021",
    "coSponsors": {
