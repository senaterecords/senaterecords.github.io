   "A": {
    "actClause": "AN ACT to amend the social services law, in relation to excluding certain\nkindergartens and pre-kindergartens from the definition of child day care",
    "basePrintNo": "S6415",
    "basePrintNoStr": "S6415-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 8,
