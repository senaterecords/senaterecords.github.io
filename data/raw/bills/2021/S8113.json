   "": {
    "actClause": "AN ACT to amend the public health law and the insurance law, in relation to\nthe definition of clinical peer reviewer",
    "basePrintNo": "S8113",
    "basePrintNoStr": "S8113-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 33,
       "fullName": "Gustavo Rivera",
       "imgName": "377_gustavo_rivera.jpg",
       "incumbent": true,
       "memberId": 377,
       "sessionMemberId": 1832,
       "sessionYear": 2021,
       "shortName": "RIVERA"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "James Skoufis",
       "imgName": "672_james_skoufis.jpg",
       "incumbent": true,
       "memberId": 1232,
       "sessionMemberId": 1839,
       "sessionYear": 2021,
       "shortName": "SKOUFIS"
      }
     ],
     "size": 2
