   "": {
    "actClause": "AN ACT to amend the town law, in relation to authorizing the increase of the\nnumber of town justices in the town of Rotterdam, Schenectady county",
    "basePrintNo": "S7083",
    "basePrintNoStr": "S7083-2021",
    "coSponsors": {
