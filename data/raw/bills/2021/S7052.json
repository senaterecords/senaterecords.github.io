 "approvalMessage": {
  "approvalNumber": 169,
  "billId": {
   "basePrintNo": "S7052",
   "basePrintNoStr": "S7052-2021",
   "printNo": "S7052",
   "session": 2021,
   "version": ""
  },
  "chapter": 832,
  "signer": "KATHY HOCHUL",
  "text": " \n                APPROVAL MEMORANDUM - No. 169 Chapter 832\n \n        MEMORANDUM filed with Senate Bill Number 7052, entitled:\n \n    \"AN  ACT  to  amend the civil practice law and rules, in relation to\n        insurance disclosures\"\n \n    APPROVED\n \n  This bill enacts the comprehensive insurance disclosure act which will\nrequire all parties provide  notice  and  proof  of  the  existence  and\ncontents  of  any insurance agreement, including coverage amounts, under\nwhich any person or entity may be liable to satisfy part  or  all  of  a\njudgment within sixty days of serving an answer in an action.\n \n  I agree with the intent of the bill and have reached an agreement with\nthe  Legislature  to  ensure  that  the  scope of the insurance coverage\ninformation that parties must  provide  is  properly  tailored  for  the\nintended  purpose,  which  is to insure that parties in a litigation are\ncorrectly informed about the limits of potential insurance coverage.\n \n  Based on this agreement, I am pleased to sign this bill.\n \n  This bill is approved.                         (signed) KATHY HOCHUL\n \n                                ______\n",
  "year": 2021
 },
