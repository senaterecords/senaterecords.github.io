   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to allowing victims of domestic\nviolence the opportunity to designate an alternate address for health\ninsurance claims or billing purposes",
    "basePrintNo": "S7263",
    "basePrintNoStr": "S7263-2021",
    "coSponsors": {
