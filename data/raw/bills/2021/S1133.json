   "": {
    "actClause": "AN ACT to amend the election law, in relation to directing that the use of a\ncandidate's alternate, familiar or anglicized name is permissible on electoral\nnominating petitions and ballots",
    "basePrintNo": "S1133",
    "basePrintNoStr": "S1133-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 34,
       "fullName": "Alessandra Biaggi",
