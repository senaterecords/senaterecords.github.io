      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 20,
       "fullName": "Zellnor Myrie",
       "imgName": "1048_Zellnor_Myrie.jpg",
       "incumbent": true,
       "memberId": 1228,
       "sessionMemberId": 1825,
       "sessionYear": 2021,
       "shortName": "MYRIE"
