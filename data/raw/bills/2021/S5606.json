   "": {
    "actClause": "AN ACT to amend the public health law, in relation to requiring hospitals\ndistribute literature created by the commissioner to patients at a high risk\nof sickle cell disease",
    "basePrintNo": "S5606",
    "basePrintNoStr": "S5606-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 8,
       "fullName": "John E. Brooks",
       "imgName": "923_John_Brooks.jpg",
       "incumbent": false,
