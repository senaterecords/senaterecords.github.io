    "actClause": "AN ACT to amend the social services law, in relation to school-based health\ncenters for purposes of managed care programs under medicaid",
    "basePrintNo": "S2127",
    "basePrintNoStr": "S2127-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
