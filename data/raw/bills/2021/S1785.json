   "": {
    "actClause": "AN ACT to amend the public health law, in relation to requiring infection\nupdates and infection control planning in residential health care facilities",
    "basePrintNo": "S1785",
    "basePrintNoStr": "S1785-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
