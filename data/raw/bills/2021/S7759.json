   "": {
    "actClause": "AN ACT to amend the penal law, in relation to the crime of falsifying COVID-19\nvaccination records",
    "basePrintNo": "S7759",
    "basePrintNoStr": "S7759-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 5,
       "fullName": "Jim Gaughran",
       "imgName": "1042_Jim_Gaughran.jpg",
       "incumbent": false,
       "memberId": 1222,
       "sessionMemberId": 1807,
       "sessionYear": 2021,
       "shortName": "GAUGHRAN"
      }
