       "sessionMemberId": 1852,
       "sessionYear": 2021,
       "shortName": "HINCHEY"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "James Skoufis",
       "imgName": "672_james_skoufis.jpg",
       "incumbent": true,
       "memberId": 1232,
