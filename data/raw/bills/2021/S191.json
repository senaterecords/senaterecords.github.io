    "actClause": "AN ACT to amend the state finance law and the banking law, in relation to\nauthorizing credit unions to participate in the excelsior linked deposit\nprogram",
    "basePrintNo": "S191",
    "basePrintNoStr": "S191-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 14,
       "fullName": "Leroy Comrie",
