   "": {
    "actClause": "AN ACT to amend the education law, in relation to requiring members of a board\nof trustees of public, free association and Indian libraries to complete two\nhours of continuing education per year",
    "basePrintNo": "S4435",
    "basePrintNoStr": "S4435-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Daphne Jordan",
