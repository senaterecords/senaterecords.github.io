    "actClause": "AN ACT to amend chapter 266 of the laws of 1981, amending the civil practice\nlaw and rules relating to time limitations, in relation to permanently\nextending time limitations for certain actions",
    "basePrintNo": "S9076",
    "basePrintNoStr": "S9076-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 3,
       "fullName": "Alexis Weik",
       "imgName": "1310_Alexis_Weik.jpg",
       "incumbent": true,
       "memberId": 1493,
       "sessionMemberId": 1848,
       "sessionYear": 2021,
       "shortName": "WEIK"
      }
     ],
     "size": 1
    },
    "fullText": "",
    "fullTextFormats": [],
