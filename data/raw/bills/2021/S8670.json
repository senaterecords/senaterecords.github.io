   "": {
    "actClause": "AN ACT to amend the banking law and the executive law, in relation to certain\nnotices and services upon application for a mortgage guaranteed under the\n\"Servicemen's Readjustment Act of 1944\"",
    "basePrintNo": "S8670",
    "basePrintNoStr": "S8670-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 53,
       "fullName": "Rachel May",
       "imgName": "1057_Rachel_May.jpg",
       "incumbent": true,
       "memberId": 1237,
       "sessionMemberId": 1823,
       "sessionYear": 2021,
       "shortName": "MAY"
      }
     ],
     "size": 1
