   "A": {
    "actClause": "AN ACT to amend the executive law, in relation to the publication of\ninformation regarding waivers of compliance with state contract provisions\nconcerning minority and women-owned business enterprise participation\nrequirements",
    "basePrintNo": "S4165",
    "basePrintNoStr": "S4165-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 50,
       "fullName": "John Mannion",
       "imgName": "1315_John_Mannion.jpg",
       "incumbent": false,
       "memberId": 1498,
       "sessionMemberId": 1854,
       "sessionYear": 2021,
       "shortName": "MANNION"
      }
     ],
