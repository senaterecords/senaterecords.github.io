   "": {
    "actClause": "AN ACT to amend the executive law, in relation to prohibiting discrimination\nbased on citizenship or immigration status",
    "basePrintNo": "S6586",
    "basePrintNoStr": "S6586-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
