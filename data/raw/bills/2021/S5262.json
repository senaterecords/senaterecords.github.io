    "actClause": "AN ACT to amend the general business law, in relation to the requirement that\ncertain health clubs shall have at least one automated external defibrillator\navailable upon the premises",
    "basePrintNo": "S5262",
    "basePrintNoStr": "S5262-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 3,
       "fullName": "Alexis Weik",
       "imgName": "1310_Alexis_Weik.jpg",
       "incumbent": true,
       "memberId": 1493,
       "sessionMemberId": 1848,
       "sessionYear": 2021,
       "shortName": "WEIK"
      }
