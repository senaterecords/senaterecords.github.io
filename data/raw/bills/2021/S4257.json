       "sessionYear": 2021,
       "shortName": "JACKSON"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 32,
       "fullName": "Luis R. Sepúlveda",
       "imgName": "493_Luis_Sepulveda.jpg",
       "incumbent": true,
       "memberId": 1142,
       "sessionMemberId": 1836,
       "sessionYear": 2021,
       "shortName": "SEPULVEDA"
