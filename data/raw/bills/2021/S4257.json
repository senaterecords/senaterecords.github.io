   "": {
    "actClause": "AN ACT to amend the administrative code of the city of New York, in relation\nto requiring contracts for a commercial lease",
    "basePrintNo": "S4257",
    "basePrintNoStr": "S4257-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 31,
       "fullName": "Robert Jackson",
       "imgName": "1050_Robert_Jackson.jpg",
       "incumbent": true,
       "memberId": 1230,
