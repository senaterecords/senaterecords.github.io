   "": {
    "actClause": "AN ACT in relation to directing the commissioner of agriculture and markets to\nwork with the state's land grant university system to produce a report to\nprovide recommendations on the state's farm and food supply; and to repeal\ncertain provisions of the agriculture and markets law relating thereto",
    "basePrintNo": "S1305",
    "basePrintNoStr": "S1305-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 57,
       "fullName": "George Borrello",
