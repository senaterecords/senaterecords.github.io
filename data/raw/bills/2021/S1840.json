   "": {
    "actClause": "AN ACT to amend the public service law, in relation to information cable\ntelevision companies must provide to subscribers regarding availability of\nrequired equipment at retail",
    "basePrintNo": "S1840",
    "basePrintNoStr": "S1840-2021",
    "coSponsors": {
     "items": [
