   "": {
    "actClause": "AN ACT to amend the mental hygiene law, in relation to the geriatric service\ndemonstration program to promote mental health and home care collaboration",
    "basePrintNo": "S4534",
    "basePrintNoStr": "S4534-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 50,
       "fullName": "John Mannion",
       "imgName": "1315_John_Mannion.jpg",
       "incumbent": false,
       "memberId": 1498,
       "sessionMemberId": 1854,
       "sessionYear": 2021,
       "shortName": "MANNION"
      }
