    "actClause": "AN ACT to amend the public health law, in relation to prohibiting smoking in\ncertain outdoor areas",
    "basePrintNo": "S4142",
    "basePrintNoStr": "S4142-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
