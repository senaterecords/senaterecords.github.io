   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to authorizing\ncities, villages and towns to reduce the speed limit to twenty-five miles per\nhour",
    "basePrintNo": "S2021",
    "basePrintNoStr": "S2021-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
