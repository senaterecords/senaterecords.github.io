   "": {
    "actClause": "AN ACT to amend the public health law, in relation to requiring chain\nrestaurants to label menu items that have a high content of sodium",
    "basePrintNo": "S2532",
    "basePrintNoStr": "S2532-2021",
    "coSponsors": {
     "items": [
