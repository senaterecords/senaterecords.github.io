   "": {
    "actClause": "AN ACT to amend the executive law, in relation to defining certain qualifying\nconditions for veterans",
    "basePrintNo": "S448",
    "basePrintNoStr": "S448-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
