   "": {
    "actClause": "AN ACT to amend the public service law, in relation to the public service\ncommission reviewing broadband and fiber optic services within the state",
    "basePrintNo": "S4878",
    "basePrintNoStr": "S4878-2021",
    "coSponsors": {
     "items": [
