   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to adding\ncertain wildlife management units to the yearling buck protection program",
    "basePrintNo": "S5694",
    "basePrintNoStr": "S5694-2021",
    "coSponsors": {
