   "": {
    "actClause": "AN ACT to amend the civil service law, in relation to the appointment and\npromotion of supervisors of the fire alarm dispatcher service",
    "basePrintNo": "S8685",
    "basePrintNoStr": "S8685-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 23,
       "fullName": "Diane J. Savino",
       "imgName": "403_diane_j._savino.jpg",
       "incumbent": false,
       "memberId": 403,
       "sessionMemberId": 1835,
       "sessionYear": 2021,
       "shortName": "SAVINO"
      }
     ],
     "size": 1
