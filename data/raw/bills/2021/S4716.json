   "": {
    "actClause": "AN ACT to amend the state technology law, in relation to requiring the office\nof information technology services to cooperate with other state agencies in\nthe implementation of language translation technology",
    "basePrintNo": "S4716",
    "basePrintNoStr": "S4716-2021",
    "coSponsors": {
     "items": [],
     "size": 0
