   "": {
    "actClause": "AN ACT to amend the general municipal law, in relation to urban development\naction areas",
    "basePrintNo": "S6644",
    "basePrintNoStr": "S6644-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Julia Salazar",
       "imgName": "1047_Julia_Salazar.jpg",
       "incumbent": true,
       "memberId": 1227,
       "sessionMemberId": 1833,
       "sessionYear": 2021,
       "shortName": "SALAZAR"
      }
     ],
     "size": 1
    },
    "fullText": "",
    "fullTextFormats": [],
