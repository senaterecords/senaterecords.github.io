   "": {
    "actClause": "AN ACT to establish a task force to identify evidence-based and evidence\ninformed solutions to reduce children's exposure to adverse childhood\nexperience",
    "basePrintNo": "S8320",
    "basePrintNoStr": "S8320-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Julia Salazar",
       "imgName": "1047_Julia_Salazar.jpg",
       "incumbent": true,
       "memberId": 1227,
       "sessionMemberId": 1833,
       "sessionYear": 2021,
       "shortName": "SALAZAR"
      }
