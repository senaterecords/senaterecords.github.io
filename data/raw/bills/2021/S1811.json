 "substitutedBy": null,
 "summary": "Authorizes the town of Blooming Grove to establish community preservation funds; establishes a real estate transfer tax with revenues therefrom to be deposited in said community preservation fund.",
 "title": "Relates to community preservation funds for the town of Blooming Grove",
 "vetoMessages": {
  "items": [
   {
