   "": {
    "actClause": "AN ACT to amend the economic development law, in relation to allowing for\neligibility of Green CHIPS projects in the Excelsior tax credit program",
    "basePrintNo": "S9467",
    "basePrintNoStr": "S9467-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 50,
       "fullName": "John Mannion",
       "imgName": "1315_John_Mannion.jpg",
