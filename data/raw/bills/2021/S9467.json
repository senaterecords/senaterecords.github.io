       "shortName": "MANNION"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 44,
       "fullName": "Neil D. Breslin",
       "imgName": "372_neil_d._breslin.jpg",
       "incumbent": false,
       "memberId": 372,
       "sessionMemberId": 1802,
       "sessionYear": 2021,
       "shortName": "BRESLIN"
      }
