   "": {
    "actClause": "AN ACT to amend the private housing finance law, in relation to authorizing\nadditional supervision and regulation of mutual companies",
    "basePrintNo": "S7831",
    "basePrintNoStr": "S7831-2021",
    "coSponsors": {
