   "": {
    "actClause": "AN ACT to amend the general municipal law, in relation to ensuring paid\nfirefighters of a county airport or county aviation department which perform\nfire response or fire rescue duties are eligible for equal benefits as other\npaid firefighters",
    "basePrintNo": "S1308",
    "basePrintNoStr": "S1308-2021",
    "coSponsors": {
     "items": [
