   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to requiring certain\ndirectors of the Roosevelt Island operating corporation to be residents of\nRoosevelt Island and to require the appointment of certain vacant board\npositions within sixty days",
    "basePrintNo": "S7622",
    "basePrintNoStr": "S7622-2021",
