   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to authorizing dividend paying\ndeferred income annuities",
    "basePrintNo": "S7744",
    "basePrintNoStr": "S7744-2021",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
