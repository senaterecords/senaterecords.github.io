   "": {
    "actClause": "AN ACT to amend the public health law, in relation to the securing of grease\ntraps and interceptors by food establishments",
    "basePrintNo": "S3536",
    "basePrintNoStr": "S3536-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 55,
       "fullName": "Samra Brouk",
