    "actClause": "AN ACT to amend the agriculture and markets law, in relation to the\nmanufacturing, sale, branding and labeling of beech sugar and beech syrup",
    "basePrintNo": "S5751",
    "basePrintNoStr": "S5751-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Daphne Jordan",
       "imgName": "1055_Daphne_Jordan.jpg",
       "incumbent": false,
