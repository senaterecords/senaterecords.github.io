   "": {
    "actClause": "AN ACT to amend the real property law, in relation to prohibiting mortgagees\nfrom requiring mortgagors of certain real property to purchase flood insurance\nexceeding certain limits",
    "basePrintNo": "S4696",
    "basePrintNoStr": "S4696-2021",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
       "incumbent": true,
       "memberId": 384,
       "sessionMemberId": 1795,
       "sessionYear": 2021,
       "shortName": "ADDABBO"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 53,
       "fullName": "Rachel May",
       "imgName": "1057_Rachel_May.jpg",
       "incumbent": true,
       "memberId": 1237,
       "sessionMemberId": 1823,
       "sessionYear": 2021,
       "shortName": "MAY"
      }
     ],
     "size": 2
