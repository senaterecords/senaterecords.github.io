   "": {
    "actClause": "AN ACT to authorize persons who are members or retirees of the New York State and Local Employees' Retirement System pursuant to administrative agreements between the Jefferson County Industrial Development Agency and certain development corporations or centers to continue to receive credit for service",
    "basePrintNo": "S7089",
    "basePrintNoStr": "S7089-2011",
    "coSponsors": {
