   "": {
    "actClause": "AN ACT to amend the public health law, in relation to capitated rates of payment for services provided by assisted living programs",
    "basePrintNo": "S4918",
    "basePrintNoStr": "S4918-2011",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
