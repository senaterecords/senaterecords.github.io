   "": {
    "actClause": "Concurrent Resolution of the Senate and Assembly proposing an amendment to section 6 of article 5 of the constitution, in relation to veterans' credits for civil service appointments and promotions",
    "basePrintNo": "S1311",
    "basePrintNoStr": "S1311-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 58,
