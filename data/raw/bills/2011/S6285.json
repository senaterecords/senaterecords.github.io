   "": {
    "actClause": "AN ACT to amend the executive law, in relation to contracts to disseminate certain advertising materials",
    "basePrintNo": "S6285",
    "basePrintNoStr": "S6285-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 22,
       "fullName": "Martin J. Golden",
       "imgName": "422_martin_j._golden.jpg",
       "incumbent": false,
