    "actClause": "AN ACT to amend the criminal procedure law and the executive law, in relation to DNA testing of certain offenders convicted of a crime",
    "basePrintNo": "S6733",
    "basePrintNoStr": "S6733-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 22,
       "fullName": "Martin J. Golden",
       "imgName": "422_martin_j._golden.jpg",
       "incumbent": false,
