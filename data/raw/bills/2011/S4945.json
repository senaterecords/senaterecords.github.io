   "": {
    "actClause": "AN ACT to amend the multiple dwelling law, in relation to interim multiple dwellings in a city with a population of one million or more persons",
    "basePrintNo": "S4945",
    "basePrintNoStr": "S4945-2011",
    "coSponsors": {
