   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to the disposal of real property to cure encroachments",
    "basePrintNo": "S6690",
    "basePrintNoStr": "S6690-2011",
    "coSponsors": {
     "items": [],
     "size": 0
