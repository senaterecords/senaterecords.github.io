   "": {
    "actClause": "AN ACT to amend chapter 624 of the laws of 2007 amending the arts and cultural affairs law relating to establishing a pilot grant program to help working artists secure shared use facilities, in relation to extending the effectiveness thereof",
    "basePrintNo": "S6821",
    "basePrintNoStr": "S6821-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Velmanette Montgomery",
       "imgName": "381_velmanette_montgomery.jpg",
       "incumbent": false,
       "memberId": 381,
       "sessionMemberId": 75,
       "sessionYear": 2011,
       "shortName": "MONTGOMERY"
      }
     ],
     "size": 1
