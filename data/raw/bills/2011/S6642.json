   "": {
    "actClause": "AN ACT in relation to authorizing the conveyance of real property at the State University of New York College of Environmental Science and Forestry",
    "basePrintNo": "S6642",
    "basePrintNoStr": "S6642-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 49,
       "fullName": "David J. Valesky",
       "imgName": "395_david_j._valesky.jpg",
       "incumbent": false,
       "memberId": 395,
       "sessionMemberId": 89,
       "sessionYear": 2011,
       "shortName": "VALESKY"
      }
