   "": {
    "actClause": "AN ACT to amend the civil service law, in relation to providing continuing coverage to spouse or dependents of public employees who are injured in the performance of duty or taken ill as a result of a performance of duty",
    "basePrintNo": "S5098",
    "basePrintNoStr": "S5098-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 40,
       "fullName": "Greg Ball",
       "imgName": "Greg Ball.jpg",
       "incumbent": false,
