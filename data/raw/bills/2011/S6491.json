   "": {
    "actClause": "AN ACT to amend the general municipal law and the vehicle and traffic law, in relation to authorizing the county of Rockland to regulate the registration and licensing of taxicabs, limousines, and livery vehicles",
    "basePrintNo": "S6491",
    "basePrintNoStr": "S6491-2011",
    "coSponsors": {
