   "": {
    "actClause": "AN ACT to amend chapter 89 of the laws of 2009 amending the tax law relating to the imposition of an occupancy tax in the city of Rye, in relation to extending the effectiveness thereof",
    "basePrintNo": "S5902",
    "basePrintNoStr": "S5902-2011",
    "coSponsors": {
