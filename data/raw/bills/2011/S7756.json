   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to the location for loading and unloading of bus passengers by an intercity bus",
    "basePrintNo": "S7756",
    "basePrintNoStr": "S7756-2011",
    "coSponsors": {
