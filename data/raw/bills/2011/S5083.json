   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to expanding the definition of aggravated cruelty to animals to include harm to animals during the commission of a felony",
    "basePrintNo": "S5083",
    "basePrintNoStr": "S5083-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
       "incumbent": true,
       "memberId": 384,
