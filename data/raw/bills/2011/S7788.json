   "": {
    "actClause": "AN ACT to amend part H of chapter 1 of the laws of 2003, amending the tax law relating to brownfield redevelopment tax credits, remediated brownfield credit for real property taxes for qualified sites and environmental remediation insurance credits, in relation to extending certain provisions thereof",
    "basePrintNo": "S7788",
    "basePrintNoStr": "S7788-2011",
