   "": {
    "actClause": "AN ACT to amend the correction law, in relation to requiring level two sex offenders to register their employment address and relating to certain requirements of distribution of the subdirectory",
    "basePrintNo": "S5775",
    "basePrintNoStr": "S5775-2011",
    "coSponsors": {
