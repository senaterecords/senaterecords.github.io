   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to creating the Syracuse regional airport authority",
    "basePrintNo": "S3250",
    "basePrintNoStr": "S3250-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 49,
       "fullName": "David J. Valesky",
