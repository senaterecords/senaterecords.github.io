   "": {
    "actClause": "AN ACT to amend chapter 219 of the laws of 2002 amending the judiciary law relating to the judicial hearing officer pilot program and the powers of the chief administrator of the courts, in relation to extending the expiration of the provisions of such chapter",
    "basePrintNo": "S4666",
    "basePrintNoStr": "S4666-2011",
