 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT in relation to allowing Richard Merrill and Frederick Akshar to join the special retirement plan for sheriffs, undersheriffs and deputy sheriffs",
    "basePrintNo": "S5719",
    "basePrintNoStr": "S5719-2011",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "",
    "lawSection": "Retirement",
    "memo": "BILL NUMBER:S5719\n\nTITLE OF BILL:\nAn act\nin relation to allowing Richard Merrill and Frederick Akshar to join the\nspecial retirement plan for sheriffs, undersheriffs and deputy sheriffs\n\nPURPOSE OR GENERAL IDEA OF BILL:\nTo re-open the Provisions of Section 551 of the\nRetirement and Social Security Law in order for the Broome\nCounty Legislature to correct an error wherein Richard Merrill and\nFrederick Akshar were inadvertently left out of the twenty year\nretirement option authorized by a Labor Agreement between the Broome\nCounty Legislature and the Broome County Sheriffs Law Enforcement\nOfficers Association Local 8500 by Resolution 684 of 2006.\n\nSUMMARY OF SPECIFIC PROVISIONS:\nRichard Merrill and Frederick Akshar,\nwho are each employed as a deputy sheriff in Broome County, and are\neach a member of the New York State and Local Employees Retirement\nSystem, shall each be eligible to individually join the special\nretirement plan for sheriffs, undersheriffs and deputy sheriffs if on\nor before December 31, 2011, they file a written request with the\nState Comptroller to that effect.\n\nJUSTIFICATION:\nThrough no fault of their own, these individuals\nfailed to make such election to join such retirement plan at the time\nof implementation.\n\nPRIOR LEGISLATIVE HISTORY:\nNew bill.\n\nFISCAL IMPLICATIONS:\nAll costs incurred will be borne by Broome County.\n\nEFFECTIVE DATE:\nImmediately.\n\n",
    "multiSponsors": {
     "items": [],
     "size": 0
    },
    "printNo": "S5719",
    "publishDate": "2011-06-13",
