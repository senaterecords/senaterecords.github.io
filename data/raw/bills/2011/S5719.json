   "A": {
    "actClause": "AN ACT to authorize the county of Broome to offer an optional twenty year retirement plan to deputy sheriffs Richard Merrell and Frederick Akshar",
    "basePrintNo": "S5719",
    "basePrintNoStr": "S5719-2011",
