    "actClause": "AN ACT to amend the state finance law, in relation to the cost effectiveness of consultant contracts by the state agencies",
    "basePrintNo": "S3093",
    "basePrintNoStr": "S3093-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
