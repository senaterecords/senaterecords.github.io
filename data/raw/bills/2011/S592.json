   "": {
    "actClause": "AN ACT to amend the education law, in relation to notice to school districts regarding intent to attend a charter school",
    "basePrintNo": "S592",
    "basePrintNoStr": "S592-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
       "memberId": 374,
       "sessionMemberId": 68,
       "sessionYear": 2011,
       "shortName": "LARKIN"
      }
