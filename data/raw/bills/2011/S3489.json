   "": {
    "actClause": "AN ACT to amend the public officers law, in relation to certain residency requirements for certain positions",
    "basePrintNo": "S3489",
    "basePrintNoStr": "S3489-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 13,
       "fullName": "José Peralta",
       "imgName": "428_jose_peralta.jpg",
