    "actClause": "AN ACT to amend the penal law, in relation to criminal contempt in the first degree",
    "basePrintNo": "S6674",
    "basePrintNoStr": "S6674-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 11,
       "fullName": "Tony Avella",
       "imgName": "391_tony_avella.jpg",
       "incumbent": false,
       "memberId": 391,
       "sessionMemberId": 85,
       "sessionYear": 2011,
       "shortName": "AVELLA"
      }
     ],
     "size": 1
    },
    "fullText": "",
    "fullTextFormats": [],
