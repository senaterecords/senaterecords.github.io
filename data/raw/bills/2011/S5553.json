   "": {
    "actClause": "AN ACT to amend the public health law, in relation to authorizing the commissioner of health to extend the use of audit findings to subsequent un-audit periods with regard to payments to patient service providers and assessments on covered lives",
    "basePrintNo": "S5553",
    "basePrintNoStr": "S5553-2011",
    "coSponsors": {
