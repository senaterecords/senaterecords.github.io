   "": {
    "actClause": "AN ACT to amend the public health law, in relation to medical assistance recoupments and reductions for home care services",
    "basePrintNo": "S6493",
    "basePrintNoStr": "S6493-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
       "memberId": 374,
       "sessionMemberId": 68,
       "sessionYear": 2011,
       "shortName": "LARKIN"
      }
     ],
     "size": 1
