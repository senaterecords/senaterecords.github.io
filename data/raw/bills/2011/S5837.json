   "": {
    "actClause": "AN ACT to amend the retirement and social security law and the tax law, in relation to the treatment of member contributions in accordance with the provisions of the Internal Revenue Code",
    "basePrintNo": "S5837",
    "basePrintNoStr": "S5837-2011",
    "coSponsors": {
