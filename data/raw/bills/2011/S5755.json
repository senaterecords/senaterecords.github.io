   "": {
    "actClause": "AN ACT to amend chapter 91 of the laws of 2008, amending the public health law, relating to establishing a task force on toll plaza air quality, in relation to the expiration thereof",
    "basePrintNo": "S5755",
    "basePrintNoStr": "S5755-2011",
    "coSponsors": {
