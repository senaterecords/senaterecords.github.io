   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to health insurance coverage for sole proprietors",
    "basePrintNo": "S5561",
    "basePrintNoStr": "S5561-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 37,
       "fullName": "Suzi Oppenheimer",
       "imgName": "Suzi Oppenheimer.jpg",
       "incumbent": false,
       "memberId": 388,
       "sessionMemberId": 82,
