    "actClause": "AN ACT to amend the public health law, in relation to hospital construction",
    "basePrintNo": "S4992",
    "basePrintNoStr": "S4992-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
