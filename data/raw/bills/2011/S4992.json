       "districtCode": 49,
       "fullName": "David J. Valesky",
       "imgName": "395_david_j._valesky.jpg",
       "incumbent": false,
       "memberId": 395,
       "sessionMemberId": 89,
       "sessionYear": 2011,
       "shortName": "VALESKY"
