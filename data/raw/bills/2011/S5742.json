   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to providing for the financing of construction of facilities for the Medical Missions for Children, Inc.",
    "basePrintNo": "S5742",
    "basePrintNoStr": "S5742-2011",
    "coSponsors": {
