   "A": {
    "actClause": "AN ACT in relation to authorizing the use of sewer surplus for infrastructure projects other than sewer projects in the Village of Sherburne",
    "basePrintNo": "S6578",
    "basePrintNoStr": "S6578-2011",
    "coSponsors": {
