   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to limiting the ownership or possession of companion animals by persons convicted of violating \"Buster's Law\"",
    "basePrintNo": "S5084",
    "basePrintNoStr": "S5084-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 15,
       "fullName": "Joseph P. Addabbo Jr.",
       "imgName": "384_joseph_p._addabbo_jr.jpg",
       "incumbent": true,
       "memberId": 384,
       "sessionMemberId": 78,
       "sessionYear": 2011,
       "shortName": "ADDABBO"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 62,
       "fullName": "George D. Maziarz",
       "imgName": "George D. Maziarz.jpg",
       "incumbent": false,
       "memberId": 411,
       "sessionMemberId": 105,
       "sessionYear": 2011,
       "shortName": "MAZIARZ"
