   "": {
    "actClause": "AN ACT to amend the public health law, in relation to referrals of patients for health or health related items or services",
    "basePrintNo": "S4660",
    "basePrintNoStr": "S4660-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 26,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 95,
       "sessionYear": 2011,
       "shortName": "KRUEGER"
      }
     ],
     "size": 1
