   "": {
    "actClause": "AN ACT to amend the elder law, in relation to the senior citizen energy packaging pilot program and making technical changes thereto; and to repeal section 221 of such law relating to the legislative intent underlying the senior citizen energy packaging pilot program",
    "basePrintNo": "S502",
    "basePrintNoStr": "S502-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
