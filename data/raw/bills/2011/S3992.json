   "A": {
    "actClause": "AN ACT to authorize the city of New York to lease certain parkland in the borough of the Bronx to the New York Botanical Garden for a term of 30 years",
    "basePrintNo": "S3992",
    "basePrintNoStr": "S3992-2011",
