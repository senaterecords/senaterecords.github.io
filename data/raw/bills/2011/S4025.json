   "": {
    "actClause": "AN ACT to create a temporary New York state War of 1812 200th anniversary commemoration commission to promote the 200th anniversary of the War of 1812",
    "basePrintNo": "S4025",
    "basePrintNoStr": "S4025-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 48,
       "fullName": "Patty Ritchie",
       "imgName": "423_patty_ritchie.jpg",
       "incumbent": false,
       "memberId": 423,
       "sessionMemberId": 117,
       "sessionYear": 2011,
       "shortName": "RITCHIE"
