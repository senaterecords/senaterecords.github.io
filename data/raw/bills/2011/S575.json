       "chamber": "SENATE",
       "districtCode": 26,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 95,
       "sessionYear": 2011,
       "shortName": "KRUEGER"
