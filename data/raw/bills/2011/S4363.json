   "A": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to requiring lawn care companies to provide information to the property owner prior to any commercial lawn application",
    "basePrintNo": "S4363",
    "basePrintNoStr": "S4363-2011",
    "coSponsors": {
     "items": [],
     "size": 0
