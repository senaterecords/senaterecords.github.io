   "": {
    "actClause": "AN ACT to amend the retirement and social security law, in relation to providing three-quarters of pension for police officers and firefighters who contract methicillin resistant staphylococcus aureus",
    "basePrintNo": "S7209",
    "basePrintNoStr": "S7209-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 62,
       "fullName": "George D. Maziarz",
       "imgName": "George D. Maziarz.jpg",
       "incumbent": false,
       "memberId": 411,
       "sessionMemberId": 105,
       "sessionYear": 2011,
       "shortName": "MAZIARZ"
      }
     ],
     "size": 1
