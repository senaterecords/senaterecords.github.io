   "B": {
    "actClause": "AN ACT to amend the real property tax law, in relation to restoration of tax exemption benefits to high density zoning districts, tax exemption benefits for new multiple dwellings and an exemption for certain multiple dwellings",
    "basePrintNo": "S5900",
    "basePrintNoStr": "S5900-2011",
    "coSponsors": {
     "items": [],
     "size": 0
