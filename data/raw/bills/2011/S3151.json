   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to convex mirrors",
    "basePrintNo": "S3151",
    "basePrintNoStr": "S3151-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 24,
       "fullName": "Andrew J. Lanza",
       "imgName": "409_andrew_j_lanza.jpg",
       "incumbent": true,
