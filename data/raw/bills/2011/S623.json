    "actClause": "AN ACT to amend the racing, pari-mutuel wagering and breeding law, in relation to antitrust exemptions for horse racing agreements",
    "basePrintNo": "S623",
    "basePrintNoStr": "S623-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 23,
       "fullName": "Diane J. Savino",
       "imgName": "403_diane_j._savino.jpg",
       "incumbent": false,
       "memberId": 403,
       "sessionMemberId": 97,
       "sessionYear": 2011,
       "shortName": "SAVINO"
      }
     ],
     "size": 1
