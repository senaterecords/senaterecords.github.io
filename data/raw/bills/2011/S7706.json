   "": {
    "actClause": "AN ACT in relation to authorizing the assessor of the county of Nassau to accept from Family Life Worship Cathedral Inc., an application for exemption from real property taxes",
    "basePrintNo": "S7706",
    "basePrintNoStr": "S7706-2011",
    "coSponsors": {
     "items": [],
     "size": 0
