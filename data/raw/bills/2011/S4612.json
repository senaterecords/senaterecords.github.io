   "": {
    "actClause": "AN ACT to amend the banking law, in relation to the exercise of federally permitted powers by a state chartered banking institution",
    "basePrintNo": "S4612",
    "basePrintNoStr": "S4612-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 11,
       "fullName": "Tony Avella",
       "imgName": "391_tony_avella.jpg",
       "incumbent": false,
