   "": {
    "actClause": "AN ACT to amend the county law, in relation to leases for the exploration and drilling for and extraction of natural gas and liquefied natural gas",
    "basePrintNo": "S3137",
    "basePrintNoStr": "S3137-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 62,
       "fullName": "George D. Maziarz",
       "imgName": "George D. Maziarz.jpg",
       "incumbent": false,
       "memberId": 411,
       "sessionMemberId": 105,
       "sessionYear": 2011,
       "shortName": "MAZIARZ"
      }
     ],
     "size": 1
