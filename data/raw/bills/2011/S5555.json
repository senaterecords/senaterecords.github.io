   "": {
    "actClause": "AN ACT to amend the public health law, in relation to allowing limited liability companies to operate renal disease diagnostic or treatment centers",
    "basePrintNo": "S5555",
    "basePrintNoStr": "S5555-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
