   "": {
    "actClause": "AN ACT to amend chapter 600 of the laws of 1993, amending the environmental conservation law relating to the management of bear, in relation to the effectiveness of such chapter",
    "basePrintNo": "S5332",
    "basePrintNoStr": "S5332-2011",
    "coSponsors": {
