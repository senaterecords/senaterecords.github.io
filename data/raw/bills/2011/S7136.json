   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to dogs engaged in hunting or training",
    "basePrintNo": "S7136",
    "basePrintNoStr": "S7136-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 53,
       "fullName": "Thomas F. O'Mara",
       "imgName": "415_thomas_f._o'mara.jpg",
