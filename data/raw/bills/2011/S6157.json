   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to disqualification of persons employed as school bus monitors and bus drivers",
    "basePrintNo": "S6157",
    "basePrintNoStr": "S6157-2011",
    "coSponsors": {
