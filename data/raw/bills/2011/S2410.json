   "": {
    "actClause": "AN ACT to amend the education law, in relation to the membership of the board of trustees of the state university of New York",
    "basePrintNo": "S2410",
    "basePrintNoStr": "S2410-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
       "memberId": 374,
       "sessionMemberId": 68,
       "sessionYear": 2011,
       "shortName": "LARKIN"
      }
     ],
     "size": 1
