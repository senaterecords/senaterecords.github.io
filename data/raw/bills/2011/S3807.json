   "A": {
    "actClause": "AN ACT to amend chapter 563 of the laws of 2008 amending the education law and the public health law relating to immunizing agents to be administered to adults by pharmacists, in relation to extending the expiration of such provisions",
    "basePrintNo": "S3807",
