   "": {
    "actClause": "AN ACT to amend the public health law, in relation to health-related legal services programs",
    "basePrintNo": "S5556",
    "basePrintNoStr": "S5556-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 21,
       "fullName": "Kevin S. Parker",
       "imgName": "416_kevin_s._parker.jpg",
       "incumbent": true,
       "memberId": 416,
       "sessionMemberId": 110,
       "sessionYear": 2011,
       "shortName": "PARKER"
      }
     ],
     "size": 1
