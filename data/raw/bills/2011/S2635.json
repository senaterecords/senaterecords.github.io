   "": {
    "actClause": "AN ACT to authorize the commissioner of general services to transfer and convey certain unappropriated state land to the Bay Shore union free school district",
    "basePrintNo": "S2635",
    "basePrintNoStr": "S2635-2011",
    "coSponsors": {
