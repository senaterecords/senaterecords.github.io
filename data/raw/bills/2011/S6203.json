   "": {
    "actClause": "AN ACT to amend the executive law, in relation to adding certain bodies of water to the definition of \"inland waterways\" for purposes of water-front revitalization",
    "basePrintNo": "S6203",
    "basePrintNoStr": "S6203-2011",
    "coSponsors": {
