   "": {
    "actClause": "AN ACT to amend the vehicle and traffic law, in relation to the biennial examinations of bus drivers employed by a motor carrier",
    "basePrintNo": "S4999",
    "basePrintNoStr": "S4999-2011",
    "coSponsors": {
