   "": {
    "actClause": "AN ACT to amend the general business law and the penal law, in relation to grand larceny in the fourth degree",
    "basePrintNo": "S6957",
    "basePrintNoStr": "S6957-2011",
    "coSponsors": {
     "items": [],
     "size": 0
