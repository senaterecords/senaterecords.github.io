   "": {
    "actClause": "AN ACT to amend chapter 158 of the laws of 1988 relating to establishment of a library district in the town of Hurley, Ulster county, in relation to changing the hours of the library's annual election and the organization of the board of trustees",
    "basePrintNo": "S4078",
    "basePrintNoStr": "S4078-2011",
    "coSponsors": {
