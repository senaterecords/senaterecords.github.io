   "": {
    "actClause": "AN ACT to amend the social services law, in relation to providing a model health care proxy form, living will or other comparable materials to individuals applying for medical assistance",
    "basePrintNo": "S4830",
    "basePrintNoStr": "S4830-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "William J. Larkin Jr.",
       "imgName": "374_william_j._larkin_jr.jpg",
       "incumbent": false,
       "memberId": 374,
       "sessionMemberId": 68,
       "sessionYear": 2011,
       "shortName": "LARKIN"
      }
     ],
     "size": 1
