   "": {
    "actClause": "AN ACT to amend the transportation law, in relation to the erection of certain towers on special parkway lands",
    "basePrintNo": "S2429",
    "basePrintNoStr": "S2429-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 11,
       "fullName": "Tony Avella",
