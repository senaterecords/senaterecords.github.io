   "": {
    "actClause": "AN ACT to amend the real property law, in relation to lapse of oil and gas interests in Allegany state park",
    "basePrintNo": "S2779",
    "basePrintNoStr": "S2779-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 28,
       "fullName": "José M. Serrano",
       "imgName": "373_jose_m._serrano.jpg",
       "incumbent": true,
       "memberId": 373,
       "sessionMemberId": 67,
       "sessionYear": 2011,
       "shortName": "SERRANO"
      }
     ],
     "size": 1
