   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to charitable bail organizations",
    "basePrintNo": "S7752",
    "basePrintNoStr": "S7752-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Velmanette Montgomery",
       "imgName": "381_velmanette_montgomery.jpg",
