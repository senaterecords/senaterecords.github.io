    "actClause": "AN ACT to amend the insurance law, in relation to investments by charitable gift annuity corporations or associations",
    "basePrintNo": "S5213",
    "basePrintNoStr": "S5213-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 7,
       "fullName": "Jack M. Martins",
       "imgName": "397_jack_m._martins.jpg",
       "incumbent": true,
       "memberId": 397,
       "sessionMemberId": 91,
       "sessionYear": 2011,
       "shortName": "MARTINS"
