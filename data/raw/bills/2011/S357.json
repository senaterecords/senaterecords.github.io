   "": {
    "actClause": "Concurrent Resolution of the Senate and Assembly proposing an amendment to section 14 of article 3 of the constitution, in relation to the manner of passing bills",
    "basePrintNo": "S357",
    "basePrintNoStr": "S357-2011",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
