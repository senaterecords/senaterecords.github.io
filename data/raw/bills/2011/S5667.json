   "": {
    "actClause": "AN ACT to amend the general municipal law, in relation to authorizing the disposal of computers through donation to not-for-profit institutions for use by senior citizens or low income individuals",
    "basePrintNo": "S5667",
    "basePrintNoStr": "S5667-2011",
    "coSponsors": {
