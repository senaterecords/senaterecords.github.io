   "": {
    "actClause": "AN ACT to amend the tax law, in relation to authorizing the county of Tompkins to continue imposing an additional one percent sales tax",
    "basePrintNo": "S4162",
    "basePrintNoStr": "S4162-2011",
    "coSponsors": {
