    "actClause": "AN ACT to amend the criminal procedure law and the correction law, in relation to the delivery of sentence and commitment documents",
    "basePrintNo": "S5542",
    "basePrintNoStr": "S5542-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 20,
       "fullName": "Eric Adams",
       "imgName": "Eric Adams.jpg",
       "incumbent": false,
       "memberId": 382,
       "sessionMemberId": 76,
       "sessionYear": 2011,
       "shortName": "ADAMS"
      }
     ],
     "size": 1
    },
    "fullText": "",
