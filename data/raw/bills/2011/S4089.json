    "actClause": "AN ACT to amend chapter 74 of the laws of 2007 amending the penal law, the criminal procedure law, the correction law, the social services law, and the executive law relating to human trafficking, in relation to extending the interagency task force on human trafficking for two years",
    "basePrintNo": "S4089",
    "basePrintNoStr": "S4089-2011",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 11,
       "fullName": "Tony Avella",
       "imgName": "391_tony_avella.jpg",
       "incumbent": false,
       "memberId": 391,
