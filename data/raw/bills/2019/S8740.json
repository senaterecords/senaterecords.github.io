   "": {
    "actClause": "AN ACT to amend the correction law, in relation to prohibiting the\ncommissioner of corrections and community supervision from promulgating policy\nto require inmates to waive religious rights in order to participate in inmate\nprograms",
    "basePrintNo": "S8740",
    "basePrintNoStr": "S8740-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 34,
       "fullName": "Alessandra Biaggi",
