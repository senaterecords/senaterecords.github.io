    "actClause": "AN ACT to amend the mental hygiene law and the executive law, in relation to\nrequiring legislative approval for the closure of certain office of mental\nhealth, office for people with developmental disabilities or office of\nchildren and family services facilities and institutions",
    "basePrintNo": "S5772",
    "basePrintNoStr": "S5772-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 52,
       "fullName": "Fredrick J. Akshar II",
       "imgName": "735_Fredrick_Akshar.jpg",
       "incumbent": false,
       "memberId": 913,
       "sessionMemberId": 1381,
       "sessionYear": 2019,
       "shortName": "AKSHAR"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Daphne Jordan",
       "imgName": "1055_Daphne_Jordan.jpg",
       "incumbent": false,
       "memberId": 1235,
       "sessionMemberId": 1233,
       "sessionYear": 2019,
       "shortName": "JORDAN"
      }
     ],
     "size": 2
