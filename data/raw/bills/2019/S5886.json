   "A": {
    "actClause": "AN ACT to amend the local finance law, in relation to establishing an\nelectronic open auction bond sale pilot program and providing for the repeal\nof such provisions upon expiration thereof",
    "basePrintNo": "S5886",
    "basePrintNoStr": "S5886-2019",
    "coSponsors": {
