 "substitutedBy": null,
 "summary": "Relates to the minimum requirements for a quorum; there shall be no less than a majority of the total number of members of the commission in order to transact any business, perform any duty or exercise any power.",
 "title": "Relates to the minimum requirements for a quorum",
 "vetoMessages": {
  "items": [
   {
    "billId": {
