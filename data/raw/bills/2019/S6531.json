 "substitutedBy": null,
 "summary": "Provides for pharmacy benefit management and the procurement of prescription drugs to be dispensed to patients, or the administration or management of prescription drug benefits; sets forth definitions; provides for funds received by a pharmacy in trust for the health plan or provider and provides for accountability of such funds; further provides for an appeals process to investigate and resolve disputes regarding multi-source generic drug pricing.",
 "title": "Provides for pharmacy benefit management and the procurement of prescription drugs at a negotiated rate for dispensation; repealer",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "S6531",
     "basePrintNoStr": "S6531-2019",
     "printNo": "S6531",
     "session": 2019,
