 "amendments": {
  "items": {
   "": {
    "actClause": "AN ACT to amend chapter 667 of the laws of 1868, relating to enabling Conrad\nPoppenhusen to found an institution in the village of College Point, in\nrelation to clarifying the name of such institution",
    "basePrintNo": "S7158",
    "basePrintNoStr": "S7158-2019",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §2, Chap 667 of 1868",
    "lawSection": "Queens County",
    "memo": "\n \nBILL NUMBER: S7158               REVISED 01/10/2020\n\nSPONSOR: LIU\n \nTITLE OF BILL:\n\nAn act to amend chapter 667 of the laws of 1868, relating to enabling\nConrad Poppenhusen to found an institution in the village of College\nPoint, in relation to clarifying the name of such institution\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\nTo clarify the name of \"The Conrad Poppenhusen Association\" to remove\nthe word \"The\" from the official legal name to better align with the\nname used in practice.\n\n \nJUSTIFICATION:\n\nThe \"Conrad Poppenhusen Association\" was created through an act of\nlegislation in 1868 and has operated under that name for at least the\nlast 50 years. This bill corrects a capitalization of \"The\" in the\noriginal legislation to make the official name the \"Conrad Poppenhusen\nAssociation\" instead of \"The Conrad Poppenhusen Association\"\n\n \nPRIOR LEGISLATIVE H.STORY:\n\nNew Bill\n\n \nFISCAL IMPLICATIONS FOR STATE AND LOCAL GOVERNMENTS:\n\nNone\n\n \nEFFECTIVE DATE:\nThis act shall take effect immediately.\n",
    "multiSponsors": {
