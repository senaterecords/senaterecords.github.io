   "": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the\nstate highway system in Oneida county as the \"Kevin F. Crossley Memorial\nHighway\"",
    "basePrintNo": "S3220",
    "basePrintNoStr": "S3220-2019",
    "coSponsors": {
     "items": [],
     "size": 0
