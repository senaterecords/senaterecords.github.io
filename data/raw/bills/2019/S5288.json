   "": {
    "actClause": "AN ACT to amend the highway law, in relation to designating a portion of the\nstate highway system as \"Melvin Harris, Jr. Way\"",
    "basePrintNo": "S5288",
    "basePrintNoStr": "S5288-2019",
    "coSponsors": {
