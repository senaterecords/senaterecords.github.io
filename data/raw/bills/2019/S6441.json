   "": {
    "actClause": "AN ACT in relation to authorizing the town of Ithaca, county of Tompkins, to\nalienate and convey certain parcels of land used as parklands",
    "basePrintNo": "S6441",
    "basePrintNoStr": "S6441-2019",
