   "": {
    "actClause": "AN ACT to amend the judiciary law, in relation to expanding the functions of\nthe chief administrator of the courts to include the compilation of certain\ndata with respect to ethnicity, race, disability, veteran status, gender,\ngender identity, and sexual orientation by specific jurisdiction and submit an\nannual report of his or her findings",
    "basePrintNo": "S7703",
    "basePrintNoStr": "S7703-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 32,
       "fullName": "Luis R. Sepúlveda",
       "imgName": "493_Luis_Sepulveda.jpg",
       "incumbent": true,
       "memberId": 1142,
       "sessionMemberId": 1197,
       "sessionYear": 2019,
       "shortName": "SEPULVEDA"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 7,
       "fullName": "Anna Kaplan",
       "imgName": "1044_Anna_Kaplan.jpg",
       "incumbent": false,
       "memberId": 1224,
       "sessionMemberId": 1222,
