   "": {
    "actClause": "AN ACT to amend the public health law, in relation to hospital domestic\nviolence policies and procedures",
    "basePrintNo": "S3962",
    "basePrintNoStr": "S3962-2019",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
