   "": {
    "actClause": "AN ACT to amend chapter 2 of the laws of 1998, amending the public health law\nand other laws relating to expanding the child health insurance plan, in\nrelation to the effectiveness thereof",
    "basePrintNo": "S6485",
    "basePrintNoStr": "S6485-2019",
    "coSponsors": {
