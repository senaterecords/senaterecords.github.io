   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to extending\nthe authority of the department of environmental conservation to manage fish",
    "basePrintNo": "S6348",
    "basePrintNoStr": "S6348-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
       "imgName": "370_david_carlucci.jpg",
