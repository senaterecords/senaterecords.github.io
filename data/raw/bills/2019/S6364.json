    "actClause": "AN ACT to amend the environmental conservation law, in relation to extending\nthe authority of the department of environmental conservation to manage\noysters",
    "basePrintNo": "S6364",
    "basePrintNoStr": "S6364-2019",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
