   "": {
    "actClause": "AN ACT to amend the social services law, in relation to requiring the\nanchoring of furniture and electronics in child day care centers, public\ninstitutions for children and certain other facilities",
    "basePrintNo": "S3563",
    "basePrintNoStr": "S3563-2019",
    "coSponsors": {
     "items": [
      {
