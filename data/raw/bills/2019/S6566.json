   "": {
    "actClause": "AN ACT to amend the Hudson river park act, in relation to development or\nredevelopment of Pier 40 in the Hudson river park",
    "basePrintNo": "S6566",
    "basePrintNoStr": "S6566-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 27,
       "fullName": "Brad Hoylman-Sigal",
       "imgName": "438_brad_hoylman.jpg",
       "incumbent": false,
       "memberId": 438,
       "sessionMemberId": 1190,
       "sessionYear": 2019,
       "shortName": "HOYLMAN"
      }
     ],
     "size": 1
