   "": {
    "actClause": "AN ACT to amend the not-for-profit corporation law, in relation to the\nregulation of key persons",
    "basePrintNo": "S2267",
    "basePrintNoStr": "S2267-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 61,
       "fullName": "Michael H. Ranzenhofer",
       "imgName": "406_michael_h._ranzenhofer.jpg",
       "incumbent": false,
       "memberId": 406,
       "sessionMemberId": 1285,
       "sessionYear": 2019,
       "shortName": "RANZENHOFER"
      }
