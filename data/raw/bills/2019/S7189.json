    "actClause": "AN ACT to amend the environmental conservation law, in relation to the\nreduction of mercury in mercury-added lamps",
    "basePrintNo": "S7189",
    "basePrintNoStr": "S7189-2019",
    "coSponsors": {
     "items": [
