   "": {
    "actClause": "AN ACT to amend the real property actions and proceedings law, in relation to\nestablishing time restrictions for court issued consent orders for work\nperformance to remove or remedy conditions in such petition",
    "basePrintNo": "S3320",
    "basePrintNoStr": "S3320-2019",
    "coSponsors": {
     "items": [
