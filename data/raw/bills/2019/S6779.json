   "": {
    "actClause": "AN ACT to amend the public health law and the insurance law, in relation to\nprohibiting health insurers from requiring prior authorization for\npre-exposure prophylaxis used to prevent HIV infection",
    "basePrintNo": "S6779",
    "basePrintNoStr": "S6779-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 31,
       "fullName": "Robert Jackson",
       "imgName": "1050_Robert_Jackson.jpg",
       "incumbent": true,
       "memberId": 1230,
       "sessionMemberId": 1228,
       "sessionYear": 2019,
       "shortName": "JACKSON"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 33,
       "fullName": "Gustavo Rivera",
       "imgName": "377_gustavo_rivera.jpg",
       "incumbent": true,
       "memberId": 377,
       "sessionMemberId": 1196,
       "sessionYear": 2019,
       "shortName": "RIVERA"
      }
