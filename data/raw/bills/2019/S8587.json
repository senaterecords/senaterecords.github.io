   "": {
    "actClause": "AN ACT to amend the general obligations law, in relation to declaring\nagreements exempting employers from liability for negligence related to the\nCOVID-19 pandemic void and unenforceable",
    "basePrintNo": "S8587",
    "basePrintNoStr": "S8587-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 34,
       "fullName": "Alessandra Biaggi",
       "imgName": "1051_Alessandra_Biaggi.jpg",
       "incumbent": false,
