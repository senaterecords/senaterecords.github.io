       "sessionMemberId": 1229,
       "sessionYear": 2019,
       "shortName": "BIAGGI"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
       "imgName": "370_david_carlucci.jpg",
       "incumbent": false,
