   "": {
    "actClause": "AN ACT to amend the financial services law, in relation to immunity from civil\nliability for certain information relating to insurance or banking violations",
    "basePrintNo": "S3505",
    "basePrintNoStr": "S3505-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 51,
       "fullName": "James L. Seward",
       "imgName": "371_james_l._seward.jpg",
       "incumbent": false,
       "memberId": 371,
       "sessionMemberId": 1279,
       "sessionYear": 2019,
       "shortName": "SEWARD"
