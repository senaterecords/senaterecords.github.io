    "actClause": "AN ACT to amend the labor law, in relation to penalties for wilful false\nstatements for unemployment purposes",
    "basePrintNo": "S4992",
    "basePrintNoStr": "S4992-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 31,
       "fullName": "Robert Jackson",
       "imgName": "1050_Robert_Jackson.jpg",
       "incumbent": true,
