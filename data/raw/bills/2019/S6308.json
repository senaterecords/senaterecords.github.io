   "": {
    "actClause": "AN ACT to amend the environmental conservation law, in relation to prohibiting\ncoal tar in pavement products",
    "basePrintNo": "S6308",
    "basePrintNoStr": "S6308-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 28,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 1206,
       "sessionYear": 2019,
       "shortName": "KRUEGER"
      }
     ],
     "size": 1
