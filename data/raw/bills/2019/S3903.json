    "actClause": "AN ACT to amend the election law, in relation to requiring campaign finance\ninformation of certain candidates or committees to be filed on an electronic\nreporting system",
    "basePrintNo": "S3903",
    "basePrintNoStr": "S3903-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
       "imgName": "370_david_carlucci.jpg",
       "incumbent": false,
       "memberId": 370,
       "sessionMemberId": 1191,
       "sessionYear": 2019,
       "shortName": "CARLUCCI"
      }
     ],
     "size": 1
