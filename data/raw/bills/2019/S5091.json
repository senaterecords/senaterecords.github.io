   "": {
    "actClause": "AN ACT to amend the education law, in relation to requiring pharmacies to\nnotify patients of certain drug recalls",
    "basePrintNo": "S5091",
    "basePrintNoStr": "S5091-2019",
    "coSponsors": {
     "items": [],
     "size": 0
