   "A": {
    "actClause": "AN ACT to amend the real property tax law, in relation to authorizing\nmunicipalities to restrict the definitions of \"commercial purpose or use\" and\n\"mixed-use property\"",
    "basePrintNo": "S5254",
    "basePrintNoStr": "S5254-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 53,
