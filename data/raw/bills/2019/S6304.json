   "": {
    "actClause": "AN ACT to amend the tax law, in relation to revising the period of\nauthorization for the county of Westchester's additional one percent rate of\nsales and compensating use tax and the expiration of the Westchester county\nspending limitation act; to amend chapter 272 of the laws of 1991, amending\nthe tax law relating to the method of disposition of sales and compensating\nuse tax revenue in Westchester county and enacting the Westchester county\nspending limitation act, in relation to revising the period of authorization\nfor the county of Westchester's additional one percent rate of sales; and to\namend a chapter of the laws of 2019, amending the tax law relating to\nauthorizing the county of Westchester to impose an additional rate of sales\nand compensating use tax, as proposed in legislative bills numbers S.4940-B\nand A.7081, in relation to the period of authorization for Westchester's\nadditional one percent rate of sales",
    "basePrintNo": "S6304",
    "basePrintNoStr": "S6304-2019",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
