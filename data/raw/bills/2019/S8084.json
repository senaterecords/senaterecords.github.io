   "": {
    "actClause": "AN ACT to amend the public authorities law, in relation to the construction\nand financing of facilities by the dormitory authority for the Victor\nFarmington Library",
    "basePrintNo": "S8084",
    "basePrintNoStr": "S8084-2019",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
    "fullTextTemplate": "",
    "lawCode": "Amd §§1676 & 1680, Pub Auth L",
    "lawSection": "Public Authorities Law",
    "memo": "\n \nBILL NUMBER: S8084\n\nSPONSOR: FUNKE\n \nTITLE OF BILL:\n\nAn act to amend the public authorities law, in relation to the\nconstruction and financing of facilities by the dormitory authority for\nthe Victor Farmington Library\n\n \nPURPOSE OR GENERAL IDEA OF BILL:\n\nTo allow for the financing of construction projects for the Victor Farm-\nington Library by the New York State Dormitory Authority\n\n \nSUMMARY OF PROVISIONS:\n\nSection 1 - Authorizes the Victor Farmington Library to participate in\nfinancing offered by the Dormitory Authority of the State of New York\n\nSection 2 - Sets forth the effective date\n\n \nJUSTIFICATION:\n\nThe Victor Farmington Library requested this legislation to assist them\nas they move forward with major renovations and new construction. If\nsuccessful their participation in DASNY financing will provide stability\nto the project and save taxpayers money on interest when compared with a\nprivate sector loan.\n\n \nPRIOR LEGISLATIVE HISTORY:\n\nThis is a new bill\n\n \nFISCAL IMPLICATIONS:\n\nNone.\n\n \nEFFECTIVE DATE:  Immediately\n",
    "multiSponsors": {
     "items": [],
     "size": 0
    },
    "printNo": "S8084",
    "publishDate": "2020-03-17",
