    "actClause": "AN ACT to amend part B of chapter 57 of the laws of 2018, amending the public\nhealth law and other laws relating to registration of licensed home care\nservices agencies, in relation to the moratorium on the processing and\napproval of applications",
    "basePrintNo": "S1820",
    "basePrintNoStr": "S1820-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 39,
       "fullName": "James Skoufis",
