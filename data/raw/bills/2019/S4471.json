   "": {
    "actClause": "AN ACT to amend the public health law and the environmental conservation law,\nin relation to allowing donate life registration when applying for or renewing\na hunting, fishing or trapping license",
    "basePrintNo": "S4471",
    "basePrintNoStr": "S4471-2019",
