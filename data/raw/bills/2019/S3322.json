   "": {
    "actClause": "AN ACT to amend the general municipal law, in relation to including lakes in\nadopt-a-municipal park, shoreline or roadway programs",
    "basePrintNo": "S3322",
    "basePrintNoStr": "S3322-2019",
    "coSponsors": {
