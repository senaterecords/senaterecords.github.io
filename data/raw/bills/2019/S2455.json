   "": {
    "actClause": "AN ACT to amend the general business law, in relation to prohibiting consumer\ncontract provisions waiving the consumer's right to make statements concerning\ngoods or services",
    "basePrintNo": "S2455",
    "basePrintNoStr": "S2455-2019",
    "coSponsors": {
     "items": [
