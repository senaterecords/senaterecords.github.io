   "": {
    "actClause": "AN ACT to implement a constitutional amendment authorizing the placement of\npublic utility lines and bike paths in the forest preserve and establishing a\nhealth and safety land account",
    "basePrintNo": "S6398",
    "basePrintNoStr": "S6398-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 45,
       "fullName": "Betty Little",
       "imgName": "379_betty_little.jpg",
