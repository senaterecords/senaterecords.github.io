   "": {
    "actClause": "AN ACT to amend the public health law, in relation to requiring parity in the\nstandards of dental telehealth services",
    "basePrintNo": "S7879",
    "basePrintNoStr": "S7879-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 34,
       "fullName": "Alessandra Biaggi",
