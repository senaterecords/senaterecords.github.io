   "": {
    "actClause": "AN ACT to amend chapter 374 of the laws of 2014 amending the education law\nrelating to the leasing of real property by boards of cooperative education\nservices, in relation to extending the effectiveness thereof",
    "basePrintNo": "S5323",
    "basePrintNoStr": "S5323-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Daphne Jordan",
       "imgName": "1055_Daphne_Jordan.jpg",
       "incumbent": false,
       "memberId": 1235,
       "sessionMemberId": 1233,
       "sessionYear": 2019,
       "shortName": "JORDAN"
      }
     ],
     "size": 1
