   "": {
    "actClause": "AN ACT to amend the multiple residence law, in relation to unlawful occupation",
    "basePrintNo": "S2576",
    "basePrintNoStr": "S2576-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
       "imgName": "370_david_carlucci.jpg",
       "incumbent": false,
       "memberId": 370,
       "sessionMemberId": 1191,
       "sessionYear": 2019,
       "shortName": "CARLUCCI"
