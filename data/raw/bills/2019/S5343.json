 "substitutedBy": null,
 "summary": "Relates to prohibiting the use of chlorpyrifos by aerial application by January 1, 2020; prohibits all use except for apple tree trunks by January 1, 2021 and prohibits any use of chlorpyrifos by December 1, 2021.",
 "title": "Relates to prohibiting the use of chlorpyrifos",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "S5343",
     "basePrintNoStr": "S5343-2019",
     "printNo": "S5343",
     "session": 2019,
