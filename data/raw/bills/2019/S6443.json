    "actClause": "AN ACT to amend the social services law, in relation to exempting income\nearned by persons under the age of twenty-four from certain workforce\ndevelopment programs from the determination of need for public assistance\nprograms",
    "basePrintNo": "S6443",
    "basePrintNoStr": "S6443-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
