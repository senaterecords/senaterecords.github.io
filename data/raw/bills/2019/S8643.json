   "A": {
    "actClause": "AN ACT to amend the social services law, in relation to requiring the\ncommissioner to prepare a report of the sheltered and unsheltered homeless\npopulation during a state disaster emergency",
    "basePrintNo": "S8643",
    "basePrintNoStr": "S8643-2019",
