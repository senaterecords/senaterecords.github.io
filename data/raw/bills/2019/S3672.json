   "": {
    "actClause": "AN ACT to amend the county law, in relation to assignment of counsel",
    "basePrintNo": "S3672",
    "basePrintNoStr": "S3672-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Julia Salazar",
       "imgName": "1047_Julia_Salazar.jpg",
       "incumbent": true,
       "memberId": 1227,
       "sessionMemberId": 1225,
       "sessionYear": 2019,
       "shortName": "SALAZAR"
      }
     ],
     "size": 1
    },
    "fullText": "",
    "fullTextFormats": [],
