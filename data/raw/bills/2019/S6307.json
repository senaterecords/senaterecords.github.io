    "actClause": "AN ACT to amend the general business law, in relation to requiring domestic\nviolence and sexual assault awareness education for persons engaged in the\npractice of nail specialty, waxing, natural hair styling, esthetics and\ncosmetology",
    "basePrintNo": "S6307",
    "basePrintNoStr": "S6307-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 19,
       "fullName": "Roxanne J. Persaud",
