    "actClause": "AN ACT to amend the domestic relations law and the civil rights law, in\nrelation to name changes upon marriage",
    "basePrintNo": "S2505",
    "basePrintNoStr": "S2505-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
