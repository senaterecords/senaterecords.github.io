   "": {
    "actClause": "AN ACT to amend a chapter of the laws of 2019 establishing the 400 Years of\nAfrican-American History Commission, in relation to the amount of members of\nsuch commission, the deadline such commission shall submit reports of its\nfindings and to the effectiveness thereof",
    "basePrintNo": "S6948",
    "basePrintNoStr": "S6948-2019",
    "coSponsors": {
     "items": [],
     "size": 0
