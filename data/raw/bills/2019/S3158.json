   "": {
    "actClause": "AN ACT to amend the public health law and the insurance law, in relation to\npremium reduction for obstetric practitioners who complete a risk management\nstrategies course",
    "basePrintNo": "S3158",
    "basePrintNoStr": "S3158-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 34,
       "fullName": "Alessandra Biaggi",
