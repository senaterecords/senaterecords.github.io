   "": {
    "actClause": "AN ACT to amend the general business law, in relation to notices pertaining to\nchildren's non-regulated camp",
    "basePrintNo": "S1140",
    "basePrintNoStr": "S1140-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
