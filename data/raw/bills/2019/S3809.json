   "": {
    "actClause": "AN ACT to amend chapter 537 of the laws of 2008, amending the education law\nrelating to a restricted dental faculty license, in relation to making such\nprovisions permanent",
    "basePrintNo": "S3809",
    "basePrintNoStr": "S3809-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 28,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 1206,
       "sessionYear": 2019,
       "shortName": "KRUEGER"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 25,
       "fullName": "Velmanette Montgomery",
       "imgName": "381_velmanette_montgomery.jpg",
       "incumbent": false,
       "memberId": 381,
       "sessionMemberId": 1195,
       "sessionYear": 2019,
       "shortName": "MONTGOMERY"
      }
     ],
     "size": 2
