    "actClause": "AN ACT to amend the executive law, in relation to expanding the scope of\nunlawful discriminatory practices to include public educational institutions",
    "basePrintNo": "S4901",
    "basePrintNoStr": "S4901-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 10,
       "fullName": "James Sanders Jr.",
       "imgName": "432_james_sanders_jr.jpg",
       "incumbent": true,
       "memberId": 432,
       "sessionMemberId": 1208,
       "sessionYear": 2019,
       "shortName": "SANDERS"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 27,
       "fullName": "Brad Hoylman-Sigal",
       "imgName": "438_brad_hoylman.jpg",
       "incumbent": false,
       "memberId": 438,
       "sessionMemberId": 1190,
       "sessionYear": 2019,
       "shortName": "HOYLMAN"
      }
     ],
     "size": 2
