   "": {
    "actClause": "AN ACT to amend the executive law, in relation to the listing of county and\ncity veterans' service agencies",
    "basePrintNo": "S2405",
    "basePrintNoStr": "S2405-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 43,
       "fullName": "Daphne Jordan",
       "imgName": "1055_Daphne_Jordan.jpg",
       "incumbent": false,
       "memberId": 1235,
       "sessionMemberId": 1233,
       "sessionYear": 2019,
       "shortName": "JORDAN"
      }
     ],
     "size": 1
