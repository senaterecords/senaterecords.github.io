   "": {
    "actClause": "AN ACT to amend chapter 413 of the laws of 2003 amending the labor law\nrelating to the self-employment assistance program and other matters, in\nrelation to extending the effectiveness thereof",
    "basePrintNo": "S6020",
    "basePrintNoStr": "S6020-2019",
