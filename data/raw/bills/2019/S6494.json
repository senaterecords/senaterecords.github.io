   "": {
    "actClause": "AN ACT to amend chapter 498 of the laws of 2017 authorizing the New York state\nthruway authority to convey real property to Rye Country Day School, in\nrelation to requiring the Rye Country Day School to make the athletic field\nand track available for rental to public recreation groups for a certain\namount of time per year",
    "basePrintNo": "S6494",
    "basePrintNoStr": "S6494-2019",
    "coSponsors": {
     "items": [],
     "size": 0
    },
    "fullText": "",
    "fullTextFormats": [],
