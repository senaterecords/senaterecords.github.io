   "": {
    "actClause": "AN ACT authorizing the commissioner of general services to transfer and convey\ncertain unappropriated state land to Rockland Recovery Homes, Inc.",
    "basePrintNo": "S5948",
    "basePrintNoStr": "S5948-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 38,
       "fullName": "David Carlucci",
       "imgName": "370_david_carlucci.jpg",
       "incumbent": false,
       "memberId": 370,
       "sessionMemberId": 1191,
       "sessionYear": 2019,
       "shortName": "CARLUCCI"
      }
