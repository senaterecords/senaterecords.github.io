 "summary": "Directs the commissioner of health to conduct a study of the delivery of ambulatory care on Staten Island.",
 "title": "Directs the commissioner of health to conduct a study of the delivery of ambulatory care on Staten Island",
 "vetoMessages": {
  "items": [
   {
    "billId": {
     "basePrintNo": "A10470",
     "basePrintNoStr": "A10470-2019",
     "printNo": "A10470",
     "session": 2019,
