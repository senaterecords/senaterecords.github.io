  "items": {
   "": {
    "actClause": "AN ACT in relation to authorizing the town of Southeast, county of Putnam, to\nalienate certain lands used as parkland and to dedicate certain other lands as\nparklands",
    "basePrintNo": "S8256",
    "basePrintNoStr": "S8256-2019",
    "coSponsors": {
