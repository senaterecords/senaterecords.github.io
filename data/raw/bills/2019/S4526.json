    "actClause": "AN ACT to amend the real property actions and proceedings law, in relation to\nsummary proceedings to recover possession of real property; and to repeal\ncertain provisions of such law relating to judgments in non-payment\nproceedings in the city of New York",
    "basePrintNo": "S4526",
    "basePrintNoStr": "S4526-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 18,
       "fullName": "Julia Salazar",
       "imgName": "1047_Julia_Salazar.jpg",
       "incumbent": true,
       "memberId": 1227,
       "sessionMemberId": 1225,
       "sessionYear": 2019,
       "shortName": "SALAZAR"
      }
