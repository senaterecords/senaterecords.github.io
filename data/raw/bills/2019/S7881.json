   "": {
    "actClause": "AN ACT to amend the insurance law, in relation to establishing the for-hire\nmotor vehicle safety program",
    "basePrintNo": "S7881",
    "basePrintNoStr": "S7881-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 21,
       "fullName": "Kevin S. Parker",
       "imgName": "416_kevin_s._parker.jpg",
       "incumbent": true,
       "memberId": 416,
       "sessionMemberId": 1194,
       "sessionYear": 2019,
       "shortName": "PARKER"
      }
     ],
     "size": 1
