    "actClause": "AN ACT to amend the environmental conservation law and the public health law,\nin relation to establishing environmental standards for ambient lead and lead\ncontamination in soils and on floors and window sills",
    "basePrintNo": "S5615",
    "basePrintNoStr": "S5615-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 28,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
