       "shortName": "KRUEGER"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 53,
       "fullName": "Rachel May",
       "imgName": "1057_Rachel_May.jpg",
       "incumbent": true,
       "memberId": 1237,
       "sessionMemberId": 1235,
       "sessionYear": 2019,
       "shortName": "MAY"
      }
