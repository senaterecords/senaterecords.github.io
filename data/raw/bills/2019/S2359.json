 "approvalMessage": {
  "approvalNumber": 71,
  "billId": {
   "basePrintNo": "S2359",
   "basePrintNoStr": "S2359-2019",
   "printNo": "S2359",
   "session": 2019,
   "version": ""
  },
  "chapter": 724,
  "signer": "ANDREW M. CUOMO",
  "text": "\n \n                APPROVAL MEMORANDUM - No. 71 Chapter 724\n \n        MEMORANDUM filed with Senate Bill Number 2359, entitled:\n \n    \"AN  ACT to amend the alcoholic beverage control law, in relation to\n        procedures associated with issuing licenses to sell  liquor  for\n        consumption\"\n \n    APPROVED\n \n  This  bill  requires an applicant for a liquor license to post, within\nten days of filing an application or renewal, certain information  in  a\nconspicuous location at their establishment. While I support the idea of\nproviding  information  to  the public, this bill would have required an\napplicant to post, among other  things,  their  State  Liquor  Authority\nidentification  number.  This  number  is  not  normally available to an\napplicant within the ten day window, thus prohibiting the applicant from\ncomplying with the law.\n \n  I have reached an agreement with the Legislature to  pass  legislation\nin  the  upcoming session that will not require the applicant to include\nthe identification number on the posting unless he or she  actually  has\naccess to that number. On that basis, I am signing this bill.\n \n  This bill is approved.                      (signed) ANDREW M. CUOMO\n \n                                ______\n",
  "year": 2019
 },
