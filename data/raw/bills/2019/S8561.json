   "": {
    "actClause": "AN ACT to amend the agriculture and markets law, in relation to establishing a\nNew York food supply working group",
    "basePrintNo": "S8561",
    "basePrintNoStr": "S8561-2019",
    "coSponsors": {
     "items": [
