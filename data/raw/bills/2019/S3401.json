   "": {
    "actClause": "AN ACT to amend the tax law and the administrative code of the city of New\nYork, in relation to investment income",
    "basePrintNo": "S3401",
    "basePrintNoStr": "S3401-2019",
    "coSponsors": {
     "items": [
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 13,
       "fullName": "Jessica Ramos",
       "imgName": "1046_Jessica_Ramos.jpg",
       "incumbent": true,
       "memberId": 1226,
       "sessionMemberId": 1224,
       "sessionYear": 2019,
       "shortName": "RAMOS"
      },
      {
       "alternate": false,
       "chamber": "SENATE",
       "districtCode": 28,
       "fullName": "Liz Krueger",
       "imgName": "401_liz_krueger.jpg",
       "incumbent": true,
       "memberId": 401,
       "sessionMemberId": 1206,
       "sessionYear": 2019,
       "shortName": "KRUEGER"
      }
     ],
     "size": 2
    },
    "fullText": "",
    "fullTextFormats": [],
    "fullTextHtml": "",
