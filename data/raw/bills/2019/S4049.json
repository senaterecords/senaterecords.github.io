   "": {
    "actClause": "AN ACT to amend the public housing law, in relation to the performance of a\nstudy regarding homeless persons who are veterans in the state of New York",
    "basePrintNo": "S4049",
    "basePrintNoStr": "S4049-2019",
    "coSponsors": {
