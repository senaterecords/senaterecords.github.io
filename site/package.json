{
  "name": "on-the-record-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-photos.mjs && astro dev",
    "build": "node scripts/build.mjs",
    "build:fixture": "node scripts/build.mjs --fixture",
    "preview": "astro preview --port 4329 --host 127.0.0.1",
    "fixture": "node scripts/make-fixture.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "node scripts/check-size.mjs && node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/charis-sil": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
