---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/charis-sil/400.css";
import "@fontsource/charis-sil/400-italic.css";
import "@fontsource/charis-sil/700.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_NAME } from "../config";
import { url } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  /** Full-width pages (reader, search) manage their own columns. */
  wide?: boolean;
  /** The search field in the bar; the homepage and the search page have their own. */
  barSearch?: boolean;
}
const { title, description, wide = false, barSearch = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE_NAME}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <Header search={barSearch}><slot name="bar" /></Header>
    <main class={wide ? "wide" : "wrap"}><slot /></main>
    <Footer />
    <script>
      // "Copy cite" and similar buttons copy their data-copy text.
      document.addEventListener("click", async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("button[data-copy]");
        if (!button) return;
        const label = button.querySelector("span") ?? button;
        const before = label.textContent;
        try { await navigator.clipboard.writeText(button.dataset.copy!); label.textContent = "Copied"; }
        catch { label.textContent = "Couldn't copy"; }
        setTimeout(() => (label.textContent = before), 1600);
      });
    </script>
  </body>
</html>
