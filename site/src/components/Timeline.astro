---
// Where a bill stands: done milestones as filled dots, steps still ahead as hollow ones.
// Horizontal on desktop, running down the screen on phones (as in the bill mocks).
import { shortDate, timelineSteps } from "../lib/format";
import type { BillCard } from "../lib/types";

interface Props { card: BillCard; }
const steps = timelineSteps(Astro.props.card);
---
{steps.length > 0 && (
  <ol class="tl" aria-label="Where this bill stands">
    {steps.map((s, i) => (
      <li class:list={[s.done ? "done" : "open", { "to-done": s.done && steps[i + 1]?.done }]}>
        <i></i><b>{s.label}</b><span class="num">{s.date ? shortDate(s.date) : "—"}</span>
      </li>
    ))}
  </ol>
)}

<style is:global>
  .tl { display: flex; align-items: flex-start; margin: 20px 0 22px; position: relative; }
  .tl::before { content: ""; position: absolute; left: 6px; right: 6px; top: 6px; height: 1.5px; background: var(--color-rule); }
  .tl li { flex: 1; position: relative; font-size: 13px; padding-right: 10px; min-width: 0; }
  .tl i { display: block; width: 13px; height: 13px; border-radius: 50%; background: var(--color-ink); border: 1.5px solid var(--color-ink); margin-bottom: 8px; position: relative; z-index: 1; }
  .tl .open i { background: var(--color-pane); border-color: #8E96A0; }
  .tl b { display: block; font-weight: 650; line-height: 1.3; }
  .tl span { color: var(--color-ink3); font-size: 12.5px; }
  .tl .open b { color: var(--color-ink3); font-weight: 550; }
  .tl .to-done::after { content: ""; position: absolute; left: 6px; right: -6px; top: 6px; height: 1.5px; background: var(--color-ink); }
  @media (max-width: 719.98px) {
    .tl { display: block; margin: 14px 0 16px; }
    .tl::before { display: none; }
    .tl li { display: grid; grid-template-columns: 14px 1fr auto; gap: 12px; align-items: baseline; padding: 0 0 10px; font-size: 13.5px; }
    .tl li::before { content: ""; position: absolute; left: 6px; top: 10px; bottom: -4px; width: 1.5px; background: var(--color-rule); }
    .tl li.to-done::before { background: var(--color-ink); }
    .tl li:last-child::before { display: none; }
    .tl .to-done::after { display: none; }
    .tl i { margin: 0; top: 2px; }
  }
</style>
