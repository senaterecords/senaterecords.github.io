---
// The bar's freshness line, the same in the header and the footer: "Checked 12 min ago", with when new records last
// arrived on hover. The work is in /freshness.js, loaded once in the head and cached (inlined, it would add kilobytes to
// each of 65,000 pages); each line only calls it, right away, so it is right from the first paint.
import { meta } from "../lib/data";
import { longDate } from "../lib/format";
import { url } from "../lib/url";

const updatedAt = meta().updatedAt;
const raw = process.env.OTR_STATUS_URL ?? "";
const statusUrl = raw.startsWith("/") ? url(raw) : raw;
---
<span class="upd"><i></i><time data-updated={updatedAt} data-status={statusUrl || undefined} datetime={updatedAt}>Updated {longDate(updatedAt)}</time></span>
<script is:inline>window.otrFreshness && otrFreshness()</script>
