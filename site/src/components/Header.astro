---
// The bar from the mocks: mark, page-specific middle (crumbs, search), section links, last update.
// Under 720 px the links fold into a <details> menu, which needs no JavaScript.
import { SITE_NAME } from "../config";
import { billsHome, meta, transcriptsHome } from "../lib/data";
import { longDate } from "../lib/format";
import { url } from "../lib/url";
import Icon from "./Icon.astro";
import SearchBox from "./SearchBox";

// minimal: the reader's bar, which shows only the mark, its crumb and tools, so the rest is left out of the page.
interface Props { search?: boolean; minimal?: boolean; }
const { search = true, minimal = false } = Astro.props;
const path = Astro.url.pathname;
const LINKS: [string, string, string[]][] = [
  ["Transcripts", transcriptsHome(), ["/browse/", "/transcripts/"]],
  ["Senators", "/senators/", ["/senators/"]],
  ["Bills", billsHome(), ["/bills/"]],
  ["About", "/about/", ["/about/"]],
];
const current = (prefixes: string[]) => (prefixes.some((p) => path.startsWith(url(p))) ? "page" : undefined);
const updatedAt = meta().updatedAt;
---
<header class="bar">
  <a class="mark" href={url("/")}><span class="sig"><Icon name="sig" size={14} /></span>{SITE_NAME}</a>
  <div class="bar-slot"><slot /></div>
  {search && !minimal && <>
    <script is:inline>
      // Until the search box's script starts (slow connections), keep what is typed in it; the box picks it up.
      window.__otrEarlyTyped = window.__otrEarlyTyped || new Map();
      document.addEventListener("input", function (e) { if (e.target instanceof HTMLInputElement && e.target.closest("astro-island[ssr]")) window.__otrEarlyTyped.set(e.target, e.target.value); }, true);
    </script>
    <SearchBox client:idle variant="bar" />
  </>}
  {!minimal && <>
    <nav class="nav" aria-label="Sections">
      {LINKS.map(([name, href, prefixes]) => <a href={url(href)} aria-current={current(prefixes)}>{name}</a>)}
    </nav>
    <span class="upd"><i></i><time data-updated={updatedAt}>Updated {longDate(updatedAt)}</time></span>
    <script is:inline>
      // "Updated 5 min ago" before the first paint, so the full date never shows and then changes. The same rule as
      // relativeTime in lib/format.ts; the time is New York's, like the update stamp.
      (function () {
        var now = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" }));
        document.querySelectorAll("time[data-updated]").forEach(function (el) {
          var m = Math.max(0, Math.round((now - new Date(el.dataset.updated)) / 60000)), h = Math.round(m / 60), d = Math.round(h / 24);
          el.textContent = "Updated " + (m < 1 ? "just now" : m < 60 ? m + " min ago" : h < 24 ? h + " hour" + (h === 1 ? "" : "s") + " ago" : d + " day" + (d === 1 ? "" : "s") + " ago");
        });
      })();
    </script>
  </>}
  <div class="bar-tools">
    <a class="ib" href={url("/search/")} aria-label="Search"><Icon name="search" size={20} /></a>
    {!minimal && (
      <details class="menu">
        <summary aria-label="Menu"><Icon name="menu" size={22} /></summary>
        <nav class="menu-panel" aria-label="Sections">
          {LINKS.map(([name, href, prefixes]) => <a href={url(href)} aria-current={current(prefixes)}>{name}</a>)}
        </nav>
      </details>
    )}
  </div>
</header>

<script>
  // "/" jumps to the search field in the bar, as most sites with search do.
  document.addEventListener("keydown", (event) => {
    const field = document.querySelector<HTMLInputElement>(".bar-search input");
    const target = event.target as HTMLElement;
    if (event.key !== "/" || !field || field.offsetParent === null || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.isContentEditable) return;
    event.preventDefault();
    field.focus();
  });
  // Rows in lists open their main link from anywhere in the row, unless the reader is selecting text or using a
  // control in the row. The link itself stays the keyboard and screen reader target.
  const ROWS = ".hm-list > li, ul.tr > li, .yi li, .bi li, .ap > li, .bl > li, .sn-row, #bill-rows > li, .er, .rrow, .spk-row";
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const row = target.closest<HTMLElement>(ROWS);
    if (!row || target.closest("a, button, input, select, textarea, summary, label") || getSelection()?.isCollapsed === false) return;
    const link = row.querySelector<HTMLAnchorElement>("a.ctx[href]") ?? row.querySelector<HTMLAnchorElement>("a[href]");
    if (!link) return;
    if (event.ctrlKey || event.metaKey || event.shiftKey) window.open(link.href, "_blank", "noopener");
    else link.click();
  });
  // Close the phone menu when the reader taps outside it.
  document.addEventListener("click", (event) => {
    const menu = document.querySelector<HTMLDetailsElement>("details.menu[open]");
    if (menu && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>
