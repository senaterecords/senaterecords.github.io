---
// An icon from the sprite (/icons.svg), sized to its view box.
import { ICONS, type IconName } from "../lib/icons";
import { url } from "../lib/url";

interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 16, class: className } = Astro.props;
const [, , w, h] = ICONS[name][0].split(" ").map(Number);
---
<svg class:list={["icon", className]} width={size} height={Math.round((size * h) / w)} aria-hidden="true"><use href={url(`/icons.svg#${name}`)} /></svg>
