---
// The transcript text. Markup contract (search and the islands depend on it):
//   <section class="turn" id="r-{i}" data-role>                  a turn with a speaker label
//     <h3 id="w-{i}-{page|0}-{key|x}" class="sp [k] [sen]">Label</h3><p>…</p>
//   </section>
//   <section class="turn" id="t-{i}" data-role data-page>       a turn without one (cover, stage directions)
// k marks labels with a speaker card; sen marks the underlined speaking ones. The speaker key and page live once,
// in the label's id, which Pagefind reports as an anchor; this keeps 1.25 million turns light.
// Page breaks are <div class="pb" id="p{page}"><b>p. N</b><i></i></div> between paragraphs, or the same as a <span>
// inside the paragraph a break interrupts (so the sentence stays one block); turns come 40 to a content-visibility chunk.
import { titleCase } from "../../lib/format";
import { estimateHeight, lastPage, turnParagraphs } from "../../lib/reader";
import type { Turn } from "../../lib/types";

interface Props { turns: Turn[]; keyOf: (t: Turn) => string | null; interactive?: boolean; }
const { turns, keyOf, interactive = true } = Astro.props;

const SPOKEN = new Set(["senator", "chair", "assembly"]);
const CHUNK = 40;
const usedPages = new Set<number>();
const pageId = (page: number) => (usedPages.has(page) ? undefined : (usedPages.add(page), `p${page}`));

let previous: number | null = null;
const rows = turns.map((t) => {
  const key = keyOf(t);
  const gutter = t.page != null && t.page !== previous ? t.page : null;
  previous = lastPage(t) ?? previous;
  return { t, key, gutter, blocks: turnParagraphs(t.text, t.breaks) };
});
const chunks = Array.from({ length: Math.ceil(rows.length / CHUNK) }, (_, i) => rows.slice(i * CHUNK, (i + 1) * CHUNK));
---
{chunks.map((chunk) => (
  <div class="chunk" style={`--h:${estimateHeight(chunk.map((row) => row.t))}`}>
    {chunk.map(({ t, key, gutter, blocks }) => (
      <section class="turn" id={t.label ? `r-${t.i}` : `t-${t.i}`} data-role={t.role} data-page={t.label ? undefined : t.page ?? undefined}>
        {gutter != null && <span class="g" id={pageId(gutter)} data-pagefind-ignore>{gutter}</span>}
        {t.label && (
          <h3 id={`w-${t.i}-${t.page ?? 0}-${key ?? "x"}`} class:list={["sp", { k: interactive && !!key, sen: interactive && !!key && SPOKEN.has(t.role) }]}>{titleCase(t.label)}</h3>
        )}
        {blocks.map((b) => (b.kind === "p"
          ? <p>{b.parts.map((part, j) => (typeof part === "string"
              ? (j > 0 ? ` ${part}` : part)
              : <span class="pb" id={pageId(part.page)} data-pagefind-ignore><b>p. {part.page}</b><i></i></span>))}</p>
          : <div class="pb" id={pageId(b.page)} data-pagefind-ignore><b>p. {b.page}</b><i></i></div>))}
      </section>
    ))}
  </div>
))}
