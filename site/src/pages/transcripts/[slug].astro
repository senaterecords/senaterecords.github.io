---
// The transcript reader, as in "Reading a transcript" (desktop) and the phone reader (spec 8.3).
import "../../styles/reader.css";
import Icon from "../../components/Icon.astro";
import Calendar from "../../components/reader/Calendar.astro";
import ReaderScripts from "../../components/reader/ReaderScripts.astro";
import HearingSpeakers from "../../components/reader/HearingSpeakers.astro";
import Turns from "../../components/reader/Turns.astro";
import Status from "../../components/Status.astro";
import Base from "../../layouts/Base.astro";
import { assembly, bill, hasBillPage, senatorPageSlugs, senatorsBySlug, transcript, transcriptIndex } from "../../lib/data";
import { billStatus, hearingTitle, longDate, placeText, plainPages, plural, transcriptTitle, weekdayDate } from "../../lib/format";
import { packReader } from "../../lib/payload";
import { EVERY_PAGE } from "../../lib/query";
import { speakerData } from "../../lib/speakers";
import { url } from "../../lib/url";

export function getStaticPaths() {
  return transcriptIndex().map((t) => ({ params: { slug: t.slug } }));
}

const doc = transcript(Astro.params.slug!);
const { speakers, keyOf } = speakerData(doc, { senatorsBySlug: senatorsBySlug(), assembly: assembly(), pageSlugs: senatorPageSlugs() });

const year = doc.date.slice(0, 4);
const name = transcriptTitle(doc);
const displayTitle = doc.kind === "floor" ? `${name}, ${longDate(doc.date)}` : name;
const monthDay = longDate(doc.date).replace(/, \d{4}$/, "");
const pages = doc.pages ? plainPages(doc.pages[0], doc.pages[1]) : "";
const noSpeakers = doc.plainText || doc.empty || !doc.turns.some((t) => t.label);
// Pro forma legislative days hold no debate (5,505 days, each the same short script): they have the reader's tools like
// any transcript but stay out of the search index, where they would only add copies of the same procedural lines.
const proForma = doc.dayType === "LEGISLATIVE" && !doc.turns.some((t) => ["senator", "chair", "assembly"].includes(t.role));
const baseOf = (printNo: string) => printNo.match(/^[SA]\d+/)?.[0] ?? printNo;

// Pagefind filters, always in attribute form so they never become page text.
const senatorKeys = [...new Set(doc.turns.map(keyOf).filter((k): k is string => !!k && k !== "president" && k !== "secretary"))];
const billBases = [...new Set([
  ...doc.turns.flatMap((t) => t.bills.map(baseOf)),
  ...doc.segments.flatMap((s) => (s.printNo ? [baseOf(s.printNo)] : [])),
])];
const committees = doc.committees.map(hearingTitle);

const segments = doc.segments.map((s) => {
  const card = s.printNo ? bill(doc.session, baseOf(s.printNo))?.card ?? null : null;
  return {
    calNo: s.calNo, printNo: s.printNo, startTurn: s.startTurn, endTurn: s.endTurn, debateEnd: s.debateEnd, debated: s.debated,
    title: card?.title ?? null, status: billStatus(card), sponsor: (card?.sponsor?.name ?? s.sponsor) ? `${s.printNo?.startsWith("A") ? "Asm." : "Sen."} ${card?.sponsor?.name ?? s.sponsor}` : null,
    url: s.printNo && hasBillPage(doc.session, baseOf(s.printNo)) ? url(`/bills/${doc.session}/${baseOf(s.printNo)}/`) : null,
    outcome: s.outcome, ayes: s.ayes, nays: s.nays, remarks: s.remarks,
  };
});
// Speakers' turn lists are left out: the islands read them from the page (lib: readerData.ts).
const cardData = Object.fromEntries(Object.entries(speakers).map(([key, { remarks: _r, presiding: _p, ...card }]) => [key, card]));
const readerData = {
  slug: doc.slug, kind: doc.kind, date: doc.date, title: doc.kind === "hearing" ? name : doc.sessionType,
  session: doc.session, speakers: cardData, segments,
};
const readings = new Map<number, { calNo: number; printNo: string | null; title: string | null }[]>();
for (const s of segments) readings.set(s.startTurn, [...(readings.get(s.startTurn) ?? []), { calNo: s.calNo, printNo: s.printNo, title: s.title }]);
const json = JSON.stringify(packReader(readerData)).replace(/</g, "\\u003c");
const spokeCount = Object.values(speakers).filter((s) => s.remarks.length > 0).length;
---
<Base title={displayTitle} description={`${displayTitle}. New York State Senate ${doc.kind === "floor" ? "floor transcript" : "public hearing transcript"}${pages ? `, ${pages}` : ""}.`} wide minimalBar>
  <Fragment slot="bar">
    <a class="ib rd-back" href={url(`/browse/${year}/`)} aria-label={`Back to ${year} transcripts`}><Icon name="back" size={22} /></a>
    <nav class="rd-crumb" aria-label="Breadcrumb">
      <a href={url("/browse/")}>Transcripts</a><Icon name="chev" size={13} />
      <a href={url(`/browse/${year}/`)}>{year}</a><Icon name="chev" size={13} />
      <b>{monthDay} · {name}</b>
    </nav>
    <div class="rd-ttl"><span>{longDate(doc.date)}</span><small>{name}{pages && ` · ${pages}`}</small></div>
    <div class="rd-acts" id="rd-acts"></div>
  </Fragment>


  <ReaderScripts />
  <div class="rd">
    {doc.kind === "floor"
      ? <Calendar segments={doc.segments} session={doc.session} />
      : <HearingSpeakers speakers={speakers} turns={doc.turns} keyOf={keyOf} />}

    <div class="rd-main">
      <h1 class="visually-hidden">{displayTitle}</h1>
      <p class="rd-meta num">
        {[doc.kind === "floor" ? name : "Public hearing", weekdayDate(doc.date), placeText(doc.location), pages].filter(Boolean).join(" · ")}
        {doc.corrected && <Status status={{ text: "Corrected transcript", tone: "amber" }} size={13} />}
      </p>
      <div id="reader-notices"></div>
      <article id="transcript" data-pagefind-body={proForma ? undefined : ""} data-slug={doc.slug} data-kind={doc.kind} data-date={doc.date} data-title={doc.title ?? doc.sessionType ?? ""}>
        {!proForma && <>
        <span hidden data-pagefind-filter={`type:${doc.kind}`}></span>
        <span hidden data-pagefind-filter={`year:${year}`}></span>
        <span hidden data-pagefind-filter={`session:${doc.session}`}></span>
        {senatorKeys.map((key) => <span hidden data-pagefind-filter={`senator:${key}`}></span>)}
        {billBases.map((base) => <span hidden data-pagefind-filter={`bill:${base}`}></span>)}
        {committees.map((c) => <span hidden data-pagefind-filter={`committee:${c}`}></span>)}
        <span hidden data-pagefind-meta={`title:${displayTitle}`}></span>
        <span hidden data-pagefind-meta={`date:${doc.date}`}></span>
        <span hidden data-pagefind-meta={`kind:${doc.kind}`}></span>
        {doc.officers.president && <span hidden data-pagefind-meta={`president:${doc.officers.president.name}`}></span>}
        <span hidden data-pagefind-sort={`date:${doc.date}`}></span>
        <span class="visually-hidden" aria-hidden="true">{EVERY_PAGE}</span>
        </>}
        {noSpeakers && <p class="rd-note" data-pagefind-ignore>Speaker details aren't available for this transcript</p>}
        <Turns turns={doc.turns} keyOf={keyOf} readings={readings}
          billHref={(t, base) => (t.bills.some((b) => baseOf(b) === base) && hasBillPage(doc.session, base) ? url(`/bills/${doc.session}/${base}/`) : null)} />
      </article>
    </div>

    <aside class="rd-rail rd-side" aria-label="About this transcript">
      <div class="rail-in" id="headnote">
        <div id="headnote-live"></div>
        <div id="headnote-default">
        <h2 class="hn-title">{doc.kind === "floor" ? name : "Public hearing"}</h2>
        {doc.kind === "hearing" && <p class="hn-sub serif">{name}</p>}
        <dl class="hn-dl">
          <dt>Date</dt><dd class="num">{weekdayDate(doc.date)}</dd>
          {pages && <><dt>Pages</dt><dd class="num">{pages}</dd></>}
          {committees.length > 0 && <><dt>{committees.length === 1 ? "Committee" : "Committees"}</dt><dd>{committees.join(" · ")}</dd></>}
          {doc.officers.president && <><dt>President</dt><dd>Lt. Gov. {doc.officers.president.name}</dd></>}
          {doc.officers.secretary?.name && <><dt>Secretary</dt><dd>{doc.officers.secretary.name}</dd></>}
          {spokeCount > 0 && <><dt>Speakers</dt><dd class="num">{plural(spokeCount, doc.kind === "floor" ? "senator" : "member")}</dd></>}
          {doc.kind === "floor" && segments.length > 0 && <><dt>Calendar</dt><dd class="num">{plural(segments.length, "reading")}</dd></>}
        </dl>
        </div>
      </div>
    </aside>
    <script is:inline>
      // Before the first paint: a link into a bill's reading marks its calendar row and shows a placeholder here, not
      // the transcript overview that the reader's script would swap for the bill a moment later (same rule as
      // ReaderNav: the last reading starting at or before the remark, if the remark is within it).
      (function () {
        var m = /^#r-(\d+)$/.exec(location.hash);
        if (!m) return;
        var n = Number(m[1]);
        var rows = document.querySelectorAll(".rd-cal li[data-start]");
        for (var i = rows.length - 1; i >= 0; i--) {
          if (Number(rows[i].dataset.start) > n) continue;
          if (n <= Number(rows[i].dataset.end)) {
            rows[i].classList.add("cur");
            document.getElementById("headnote-default").hidden = true;
            document.getElementById("headnote-live").insertAdjacentHTML("afterbegin", '<div class="hn-wait" aria-hidden="true"><i></i><i></i><i></i><i></i></div>');
          }
          return;
        }
      })();
    </script>
  </div>

  <script type="application/json" id="reader-data" set:html={json} />
</Base>

