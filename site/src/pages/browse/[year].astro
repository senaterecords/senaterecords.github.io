---
// One year of transcripts by month, as in "Browse transcripts by year" and the phone browse page.
import Base from "../../layouts/Base.astro";
import { transcriptIndex, years } from "../../lib/data";
import { dayDate, hearingTitle, plainPages, plural, transcriptTitle } from "../../lib/format";
import type { TranscriptSummary } from "../../lib/types";
import { url } from "../../lib/url";

export function getStaticPaths() {
  return years().map(({ year }) => ({ params: { year: String(year) } }));
}

const year = Number(Astro.params.year);
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const list = transcriptIndex().filter((t) => t.date.startsWith(`${year}-`));
const legislative = (t: TranscriptSummary) => t.dayType === "LEGISLATIVE";
const floor = list.filter((t) => t.kind === "floor" && !legislative(t)).length;
const hearings = list.filter((t) => t.kind === "hearing").length;
const legislativeDays = list.filter(legislative).length;

const months = new Map<number, TranscriptSummary[]>();
for (const t of list) {
  const m = Number(t.date.slice(5, 7));
  months.set(m, [...(months.get(m) ?? []), t]);
}

const title = (t: TranscriptSummary) => transcriptTitle(t);
const detail = (t: TranscriptSummary) => {
  if (t.kind === "hearing") return t.committees.map(hearingTitle).join(" · ") || "Public hearing";
  if (legislative(t) && !t.speakers) return "No business conducted";
  if (t.plainText) return "Speaker details aren't available";
  return `${plural(t.speakers, "senator")} spoke · ${plural(t.billsDebated, "bill")} debated`;
};
const pages = (t: TranscriptSummary) =>
  !t.pages ? "" : t.kind === "hearing" ? `${t.pages[1] - t.pages[0] + 1} pp.` : plainPages(t.pages[0], t.pages[1]);
---
<Base title={`${year} transcripts`} description={`New York State Senate floor sessions and public hearings in ${year}.`} wide>
  <header class="pg-head">
    <div class="pg-in">
      <div class="pg-title">
        <div>
          <h1>{year} transcripts</h1>
          <p class="pg-meta num">
            {plural(floor, "floor session")} · {plural(hearings, "public hearing")}{legislativeDays > 0 && <> · <label class="ld-toggle"><input type="checkbox" id="show-ld" class="visually-hidden" />{plural(legislativeDays, "legislative day")}<span class="ld-off"> hidden · <b>Show</b></span><span class="ld-on"> · <b>Hide</b></span></label></>}
          </p>
          <script is:inline>
            // The remembered choice to show legislative days applies before the first paint, so the list never jumps.
            try { var ld = document.getElementById("show-ld"); if (ld) ld.checked = localStorage.getItem("otr:show-ld") === "1"; } catch (e) { /* storage blocked */ }
          </script>
        </div>
        <div class="acts">
          <div class="seg" role="group" aria-label="Show">
            <button type="button" data-kind="all" aria-pressed="true">All</button>
            <button type="button" data-kind="floor" aria-pressed="false">Floor sessions</button>
            <button type="button" data-kind="hearing" aria-pressed="false">Public hearings</button>
          </div>

        </div>
      </div>
      <nav class="yrs" aria-label="Years">
        {years().map(({ year: y }) => <a class="num" href={url(`/browse/${y}/`)} aria-current={y === year ? "page" : undefined}>{y}</a>)}
      </nav>
    </div>
  </header>

  <div class="mon">
    {[...months].map(([m, rows]) => (
      <section class="mg">
        <h2 class="sec-h2">{MONTHS[m - 1]} {year} <span class="num c-off">{plural(rows.filter((t) => !(legislative(t) && !t.speakers)).length, "transcript")}</span><span class="num c-on">{plural(rows.length, "transcript")}</span></h2>
        <ul class="tr">
          {rows.map((t) => (
            <li class:list={{ ld: legislative(t) && !t.speakers }} data-kind={t.kind}>
              <span class="d num">{dayDate(t.date)}</span>
              <span class="t"><a href={url(`/transcripts/${t.slug}/`)}>{title(t)}</a><small>{detail(t)}</small></span>
              <span class="p num">{pages(t)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<script>
  // Record type is a JavaScript filter; legislative days (pro forma, no business) are hidden by CSS until the switch is
  // on, which works without JavaScript and is remembered on this device. A month with nothing left to show folds away.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".acts [data-kind]")];
  const showLd = document.getElementById("show-ld") as HTMLInputElement | null;
  let kind = "all";
  const apply = () => {
    for (const row of document.querySelectorAll<HTMLElement>(".tr li")) row.hidden = kind !== "all" && row.dataset.kind !== kind;
    for (const group of document.querySelectorAll<HTMLElement>(".mg")) {
      const shown = [...group.querySelectorAll<HTMLElement>(".tr li")].filter((row) => !row.hidden && (showLd?.checked || !row.classList.contains("ld"))).length;
      group.hidden = !shown;
      // Both counts are kept right (CSS shows the one for the switch's state), so turning it on or off never waits on this.
      const rows = [...group.querySelectorAll<HTMLElement>(".tr li")].filter((row) => !row.hidden);
      const label = (n: number) => `${n.toLocaleString("en-US")} ${n === 1 ? "transcript" : "transcripts"}`;
      const off = group.querySelector(".sec-h2 .c-off");
      const on = group.querySelector(".sec-h2 .c-on");
      if (off) off.textContent = label(rows.filter((row) => !row.classList.contains("ld")).length);
      if (on) on.textContent = label(rows.length);
    }
  };
  for (const button of buttons) {
    button.addEventListener("click", () => {
      kind = button.dataset.kind ?? "all";
      for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
      apply();
    });
  }
  if (showLd) {
    showLd.addEventListener("change", () => {
      try { localStorage.setItem("otr:show-ld", showLd.checked ? "1" : "0"); } catch { /* storage blocked */ }
      apply();
    });
  }
  apply();
</script>

<style is:global>
  .yrs { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 16px; padding-bottom: 16px; }
  .yrs a { font-size: 13px; font-weight: 600; padding: 4px 10px; border: 1px solid var(--color-rule); border-radius: 5px; background: #fff; color: var(--color-ink2); }
  .yrs a:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .yrs a[aria-current] { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
  .mon { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
  .mg { padding-top: 18px; }
  .mg[hidden], .tr li[hidden] { display: none; }
  .sec-h2 span { font-weight: 500; color: var(--color-ink3); font-size: 13px; }
  .tr li { display: grid; grid-template-columns: 120px minmax(0, 1fr) 140px; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--color-rule2); font-size: 14px; align-items: baseline; }
  .tr .d { font-weight: 650; }
  .tr .t a { font-weight: 550; }
  .tr .t a:hover { text-decoration: underline; text-decoration-color: #A9B0B8; text-underline-offset: 2px; }
  .tr .t small { display: block; font-weight: 400; color: var(--color-ink3); font-size: 12.5px; }
  .tr .p { color: var(--color-ink3); font-size: 12.5px; text-align: right; }
  .tr .ld { color: var(--color-ink3); }
  .tr li.ld { display: none; }
  .pg-head:has(#show-ld:checked) ~ .mon .tr li.ld:not([hidden]) { display: grid; }
  .pg-head:not(:has(#show-ld:checked)) ~ .mon .mg:not(:has(.tr li:not(.ld))) { display: none; }
  /* "343 legislative days hidden · Show": the switch is the summary's own words; a hidden checkbox keeps it working
     without JavaScript and from the keyboard. */
  .ld-toggle { cursor: pointer; white-space: nowrap; border-radius: 3px; }
  .ld-toggle b { font-weight: 600; color: var(--color-act); }
  .ld-toggle:hover b { text-decoration: underline; text-underline-offset: 2px; }
  .ld-toggle:has(input:focus-visible) { outline: 2px solid var(--color-act); outline-offset: 2px; }
  .ld-on { display: none; }
  .sec-h2 .c-on, .pg-head:has(#show-ld:checked) ~ .mon .sec-h2 .c-off { display: none; }
  .pg-head:has(#show-ld:checked) ~ .mon .sec-h2 .c-on { display: inline; }
  .ld-toggle:has(input:checked) .ld-on { display: inline; }
  .ld-toggle:has(input:checked) .ld-off { display: none; }
  .tr .ld .t a { font-weight: 450; color: var(--color-ink3); }
  @media (max-width: 719.98px) {
    .yrs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-right: -16px; padding-right: 16px; }
    .mon { padding: 0 16px; }
    .tr li { grid-template-columns: 1fr auto; gap: 2px 10px; border-bottom-color: var(--color-rule2); }
    .tr .d { font-weight: 450; font-size: 12.5px; color: var(--color-ink3); }
    .tr .p { grid-row: 1; grid-column: 2; }
    .tr .t { grid-column: 1 / -1; }
    .tr .t a { font-weight: 600; font-size: 14.5px; }
  }
</style>
