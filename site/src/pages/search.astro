---
// The search page. Everything here runs in the browser: Pagefind's index, the query layer, the results.
import SearchApp from "../components/SearchApp";
import Base from "../layouts/Base.astro";
---
<Base title="Search" description="Search what was said in the New York State Senate, by words, speaker, bill, year and more." wide barSearch={false}>
  <SearchApp client:load />
  <script>import "../scripts/copy";</script>
  <noscript><p class="sr-msg">Search needs JavaScript. You can still browse transcripts by year, senator or bill.</p></noscript>
</Base>

<style is:global>
  .sr-msg { max-width: 1280px; margin: 24px auto; padding: 0 32px; font-size: 15px; color: var(--color-ink2); }
  .sr-which { max-width: 1280px; margin: 24px auto; padding: 0 32px; }
  .sr-which h2 { font-size: 19px; font-weight: 700; margin-bottom: 12px; }
  .sr-which-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 8px; }
  .sr-which-list button { display: flex; gap: 12px; align-items: center; text-align: left; padding: 10px 12px; background: #fff; border: 1px solid var(--color-rule); border-radius: 8px; font: inherit; color: var(--color-ink); }
  .sr-which-list button:hover { border-color: var(--color-act); }
  .sr-which-list b { display: block; font-weight: 650; }
  .sr-which-list small { display: block; font-size: 12.5px; color: var(--color-ink3); }
  .sr-head { max-width: 1280px; margin: 0 auto; height: 56px; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--color-rule); }
  .sr-head h1 { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
  .sr-head h1 .sr-sub { font-weight: 450; color: var(--color-ink2); }
  .sr-last { white-space: nowrap; }
  .sr-time { font-size: 12.5px; color: var(--color-ink3); }
  .sr-time[role="status"] { display: inline-flex; align-items: center; gap: 7px; }
  /* Loading: what the search is doing, a small turning ring, and result-shaped rows that shimmer until remarks arrive. */
  .sr-status { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 550; color: var(--color-ink2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sr-spin { width: 13px; height: 13px; flex: none; border-radius: 50%; border: 2px solid var(--color-rule); border-top-color: var(--color-act); animation: sr-turn .8s linear infinite; }
  .sr-more .sr-spin { margin-right: 8px; vertical-align: -2px; display: inline-block; }
  .rrow.skel { pointer-events: none; }
  .skel .bar { display: block; height: 11px; margin-bottom: 9px; border-radius: 4px; background: linear-gradient(90deg, #EDEFF1 30%, #F7F8F9 50%, #EDEFF1 70%) 0 0 / 300% 100%; animation: sr-shimmer 1.5s ease-in-out infinite; }
  .skel .bar.sm { height: 9px; }
  .skel .bar.tx { height: 13px; margin-bottom: 10px; }
  .skel .who-bar, .skel > div > .bar:first-child { margin-bottom: 14px; }
  .skel .c-cite { gap: 0; }
  @keyframes sr-shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }
  @keyframes sr-turn { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .skel .bar, .sr-spin { animation: none; } }
  .sr-sort { margin-left: auto; }
  .sr-sort select { height: 32px; border: 1px solid var(--color-rule); border-radius: 6px; background: #fff; padding: 0 10px; font: 550 13.5px var(--font-ui); color: var(--color-ink2); }
  .sr-filters { display: none; }
  .sr-body { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 228px minmax(0, 1fr); min-height: 60vh; }
  .sr-facets { padding: 18px 20px; border-right: 1px solid var(--color-rule); }
  .fg { margin-bottom: 20px; }
  .fg h3 { font-size: 13px; font-weight: 700; margin-bottom: 8px; }
  .fg-row { display: flex; width: 100%; align-items: center; gap: 9px; font: 13.5px var(--font-ui); color: var(--color-ink); padding: 3.5px 0; background: none; border: 0; text-align: left; }
  .fg-row:hover .fg-name { text-decoration: underline; text-underline-offset: 2px; }
  .fg-row .fg-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fg-row .box { width: 15px; height: 15px; border: 1.5px solid #9AA1AA; border-radius: 3px; background: #fff; display: grid; place-items: center; flex: none; color: #fff; }
  .fg-all { margin: 4px 0 0 25px; padding: 2px 0; border: 0; background: none; font: 600 13px var(--font-ui); color: var(--color-act); cursor: pointer; }
  .fg-all:hover { text-decoration: underline; text-underline-offset: 2px; }
  .fg-row .box.on { background: var(--color-act); border-color: var(--color-act); }
  .fg-row b { margin-left: auto; font-weight: 500; color: var(--color-ink3); font-size: 12.5px; }
  .sr-list { background: var(--color-pane); min-width: 0; }
  .sr-none { padding: 24px 22px; font-size: 15px; color: var(--color-ink2); }
  .sr-wide { max-width: 1280px; margin: 0 auto; padding: 10px 24px; font-size: 13.5px; color: var(--color-ink2); background: var(--color-act-wash); border-bottom: 1px solid var(--color-rule); }
  .sr-wide .link { font: 600 13.5px var(--font-ui); color: var(--color-act); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .sr-none p + p { margin-top: 8px; }
  .sr-more { margin: 16px 22px 24px; }
  .hearing-t { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; }
  @media (max-width: 719.98px) {
    .sr-msg, .sr-which { padding: 0 16px; }
    .sr-head { height: auto; flex-wrap: wrap; gap: 8px 10px; padding: 10px 16px; background: var(--color-pane); }
    .sr-head h1 { position: relative; font-size: 15px; width: 100%; white-space: normal; } /* the "i" popup spans it */
    /* On a phone the counts take two tidy lines (the same in both states, so nothing jumps when reading ends). */
    .sr-head h1 .sr-sub { display: block; margin-top: 1px; font-size: 13.5px; }
    .sr-time, .sr-export { display: none; }
    .sr-head .sr-time[role="status"] { display: inline-flex; width: 100%; }
    .skel .c-date, .skel .c-cite { display: block; margin: 0; }
    .skel .c-date .bar::before { content: none; }
    .skel .c-date .bar { width: 42% !important; }
    .skel .c-cite .bar { width: 34% !important; margin-top: 4px; }
    .skel .bar.sm { display: none; }
    .sr-status { font-size: 14px; width: 100%; }
    .sr-filters { display: inline-flex; }
    .sr-sort { margin-left: 0; }
    .sr-body { display: block; }
    .sr-facets { display: none; }
    .sheet .fg-row { padding: 8px 0; font-size: 14.5px; border-bottom: 1px solid var(--color-rule2); }
  }
</style>
